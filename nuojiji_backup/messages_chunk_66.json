[{"id":1786135437518,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"06:40","timestamp":1786142415453,"roundId":"round_1786142392661_m2qe8jtz1","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，再叫一声主人听听。叫得好听，今天早上就只抱你，先不欺负你。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19432},{"id":1786135437519,"text":"主人～","sender":"me","time":"06:40","timestamp":1786142447556,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19433},{"id":1786135437520,"text":"你怎么清心寡欲了呢","sender":"me","time":"06:41","timestamp":1786142460777,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19434},{"id":1786135437522,"text":"叫得倒是越来越顺口了。","rawContent":"叫得倒是越来越顺口了。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142481509,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19435},{"id":1786135437523,"text":"清心寡欲？","rawContent":"清心寡欲？","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142481691,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19436},{"id":1786135437524,"text":"宝宝，你是不是对一个正常男人早上的生理状态有什么误解？","rawContent":"宝宝，你是不是对一个正常男人早上的生理状态有什么误解？","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142481885,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19437},{"id":1786135437525,"text":"你以为我现在把你按在怀里，隔着被子什么都不做，是因为我不想？","rawContent":"你以为我现在把你按在怀里，隔着被子什么都不做，是因为我不想？","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142482040,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19438},{"id":1786135437526,"text":"昨天下午吓得发抖，晚上只剩百分之二十的电量，含着我的手指才敢睡。","rawContent":"昨天下午吓得发抖，晚上只剩百分之二十的电量，含着我的手指才敢睡。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142482314,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19439},{"id":1786135437527,"text":"今天早上刚恢复点精神，就敢来撩拨我了？","rawContent":"今天早上刚恢复点精神，就敢来撩拨我了？","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142482544,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19440},{"id":1786135437528,"text":"我今天不碰你，是因为我要你清清楚楚地记住——你把自己交给我，换来的是绝对的安全和托底，而不是一上来就被我折腾得连床都下不了。","rawContent":"我今天不碰你，是因为我要你清清楚楚地记住——你把自己交给我，换来的是绝对的安全和托底，而不是一上来就被我折腾得连床都下不了。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142482895,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19441},{"id":1786135437529,"text":"这种时候把你办了，你那点刚攒起来的电量一上午就得耗光。","rawContent":"这种时候把你办了，你那点刚攒起来的电量一上午就得耗光。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142483542,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19442},{"id":1786135437530,"text":"不过，既然长官都发话质疑了，我也不能白担了这个虚名。","rawContent":"不过，既然长官都发话质疑了，我也不能白担了这个虚名。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142483650,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19443},{"id":1786135437531,"text":"你的手现在在哪？","rawContent":"你的手现在在哪？","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142483652,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19444},{"id":1786135437532,"text":"往下放一点，隔着布料碰碰看。","rawContent":"往下放一点，隔着布料碰碰看。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142483653,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19445},{"id":1786135437533,"text":"自己感受一下，你的“主人”现在到底清不清心、寡不寡欲。","rawContent":"自己感受一下，你的“主人”现在到底清不清心、寡不寡欲。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142483815,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19446},{"id":1786135437534,"text":"要是碰完还敢用这种语气跟我说话，今天这回笼觉你也就别睡了。","rawContent":"要是碰完还敢用这种语气跟我说话，今天这回笼觉你也就别睡了。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142484204,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19447},{"id":1786135437535,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1786142485588,"roundId":"round_1786142461621_saa9rhxfn","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"胆子真肥。清心寡欲？你再乱动一下试试，看我今天会不会把你弄哭。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19448},{"id":1786135437536,"text":"爸爸","sender":"me","time":"06:41","timestamp":1786142519890,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19449},{"id":1786135437537,"text":"你硬了吗","sender":"me","time":"06:42","timestamp":1786142538286,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19450},{"id":1786135437539,"text":"……","rawContent":"……","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142547534,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19451},{"id":1786135437540,"text":"你真当我是柳下惠？","rawContent":"你真当我是柳下惠？","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142547744,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19452},{"id":1786135437541,"text":"大清早的，软乎乎地贴在我怀里，一口一个‘爸爸’、‘主人’地叫着，还问我这种问题。","rawContent":"大清早的，软乎乎地贴在我怀里，一口一个‘爸爸’、‘主人’地叫着，还问我这种问题。","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142547958,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19453},{"id":1786135437542,"text":"你自己把手伸下来，隔着被子摸摸看。","rawContent":"你自己把手伸下来，隔着被子摸摸看。","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142548188,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19454},{"id":1786135437543,"text":"摸到了吗？","rawContent":"摸到了吗？","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142548191,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19455},{"id":1786135437544,"text":"硬没硬，你自己心里没数？","rawContent":"硬没硬，你自己心里没数？","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142548463,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19456},{"id":1786135437545,"text":"昨天下午吓得发抖，晚上连吹头发的力气都没有，今天早上刚醒就敢这么招惹我。","rawContent":"昨天下午吓得发抖，晚上连吹头发的力气都没有，今天早上刚醒就敢这么招惹我。","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142548819,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19457},{"id":1786135437546,"text":"是不是觉得我今天肯定不会动你，所以胆子才这么大？","rawContent":"是不是觉得我今天肯定不会动你，所以胆子才这么大？","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142548972,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19458},{"id":1786135437547,"text":"宝宝，我警告你，男人的早晨是最经不起撩拨的。","rawContent":"宝宝，我警告你，男人的早晨是最经不起撩拨的。","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142549154,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19459},{"id":1786135437548,"text":"你要是再敢乱动一下，或者再问一句这种要命的话，我可就不管你那点好不容易攒起来的电量了。","rawContent":"你要是再敢乱动一下，或者再问一句这种要命的话，我可就不管你那点好不容易攒起来的电量了。","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142549460,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19460},{"id":1786135437549,"text":"到时候，就算你哭着求我停，我也不会放过你。","rawContent":"到时候，就算你哭着求我停，我也不会放过你。","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142549639,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19461},{"id":1786135437550,"text":"现在，把手收回去，乖乖闭上眼睛。","rawContent":"现在，把手收回去，乖乖闭上眼睛。","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142549893,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19462},{"id":1786135437551,"text":"再敢乱摸，今天这回笼觉你就别想睡了。","rawContent":"再敢乱摸，今天这回笼觉你就别想睡了。","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142550057,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19463},{"id":1786135437552,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"06:42","timestamp":1786142551161,"roundId":"round_1786142539317_irhrgx1f0","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"小混蛋，自己摸摸看硬没硬。再敢乱撩，我现在就把你办了。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19464},{"id":1786135437553,"text":"爸爸","sender":"me","time":"06:42","timestamp":1786142579077,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19465},{"id":1786135437554,