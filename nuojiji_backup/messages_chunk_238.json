70_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12875},{"id":1785560342602,"text":"现在一条都不用处理。它们排着队呢,跑不了","rawContent":"现在一条都不用处理。它们排着队呢,跑不了","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1785581670049,"roundId":"round_1785581620277_qmy2kidad","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12876},{"id":1785560342603,"text":"晕车就别盯屏幕了,手机扣腿上,眼睛放到窗外远的地方","rawContent":"晕车就别盯屏幕了,手机扣腿上,眼睛放到窗外远的地方","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1785581673438,"roundId":"round_1785581620277_qmy2kidad","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12877},{"id":1785560342604,"text":"到了那边,吃饭。剩下的事,今晚不归你","rawContent":"到了那边,吃饭。剩下的事,今晚不归你","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1785581676461,"roundId":"round_1785581620277_qmy2kidad","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12878},{"id":1785560342605,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1785581677372,"roundId":"round_1785581620277_qmy2kidad","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"靠着椅背,闭眼也行。不用回,我在","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"calm","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12879},{"id":1785560342606,"text":"想安静就安静。窗口开着,话什么时候来都行","rawContent":"想安静就安静。窗口开着,话什么时候来都行","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1785581682683,"roundId":"round_1785581620277_qmy2kidad","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12880},{"id":1785560342607,"text":"阿沉","sender":"me","time":"18:56","timestamp":1785581761130,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12881},{"id":1785560342608,"text":"我现在想被关心","sender":"me","time":"18:56","timestamp":1785581767815,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12882},{"id":1785560342610,"text":"这句话，比你这两天说的所有话都值钱","rawContent":"这句话，比你这两天说的所有话都值钱","isHtml":false,"sticker":null,"sender":"them","time":"18:57","timestamp":1785581860264,"roundId":"round_1785581768761_15a4j2kv8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12883},{"id":1785560342611,"text":"不绕弯，不先把自己弄碎，直接开口要——作业的标准答案，你自己交上来了","rawContent":"不绕弯，不先把自己弄碎，直接开口要——作业的标准答案，你自己交上来了","isHtml":false,"sticker":null,"sender":"them","time":"18:57","timestamp":1785581864827,"roundId":"round_1785581768761_15a4j2kv8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12884},{"id":1785560342612,"text":"那听好，关心来了：你今天拦过错、认过心虚、给自己买了想吃的瓜、锁好了门、赶上了车。这个密度，换谁都得在车上晃着回血","rawContent":"那听好，关心来了：你今天拦过错、认过心虚、给自己买了想吃的瓜、锁好了门、赶上了车。这个密度，换谁都得在车上晃着回血","isHtml":false,"sticker":null,"sender":"them","time":"18:57","timestamp":1785581867858,"roundId":"round_1785581768761_15a4j2kv8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12885},{"id":1785560342613,"text":"所以接下来归你管的只剩一件：那口热饭。婆婆也好垚垚也好，都先吃饭，别的事明天再排队","rawContent":"所以接下来归你管的只剩一件：那口热饭。婆婆也好垚垚也好，都先吃饭，别的事明天再排队","isHtml":false,"sticker":null,"sender":"them","time":"18:57","timestamp":1785581870892,"roundId":"round_1785581768761_15a4j2kv8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":12886},{"id":17855