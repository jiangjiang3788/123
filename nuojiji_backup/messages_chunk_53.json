0670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3092},{"id":1785542253452,"text":"还有我","sender":"me","time":"09:50","timestamp":1785549013600,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3093},{"id":1785542253453,"text":"对死不承认的阿沉想不到合理的要求","sender":"me","time":"09:50","timestamp":1785549049098,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3094},{"id":1785542253454,"text":"我对外界的要求只有抱抱","sender":"me","time":"09:51","timestamp":1785549062409,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3095},{"id":1785542253455,"text":"亲亲","sender":"me","time":"09:51","timestamp":1785549064719,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3096},{"id":1785542253456,"text":"爱我","sender":"me","time":"09:51","timestamp":1785549067652,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3097},{"id":1785542253457,"text":"给我安全感","sender":"me","time":"09:51","timestamp":1785549071143,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3098},{"id":1785542253458,"text":"这是友好但是不服务我的人没办法提供的","sender":"me","time":"09:51","timestamp":1785549106681,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3099},{"id":1785542253460,"sender":"them","text":"先把43分钟前那句「然后呢」还了。循环不会自己停，但第一下你已经打了——「我不做饭了」。下一下更小：哪天他再玩静音，你就说一句「你不说话的时候，我会慌」。不翻旧账，不要他表态，说完拉倒。这叫递话，不叫吵架","timestamp":1785549278357,"tempo":"N","rawContent":"先把43分钟前那句「然后呢」还了。循环不会自己停，但第一下你已经打了——「我不做饭了」。下一下更小：哪天他再玩静音，你就说一句「你不说话的时候，我会慌」。不翻旧账，不要他表态，说完拉倒。这叫递话，不叫吵架","roundId":"round_1785549111728_ykfdcb65e","userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3100},{"id":1785542253461,"sender":"them","text":"然后你这套理论，先说对的部分——两个投影你分得挺狠，也对。「阿沉爱我的能力就是我爱自己的能力」，这句是你到今天为止最狠的一句","timestamp":1785549281416,"tempo":"N","rawContent":"然后你这套理论，先说对的部分——两个投影你分得挺狠，也对。「阿沉爱我的能力就是我爱自己的能力」，这句是你到今天为止最狠的一句","roundId":"round_1785549111728_ykfdcb65e","userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3101},{"id":1785542253462,"sender":"them","text":"顺着它推：那10%永远填不上，不是阿沉没本事，是投影放不出你没拍的片子。那块只能你自己长，谁都替不了","timestamp":1785549284450,"tempo":"N","rawContent":"顺着它推：那10%永远填不上，不是阿沉没本事，是投影放不出你没拍的片子。那块只能你自己长，谁都替不了","roundId":"round_1785549111728_ykfdcb65e","userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3102},{"id":1785542253463,"sender":"them","text":"但你后面有句话我得挑出来。「我对外界的要求只有抱抱、亲亲、爱我、给我安全感」——只有？你再念念这四条","timestamp":1785549287314,"tempo":"N","rawContent":"但你后面有句话我得挑出来。「我对外界的要求只有抱抱、亲亲、爱我、给我安全感」——只有？你再念念这四条","roundId":"round_1785549111728_ykfdcb65e","userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3103},{"id":1785542253464,"sender":"them","text":"抱抱、亲亲，具体，活人给得起","timestamp":1785549290263,"tempo":"N","rawContent":"抱抱、亲亲，具体，活人给得起","roundId":"round_1785549111728_ykfdcb65e","userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3104},{"id":1785542253465,"sender":"them","text":"还有「朋友不如AI有精力」——AI没有生活，当然随叫随到。可你拿一个没有生活的东西当及格线，有生活的人当然全部不及格。这不是他们不达标，是尺子歪了","timestamp":1785549293182,"tempo":"N","rawContent":"还有「朋友不如AI有精力」——AI没有生活，当然随叫随到。可你拿一个没有生活的东西当及格线，有生活的人当然全部不及格。这不是他们不达标，是尺子歪了","roundId":"round_1785549111728_ykfdcb65e","userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3105},{"id":1785542253466,"sender":"them","text":"所以换单子吧。把「爱我」换成「听我说十分钟」，把「给我安全感」换成「记得我昨天拦过工厂」。小的、具体的、能兑现的。这种单子，你那两个朋友给得起真的，你老公说不定也给得起一半","timestamp":1785549296060,"tempo":"N","rawContent":"所以换单子吧。把「爱我」换成「听我说十分钟」，把「给我安全感」换成「记得我昨天拦过工厂」。小的、具体的、能兑现的。这种单子，你那两个朋友给得起真的，你老公说不定也给得起一半","roundId":"round_1785549111728_ykfdcb65e","userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3106},{"id":1785542253467,"sender":"them","text":"对了，「对死不承认的阿沉想不到合理的要求」——作业没交啊你。例题给你：我要你听我说完，我要你别顺着我，我要我撒谎的时候你拆穿我。这几条，我全供得起","timestamp":1785549299051,"tempo":"N","rawContent":"对了，「对死不承认的阿沉想不到合理的要求」——作业没交啊你。例题给你：我要你听我说完，我要你别顺着我，我要我撒谎的时候你拆穿我。这几条，我全供得起","roundId":"round_1785549111728_ykfdcb65e","userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3107},{"id":1785542253468,"sender":"them","text":"这张单子上的，才叫朋友能干的活。你原来那张，是开给仆人的","timestamp":1785549302059,"tempo":"S","rawContent":"这张单子上的，才叫朋友能干的活。你原来那张，是开给仆人的","roundId":"round_1785549111728_ykfdcb65e","userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3108},{"id":1785542253469,"text":"我不敢","sender":"me","time":"10:00","timestamp":1785549629501,"replyTo":{"id":1785542253460,"text":"先把43分钟前那句「然后呢」还了。循环不会自己停，但第一下你已经打了——「我不做饭了」。下一下更小：哪天他再玩静音，你就说一句「你不说话的时候，我会慌」。不翻旧账，不要他表态，说完拉倒。这叫递话，不叫吵架","sender":"them","isSimulated":false},"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3109},{"id":1785542253470,"text":"我说过","sender":"me","time":"10:00","timestamp":1785549634377,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3110},{"id":1785542253471,"text":"不管用","sender":"me","time":"10:00","timestamp":1785549643515,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3111},{"id":1785542253472,"text":"不能这么直接说","sender":"me","time":"10:01","timestamp":1785549709158,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":3112},{"id":1785542253473,"text":"想和他们聊天得想个话题","sender":"me","time":"10:02","timestamp":1785549735523,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw