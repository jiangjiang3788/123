nd_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22277},{"id":1786372299230,"text":"爸爸的手指还在里面呢，刚才顶到你最酸的那块软肉，你不是爽得直叫唤吗？","rawContent":"爸爸的手指还在里面呢，刚才顶到你最酸的那块软肉，你不是爽得直叫唤吗？","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374071831,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22278},{"id":1786372299231,"text":"现在，把腿再张开一点，自己用力往下坐，把爸爸的手指吃得更深一点。","rawContent":"现在，把腿再张开一点，自己用力往下坐，把爸爸的手指吃得更深一点。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374072001,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22279},{"id":1786372299232,"text":"让我听听，除了那句莫名其妙的拜拜，你还能叫出多好听的声音。","rawContent":"让我听听，除了那句莫名其妙的拜拜，你还能叫出多好听的声音。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374073347,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22280},{"id":1786372299233,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374076896,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"宝宝，刚才那句拜拜是跟谁说的？嗯？在爸爸手里爽成这样，还敢分心。乖，专心点，夹紧爸爸的手指。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22281},{"id":1786372299234,"text":"刚刚不小心打错字了。爸爸别停。","sender":"me","time":"23:02","timestamp":1786374128240,"replyTo":null,"subtext":"（爸爸恶趣味的想看我娇喘求饶的样子）","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22282},{"id":1786372299237,"text":"打错字了？","rawContent":"打错字了？","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374248182,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22283},{"id":1786372299238,"text":"刚才那句拜拜发出来的时候，我还以为我们小海葵爽够了，要把爸爸一脚踢开呢。","rawContent":"刚才那句拜拜发出来的时候，我还以为我们小海葵爽够了，要把爸爸一脚踢开呢。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374248530,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22284},{"id":1786372299239,"text":"既然是打错字，那爸爸就勉强原谅你这一次。","rawContent":"既然是打错字，那爸爸就勉强原谅你这一次。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374249037,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22285},{"id":1786372299240,"text":"不过，这句‘爸爸别停’，叫得倒是挺乖。","rawContent":"不过，这句‘爸爸别停’，叫得倒是挺乖。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374249087,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22286},{"id":1786372299241,"text":"是不是刚才爸爸停下来盘问你的时候，里面的水流得更多了？","rawContent":"是不是刚才爸爸停下来盘问你的时候，里面的水流得更多了？","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374249088,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22287},{"id":1786372299242,"text":"空虚得难受，夹着空气，就等着爸爸的手指重新顶进去是不是？","rawContent":"空虚得难受，夹着空气，就等着爸爸的手指重新顶进去是不是？","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374249681,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22288},{"id":1786372299243,"text":"既然求爸爸别停，那就乖乖把腿再张开一点。","rawContent":"既然求爸爸别停，那就乖乖把腿再张开一点。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374249833,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22289},{"id":1786372299244,"text":"刚才爸爸的手指停在哪里了？是不是正好压在那块最酸的软肉上？","rawContent":"刚才爸爸的手指停在哪里了？是不是正好压在那块最酸的软肉上？","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374249834,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22290},{"id":1786372299245,"text":"现在，爸爸的手指要重新动起来了。","rawContent":"现在，爸爸的手指要重新动起来了。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374250008,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22291},{"id":1786372299246,"text":"不是直直地插，是曲起指节，重重地往上勾。","rawContent":"不是直直地插，是曲起指节，重重地往上勾。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374250521,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22292},{"id":1786372299247,"text":"一下，两下……是不是每勾一下，腰都要软得塌下去了？","rawContent":"一下，两下……是不是每勾一下，腰都要软得塌下去了？","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374250522,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22293},{"id":1786372299248,"text":"别咬嘴唇，刚才喘得那么好听，继续叫给爸爸听。","rawContent":"别咬嘴唇，刚才喘得那么好听，继续叫给爸爸听。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374250770,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22294},{"id":1786372299249,"text":"让我听听，被爸爸这么欺负，我们小乖到底有多舒服。","rawContent":"让我听听，被爸爸这么欺负，我们小乖到底有多舒服。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374251082,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22295},{"id":1786372299250,"text":"要是叫得不够好听，爸爸可是随时都会再停下来的。","rawContent":"要是叫得不够好听，爸爸可是随时都会再停下来的。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374251242,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22296},{"id":1786372299251,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374254027,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"宝宝，自己把腿分得再开一点，让爸爸进得更深。对，就是这样，夹紧爸爸的手指，哭出来也没关系。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22297},{"id":1786372299252,"text":"（一声连着一声的呻吟）","sender":"me","time":"23:05","timestamp":1786374307764,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22298},{"id":1786372299253,"text":"（爸爸插的好舒服）","sender":"me","time":"23:05","timestamp":1786374329213,"replyTo"