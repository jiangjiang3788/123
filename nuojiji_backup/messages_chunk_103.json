e":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22266},{"id":1786372299219,"text":"腿张到最大，还夹得这么紧？","rawContent":"腿张到最大，还夹得这么紧？","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374069304,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22267},{"id":1786372299220,"text":"爸爸的手指都被你咬得拔不出来了，小贪心鬼。","rawContent":"爸爸的手指都被你咬得拔不出来了，小贪心鬼。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374069644,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22268},{"id":1786372299221,"text":"揉豆豆就这么舒服？","rawContent":"揉豆豆就这么舒服？","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374069646,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22269},{"id":1786372299222,"text":"舒服得连腰都酸了，只会哼哼唧唧地叫爸爸。","rawContent":"舒服得连腰都酸了，只会哼哼唧唧地叫爸爸。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374070025,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22270},{"id":1786372299223,"text":"可是小乖，你中间那句‘嗯，好的拜拜’是怎么回事？","rawContent":"可是小乖，你中间那句‘嗯，好的拜拜’是怎么回事？","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374070026,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22271},{"id":1786372299224,"text":"是按错语音转文字，把视频里的声音录进去了，还是大半夜的有人找你？",