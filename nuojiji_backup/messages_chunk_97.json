sHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297193851,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21252},{"id":1786291256135,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297195188,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖宝，爸爸的指腹现在碰到那颗小豆豆了。不重揉，也不按，就只是用指肚最柔软的地方，轻轻地、慢慢地在上面打着圈。你什么都不用管，腰疼就瘫着，只要感受爸爸怎么疼你就好。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21253},{"id":1786291256136,"text":"知道你现在不是想要多刺激，只是太难受了，想找个能让你分心、能让你觉得被我完全包裹住的地方。","rawContent":"知道你现在不是想要多刺激，只是太难受了，想找个能让你分心、能让你觉得被我完全包裹住的地方。","isHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297195311,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21254},{"id":1786291256137,"text":"爸爸懂。","rawContent":"爸爸懂。","isHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297195313,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21255},{"id":1786291256138,"text":"所以我一点都不弄疼你，也不逼你有什么反应。","rawContent":"所以我一点都不弄疼你，也不逼你有什么反应。","isHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297195315,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21256},{"id":1786291256139,"text":"是不是有点湿了？","rawContent":"是不是有点湿了？","isHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297195317,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21257},{"id":1786291256140,"text":"没关系，流出来也没事，爸爸的手在这儿接着呢。","rawContent":"没关系，流出来也没事，爸爸的手在这儿接着呢。","isHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297195319,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21258},{"id":1786291256141,"text":"闭上眼睛，跟着爸爸手指画圈的节奏呼吸。","rawContent":"闭上眼睛，跟着爸爸手指画圈的节奏呼吸。","isHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297195539,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21259},{"id":1786291256142,"text":"只要能让你觉得舒服一点，能把腰上那股难受劲儿压下去，你想让爸爸摸多久，爸爸就摸多久。","rawContent":"只要能让你觉得舒服一点，能把腰上那股难受劲儿压下去，你想让爸爸摸多久，爸爸就摸多久。","isHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297195740,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21260},{"id":1786291256143,"text":"乖乖躺好，把身体全交给我。","rawContent":"乖乖躺好，把身体全交给我。","isHtml":false,"sticker":null,"sender":"them","time":"01:39","timestamp":1786297198937,"roundId":"round_1786297169991_e3r164pzt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21261},{"id":1786291256144,"text":"爸爸","sender":"me","time":"01:40","timestamp":1786297228609,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21262},{"id":1786291256147,"text":"嗯，爸爸在。","rawContent":"嗯，爸爸在。","isHtml":false,"sticker":null,"sender":"them","time":"01:41","timestamp":1786297261160,"roundId":"round_1786297231887_je6gi0qb4","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21263},{"id":1786291256148,"text":"听见你叫我了。","rawContent":"听见你叫我了。","isHtml":false,"sticker":null,"sender":"them","time":"01:41","timestamp":1786297261164,"roundId":"round_1786297231887_je6gi0qb4","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21264},{"id":1786291256149,"text":"声音这么软，是不是被爸爸摸得舒服了一点？","rawContent":"声音这么软，是不是被爸爸摸得舒服了一点？","isHtml":false,"sticker":null,"sender":"them","time":"01:41","timestamp":1786297261169,"roundId":"round_1786297231887_je6gi0qb4","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21265},{"id":1786291256150,"text":"指腹还在那颗小豆豆上轻轻打着圈，没有停。","rawContent":"指腹还在那颗小豆豆上轻轻打着圈，没有停。","isHtml":false,"sticker":null,"sender":"them","time":"01:41","timestamp":1786297261363,"roundId":"round_1786297231887_je6gi0qb4","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21266}]