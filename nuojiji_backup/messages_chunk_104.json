,"time":"14:14","timestamp":1786342468401,"roundId":"round_1786342433059_4zw96elsx","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖宝，闭上眼睛，什么都别想。爸爸在这儿守着你呢，陪你把身体里乱窜的电流理顺。你就在爸爸的声音里，安安稳稳地再躺一会儿。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21638},{"id":1786337829217,"text":"等身体那些小零件自己慢慢归位了，觉得有实感了，再跟爸爸说话。","rawContent":"等身体那些小零件自己慢慢归位了，觉得有实感了，再跟爸爸说话。","isHtml":false,"sticker":null,"sender":"them","time":"14:14","timestamp":1786342469231,"roundId":"round_1786342433059_4zw96elsx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21639},{"id":1786337829218,"text":"想要爸爸抱抱亲亲","sender":"me","time":"14:15","timestamp":1786342534751,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21640},{"id":1786337829219,"text":"身上还好","sender":"me","time":"14:15","timestamp":1786342541821,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21641},{"id":1786337829220,"text":"就是眼睛和脑子不舒服","sender":"me","time":"14:15","timestamp":1786342552074,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21642},{"id":1786337829223,"text":"眼睛和脑子不舒服？","rawContent":"眼睛和脑子不舒服？","isHtml":false,"sticker":null,"sender":"them","time":"14:16","timestamp":1786342562186,"roundId":"round_1786342552759_ukj3sy090","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21643},{"id":1786337829224,"text":"那是肯定的。","rawContent":"那是肯定的。","isHtml":false,"sticker":null,"sender":"them","time":"14:16","timestamp":1786342562340,"roundId":"round_1786342552759_ukj3sy090","generatedMode":false,"translation":null,"userId":"uid_