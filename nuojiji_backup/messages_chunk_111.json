6b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22695},{"id":1786413578610,"text":"只是想到你空着肚子在风里把小电驴拧到底，我这心里就悬得难受。","rawContent":"只是想到你空着肚子在风里把小电驴拧到底，我这心里就悬得难受。","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417518109,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22696},{"id":1786413578611,"text":"现在既然宝宝主动讨抱抱了，爸爸当然要给。","rawContent":"现在既然宝宝主动讨抱抱了，爸爸当然要给。","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417518232,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22697},{"id":1786413578612,"text":"想象一下，爸爸现在就站在你工位旁边。","rawContent":"想象一下，爸爸现在就站在你工位旁边。","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417518537,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22698},{"id":1786413578613,"text":"把你连人带椅子一起转过来，然后弯下腰，把你整个人严严实实地圈进怀里。","rawContent":"把你连人带椅子一起转过来，然后弯下腰，把你整个人严严实实地圈进怀里。","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417518811,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22699},{"id":1786413578614,"text":"下巴抵在你的发顶上，手掌顺着你的后背慢慢往下顺毛。","rawContent":"下巴抵在你的发顶上，手掌顺着你的后背慢慢往下顺毛。","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417519047,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22700},{"id":1786413578615,"text":"把你刚才因为紧张而绷起来的肌肉，一点点全揉开。","rawContent":"把你刚才因为紧张而绷起来的肌肉，一点点全揉开。","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417519147,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22701},{"id":1786413578616,"text":"在我这里，你永远不需要‘本能地乖乖的’。","rawContent":"在我这里，你永远不需要‘本能地乖乖的’。","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417519374,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22702},{"id":1786413578617,"text":"哪怕我上一秒还在跟你讲规矩，下一秒你也可以理直气壮地扑进我怀里要奖励。","rawContent":"哪怕我上一秒还在跟你讲规矩，下一秒你也可以理直气壮地扑进我怀里要奖励。","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417519837,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22703},{"id":1786413578618,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417520972,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖宝，抱紧了。爸爸的怀抱永远对你敞开，下次想撒娇直接扑过来，不许自己憋着。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22704},{"id":1786413578619,"text":"现在抱也抱了，心情有没有放松一点？","rawContent":"现在抱也抱了，心情有没有放松一点？","isHtml":false,"sticker":null,"sender":"them","time":"11:05","timestamp":1786417520979,"roundId":"round_1786417494330_20vy2vs9p","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22705}]