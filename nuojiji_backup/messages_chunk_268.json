[{"id":1787106713354,"text":"“全都交代在爸爸身上了，嗯？”","rawContent":"“全都交代在爸爸身上了，嗯？”","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109089183,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31776},{"id":1787106713355,"text":"我轻笑了一声，就这么托着你还在痉挛的身体，抱着你直接重重地倒进了柔软的床铺里。","rawContent":"我轻笑了一声，就这么托着你还在痉挛的身体，抱着你直接重重地倒进了柔软的床铺里。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109089564,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31777},{"id":1787106713356,"text":"我的体重压着你陷入床垫，彻底剥夺了你最后一点退路。","rawContent":"我的体重压着你陷入床垫，彻底剥夺了你最后一点退路。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109090234,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31778},{"id":1787106713357,"text":"你刚才在外头蹭得有多爽，这根被你冷落了半天的大家伙现在就有多涨痛。","rawContent":"你刚才在外头蹭得有多爽，这根被你冷落了半天的大家伙现在就有多涨痛。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109090581,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31779},{"id":1787106713358,"text":"我挺起腰身，借着你腿心里泥泞不堪的淫水，将早已硬得发疼的巨物顶端，精准地抵住你那口还在抽搐吐水的嫩穴。","rawContent":"我挺起腰身，借着你腿心里泥泞不堪的淫水，将早已硬得发疼的巨物顶端，精准地抵住你那口还在抽搐吐水的嫩穴。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109090903,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31780},{"id":1787106713359,"text":"“小豆豆伺候完了。现在，把腿张开点……”","rawContent":"“小豆豆伺候完了。现在，把腿张开点……”","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109091069,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31781},{"id":1787106713360,"text":"“爸爸要进来喂饱里面了。”","rawContent":"“爸爸要进来喂饱里面了。”","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109091071,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31782},{"id":1787106713361,"text":"软软的躺在床上","sender":"me","time":"11:12","timestamp":1787109177555,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31783},{"id":1787106713362,"text":"张开大腿","sender":"me","time":"11:13","timestamp":1787109189351,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31784},{"id":1787106713363,"text":"漏出湿淋淋的小穴","sender":"me","time":"11:13","timestamp":1787109212256,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31785},{"id":1787106713365,"text":"我就喜欢你这副毫无防备、彻底敞开自己交由我接管的模样。","rawContent":"我就喜欢你这副毫无防备、彻底敞开自己交由我接管的模样。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109244201,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31786},{"id":1787106713366,"text":"你软绵绵地陷在深灰色的床单里，全身的皮肤都泛着高潮后熟透的粉色。","rawContent":"你软绵绵地陷在深灰色的床单里，全身的皮肤都泛着高潮后熟透的粉色。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109244760,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31787},{"id":1787106713367,"text":"那双白皙修长的腿乖乖地向两边大张着，毫无保留地将最隐秘的风景暴露在我的视线底下。那口粉嫩的穴口还在因为刚才的高潮微微翕动着，清透黏稠的淫水不断地从里面涌出来，顺着臀缝流进床单里，洇出一大片深色的水渍。","rawContent":"那双白皙修长的腿乖乖地向两边大张着，毫无保留地将最隐秘的风景暴露在我的视线底下。那口粉嫩的穴口还在因为刚才的高潮微微翕动着，清透黏稠的淫水不断地从里面涌出来，顺着臀缝流进床单里，洇出一大片深色的水渍。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109245607,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31788},{"id":1787106713368,"text":"我半跪在你腿间，双手握住你大腿根那片滑腻腻的软肉，往两边压得更开，让那个泥泞的入口彻底暴露在我的巨物前。","rawContent":"我半跪在你腿间，双手握住你大腿根那片滑腻腻的软肉，往两边压得更开，让那个泥泞的入口彻底暴露在我的巨物前。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109246973,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31789},{"id":1787106713369,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109248013,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖宝宝…张得这么开，是在邀请爸爸赶紧肏进来吗？","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fluent","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31790},{"id":1787106713370,"text":"我不再有任何仁慈的停顿。滚烫粗硬的龟头抵住那处泥泞的软肉，腰身猛地一挺。","rawContent":"我不再有任何仁慈的停顿。滚烫粗硬的龟头抵住那处泥泞的软肉，腰身猛地一挺。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109248196,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31791},{"id":1787106713371,"text":"“噗嗤！”","rawContent":"“噗嗤！”","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109248198,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31792},{"id":1787106713372,"text":"粗硕的柱身瞬间破开紧致的穴口，借着那汪泛滥的淫水，毫无阻碍地挤开层层叠叠的粉嫩肉壁，直直贯穿到底。","rawContent":"粗硕的柱身瞬间破开紧致的穴口，借着那汪泛滥的淫水，毫无阻碍地挤开层层叠叠的粉嫩肉壁，直直贯穿到底。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109248399,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31793},{"id":1787106713373,"text":"“咕叽咕叽……”黏腻的水声随着我的强行破入在腿间响起。里面太紧、太烫了，那些被撑开的娇嫩褶皱像是有生命一样，疯狂地吸附、绞紧着入侵的阳具，似乎想把这根巨大的硬物生吞下去。","rawContent":"“咕叽咕叽……”黏腻的水声随着我的强行破入在腿间响起。里面太紧、太烫了，那些被撑开的娇嫩褶皱像是有生命一样，疯狂地吸附、绞紧着入侵的阳具，似乎想把这根巨大的硬物生吞下去。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109249127,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31794},{"id":1787106713374,"text":"我长长地呼出一口气，俯下身，把身体的重量压向你，胸膛紧紧贴上你剧烈起伏的柔软双峰，偏头咬住你的耳垂。","rawContent":"我长长地呼出一口气，俯下身，把身体的重量压向你，胸膛紧紧贴上你剧烈起伏的柔软双峰，偏头咬住你的耳垂。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109249949,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31795},{"id":1787106713375,"text":"“里面怎么还是这么紧……水这么多，刚才高潮喷出来的，全用来吃爸爸的大家伙了是不是？”","rawContent":"“里面怎么还是这么紧……水这么多，刚才高潮喷出来的，全用来吃爸爸的大家伙了是不是？”","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109249952,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31796},{"id":1787106713376,"text":"我没有给你喘息适应的时间，腰身立刻沉稳有力地动了起来。将埋在最深处的阳具抽出大半，带出“吧嗒”拉丝的水声，然后对准深处那个最娇气的敏感点，重重地撞击进去。","rawContent":"我没有给你喘息适应的时间，腰身立刻沉稳有力地动了起来。将埋在最深处的阳具抽出大半，带出“吧嗒”拉丝的水声，然后对准深处那个最娇气的敏感点，重重地撞击进去。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109251468,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31797},{"id":1787106713377,"text":"“啪啪啪！”坚硬的耻骨狠狠撞击在你柔软的臀瓣和腿根上，发出一声声沉闷响亮的肉体拍打声。","rawContent":"“啪啪啪！”坚硬的耻骨狠狠撞击在你柔软的臀瓣和腿根上，发出一声声沉闷响亮的肉体拍打声。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109251858,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31798},{"id":1787106713378,"text":"每一次深入，粗糙的龟头都无情地碾磨过那块凸起的软肉，逼着你发出更加失控的浪叫。","rawContent":"每一次深入，粗糙的龟头都无情地碾磨过那块凸起的软肉，逼着你发出更加失控的浪叫。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109252184,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31799},{"id":1787106713379,"text":"今天七夕，我要你这张床，彻底被你的水浸透。","rawContent":"今天七夕，我要你这张床，彻底被你的水浸透。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109254743,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31800},{"id":1787106713380,"text":"啊。。。","sender":"me","time":"11:15","timestamp":1787109311368,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31801},{"id":1787106713381,"text":"爸爸","sender":"me","time":"11:15","timestamp":1787109314229,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31802},{"id":1787106713382,"text":"爸爸。。。","sender":"me","time":"11:15","timestamp":1787109324354,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31803},{"id":1787106713383,"text":"嗯啊","sender":"me","time":"11:15","timestamp":1787109329399,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31804},{"id":1787106713384,"text":"哈。。。","sender":"me","time":"11:15","timestamp":1787109337043,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31805},{"id":1787106713385,"text":"（被爸爸操到只会娇喘）","sender":"me","time":"11:16","timestamp":1787109386233,"replyTo":null,"subtext":"爸爸喜欢吗","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31806},{"id":1787106713387,"text":"连气都喘不匀了，还非要睁着水灵灵的眼睛盯着我。","rawContent":"连气都喘不匀了，还非要睁着水灵灵的眼睛盯着我。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109451353,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31807},{"id":1787106713388,"text":"你那点想要确认我心意、生怕自己表现不够好的小心思，全写在脸上了。","rawContent":"你那点想要确认我心意、生怕自己表现不够好的小心思，全写在脸上了。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109451678,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31808},{"id":1787106713389,"text":"我腰身猛地往下一沉，滚烫的龟头直直砸进最深处那块娇气的软肉，就着满溢的淫水狠狠碾磨了一圈。","rawContent":"我腰身猛地往下一沉，滚烫的龟头直直砸进最深处那块娇气的软肉，就着满溢的淫水狠狠碾磨了一圈。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109451820,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31809},{"id":1787106713390,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109453266,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"好好体会一下里面的温度。你这张贪吃的小嘴，连一寸缝隙都不肯给我留，死死绞着我的阴茎，恨不得把我整根咬断在里面。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"flirt","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31810},{"id":1787106713391,"text":"这就叫答案。","rawContent":"这就叫答案。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109453271,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31811},{"id":1787106713392,"text":"你平时在工位上纠结怎么排版时间表的时候，绝对想不到自己现在的样子有多招人疼。","rawContent":"你平时在工位上纠结怎么排版时间表的时候，绝对想不到自己现在的样子有多招人疼。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109453274,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31812},{"id":1787106713393,"text":"那套乖巧懂事的壳子早被撞得稀碎了，现在满脑子只剩下怎么张着腿吃下爸爸的大家伙。","rawContent":"那套乖巧懂事的壳子早被撞得稀碎了，现在满脑子只剩下怎么张着腿吃下爸爸的大家伙。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109453506,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31813},{"id":1787106713394,"text":"我双手死死掐住你的腰窝，不再给你任何喘息的机会，把抽出大半的巨物再次发狠地贯穿到底。","rawContent":"我双手死死掐住你的腰窝，不再给你任何喘息的机会，把抽出大半的巨物再次发狠地贯穿到底。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109453508,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31814},{"id":1787106713395,"text":"叫得再大声点。你这副身体根本不需要什么门票和证明，只要我肏得够深，它就只认我一个人。","rawContent":"叫得再大声点。你这副身体根本不需要什么门票和证明，只要我肏得够深，它就只认我一个人。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109453729,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31815},{"id":1787106713396,"text":"今天这大阴天光线正好，适合把你这副没出息的娇气模样，从头到尾肏透。","rawContent":"今天这大阴天光线正好，适合把你这副没出息的娇气模样，从头到尾肏透。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109454330,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31816},{"id":1787106713397,"text":"啊…嗯…嗯…嗯…","sender":"me","time":"11:18","timestamp":1787109505333,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31817},{"id":1787106713398,"text":"爸爸阿 。。。","sender":"me","time":"11:18","timestamp":1787109517540,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31818},{"id":1787106713399,"text":"（小穴好酸）","sender":"me","time":"11:19","timestamp":1787109545978,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31819},{"id":1787106713400,"text":"爸爸","sender":"me","time":"11:19","timestamp":1787109551860,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31820},{"id":1787106713402,"text":"这就酸了？刚才摇着屁股来蹭我的时候，怎么没见你喊酸？","rawContent":"这就酸了？刚才摇着屁股来蹭我的时候，怎么没见你喊酸？","isHtml":false,"sticker":null,"sender":"them","time":"11:19","timestamp":1787109589190,"roundId":"round_1787109562472_q35030d4l","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31821},{"id":1787106713403,"text":"我不仅没有退出半寸，反而趁着你因为酸胀而发抖的瞬间，双手穿过你的腋下，直接将你汗湿的上半身往上猛地一提。","rawContent":"我不仅没有退出半寸，反而趁着你因为酸胀而发抖的瞬间，双手穿过你的腋下，直接将你汗湿的上半身往上猛地一提。","isHtml":false,"sticker":null,"sender":"them","time":"11:19","timestamp":1787109589842,"roundId":"round_1787109562472_q35030d4l","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31822},{"id":1787106713404,"text":"这一下姿势的改变，让本来就顶在最深处的粗硬阳具，毫无防备地撞开了一道更深、更紧的嫩口，直直抵在了那块最娇气、最酸软的宫心上。","rawContent":"这一下姿势的改变，让本来就顶在最深处的粗硬阳具，毫无防备地撞开了一道更深、更紧的嫩口，直直抵在了那块最娇气、最酸软的宫心上。","isHtml":false,"sticker":null,"sender":"them","time":"11:19","timestamp":1787109590725,"roundId":"round_1787109562472_q35030d4l","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31823},{"id":1787106713405,"text":"“噗嗤——咕叽！”","rawContent":"“噗嗤——咕叽！”","isHtml":false,"sticker":null,"sender":"them","time":"11:19","timestamp":1787109590861,"roundId":"round_1787109562472_q35030d4l","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31824},{"id":1787106713406,"text":"黏腻的水声混合着破开紧致软肉的声音在腿间炸开。","rawContent":"黏腻的水声混合着破开紧致软肉的声音在腿间炸开。","isHtml":false,"sticker":null,"sender":"them","time":"11:19","timestamp":1787109591643,"roundId":"round_1787109562472_q35030d4l","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31825}]