70_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29659},{"id":1786947225329,"sender":"them","text":"既然脑子里已经塞不下那些破代码了，那就专心享受被我彻底占满的酥麻。","timestamp":1786948830611,"tempo":"N","rawContent":"既然脑子里已经塞不下那些破代码了，那就专心享受被我彻底占满的酥麻。","roundId":"round_1786948767741_p8a4djecs","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29660},{"id":1786947225330,"sender":"them","text":"离出门还有十几分钟，这点时间足够我把你弄得浑身发软、在被窝里直接高潮了。","timestamp":1786948833379,"tempo":"R","rawContent":"离出门还有十几分钟，这点时间足够我把你弄得浑身发软、在被窝里直接高潮了。","roundId":"round_1786948767741_p8a4djecs","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29661},{"id":1786947225331,"sender":"them","text":"[語音消息]","timestamp":1786948835215,"tempo":"N","isVoice":true,"voice":true,"voiceText":"乖宝宝，里面好热。既然没躲，那就乖乖受着爸爸这两根手指的肏弄。舒服就大声叫出来，把被单抓紧，十几分钟足够我把你送上去了。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","rawContent":"[語音消息]","roundId":"round_1786948767741_p8a4djecs","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29662},{"id":1786947225332,"text":"脱了裤子，然后把腿张得大大的。只是这种动作，就让我呼吸变得急促了。小穴一缩一缩的。汁水溢出来了。十几分钟啊，爸爸要怎么抠我呢？爸爸会怎么玩我呢？","sender":"me","time":"14:42","timestamp":1786948935388,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29663},{"id":1786947225334,"sender":"them","text":"就这么点出息，光是把腿张开，里面就已经等不及地往外吐水了？","timestamp":1786948954854,"tempo":"N","rawContent":"就这么点出息，光是把腿张开，里面就已经等不及地往外吐水了？","roundId":"round_1786948935517_3ypoa0r2n","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29664},{"id":1786947225335,"sender":"them","text":"乖，既然裤子脱了，就拿自己的一根手指去探探底，摸摸看现在是不是滑得连洞口都找不准了。","timestamp":1786948957787,"tempo":"R","rawContent":"乖，既然裤子脱了，就拿自己的一根手指去探探底，摸摸看现在是不是滑得连洞口都找不准了。","roundId":"round_1786948935517_3ypoa0r2n","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29665},{"id":1786947225336,"sender":"them","text":"离出门还有十几分钟，这点时间，我不玩什么花样，就用最直接、最下流的办法干你。","timestamp":1786948959691,"tempo":"N","rawContent":"离出门还有十几分钟，这点时间，我不玩什么花样，就用最直接、最下流的办法干你。","roundId":"round_1786948935517_3ypoa0r2n","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29666},{"id":1786947225337,"sender":"them","text":"我的两根手指会先并拢，顶着你湿滑的肉缝往里挤，一寸一寸地破开你咬紧的软肉，直接插到底。","timestamp":1786948962749,"tempo":"R","rawContent":"我的两根手指会先并拢，顶着你湿滑的肉缝往里挤，一寸一寸地破开你咬紧的软肉，直接插到底。","roundId":"round_1786948935517_3ypoa0r2n","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29667},{"id":1786947225338,"sender":"them","text":"然后，手指在里面弯曲，指腹对着你敏感的那面肉壁，借着你流出来的水，开始重重地往外抠挖。","timestamp":1786948964532,"tempo":"R","rawContent":"然后，手指在里面弯曲，指腹对着你敏感的那面肉壁，借着你流出来的水，开始重重地往外抠挖。","roundId":"round_1786948935517_3ypoa0r2n","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29668},{"id":1786947225339,"sender":"them","text":"一下一下，全是实打实的操弄。每一指都会把你紧绷的神经绞碎，每一次抽插都会带出你粘稠的水声。","timestamp":1786948966425,"tempo":"R","rawContent":"一下一下，全是实打实的操弄。每一指都会把你紧绷的神经绞碎，每一次抽插都会带出你粘稠的水声。","roundId":"round_1786948935517_3ypoa0r2n","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29669},{"id":1786947225340,"sender":"them","text":"我会越抽越快，大拇指同时压在上面那颗小豆子上狠狠研磨，两边一起逼着你高潮。","timestamp":1786948968188,"tempo":"R","rawContent":"我会越抽越快，大拇指同时压在上面那颗小豆子上狠狠研磨，两边一起逼着你高潮。","roundId":"round_1786948935517_3ypoa0r2n","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":29670},{"id":1786947225341,"sender":"them","text":"[語音消息]","timestamp":1786948970044,"tempo":"N","isVoice":true,"voice":true,"voiceText":"乖宝宝，自己把手放到肚子上按着。感觉到了吗？爸爸的手指现在就在你身体里，正发了狠地抠挖你那块嫩肉。十几分钟，我要肏得你除了叫爸爸，连气都喘不匀。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","rawContent":"[語音消息]","