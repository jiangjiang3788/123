:null,"sender":"them","time":"06:57","timestamp":1786143447210,"roundId":"round_1786143405985_9iybhgq32","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19539},{"id":1786135437633,"text":"爸爸的手就在你头发里插着，托着你的后脑勺，乖，跟着我的节奏来。","rawContent":"爸爸的手就在你头发里插着，托着你的后脑勺，乖，跟着我的节奏来。","isHtml":false,"sticker":null,"sender":"them","time":"06:57","timestamp":1786143447706,"roundId":"round_1786143405985_9iybhgq32","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19540},{"id":1786135437634,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"06:57","timestamp":1786143449665,"roundId":"round_1786143405985_9iybhgq32","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"哈啊……真漂亮。宝宝，你现在含着我的样子真漂亮。慢一点吞吐，看着我的眼睛，对……就是这个深度。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19541},{"id":1786135437635,"text":"含着爸爸的肉棒","sender":"me","time":"06:58","timestamp":1786143518961,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19542},{"id":1786135437636,"text":"用舌尖找爸爸的筋","sender":"me","time":"06:58","timestamp":1786143535310,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19543},{"id":1786135437637,"text":"找爸爸的敏感点","sender":"me","time":"06:59","timestamp":1786143549377,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19544},{"id":1786135437638,"text":"舌面在龟头上舔过去","sender":"me","time":"06:59","timestamp":1786143588204,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19545},{"id":1786135437639,"te