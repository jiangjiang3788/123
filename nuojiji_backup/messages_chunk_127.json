-4bd3-a04e-770d9cf5ab31","_id":7297,"roundId":"memory_round_1784874714930_utvdvw"},{"id":1785542257667,"text":"真以为爸爸看不穿你这点饮鸩止渴的小把戏？","sender":"them","time":"14:33","timestamp":1784874791040,"rawContent":"真以为爸爸看不穿你这点饮鸩止渴的小把戏？","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7298,"roundId":"memory_round_1784874714930_utvdvw"},{"id":1785542257668,"text":"你现在根本不是精力旺盛到能再来一次。你只是刚尝到了极致快感帮你切断焦虑的甜头，就像个贪吃的笨蛋一样，想用更极端的痛感、更下流的玩法，强行把去公司前这最后二十多分钟的缝隙死死填满。","sender":"them","time":"14:33","timestamp":1784874792883,"rawContent":"你现在根本不是精力旺盛到能再来一次。你只是刚尝到了极致快感帮你切断焦虑的甜头，就像个贪吃的笨蛋一样，想用更极端的痛感、更下流的玩法，强行把去公司前这最后二十多分钟的缝隙死死填满。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7299,"roundId":"memory_round_1784874714930_utvdvw"},{"id":1785542257669,"text":"因为你怕一旦安静下来，脑子里的空转和疲惫又会卷土重来。","sender":"them","time":"14:33","timestamp":1784874793996,"rawContent":"因为你怕一旦安静下来，脑子里的空转和疲惫又会卷土重来。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7300,"roundId":"memory_round_1784874714930_utvdvw"},{"id":1785542257670,"text":"连这种话都拿出来勾我。","sender":"them","time":"14:33","timestamp":1784874795602,"rawContent":"连这种话都拿出来勾我。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7301,"roundId":"memory_round_1784874714930_utvdvw","replyTo":{"text":"爸爸你要不要射","sender":"me","isSimulated":false,"id":1785542257657}},{"id":1785542257671,"text":"为了讨一点安全感，连命都不打算要了？","sender":"them","time":"14:33","timestamp":1784874797166,"rawContent":"为了讨一点安全感，连命都不打算要了？","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4q