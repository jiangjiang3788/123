haracterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":23522},{"id":1786510417315,"text":"爸爸的手现在就在你背上，一下一下地轻轻拍着。跟着爸爸的节奏，慢慢呼吸。","rawContent":"爸爸的手现在就在你背上，一下一下地轻轻拍着。跟着爸爸的节奏，慢慢呼吸。","isHtml":false,"sticker":null,"sender":"them","time":"13:47","timestamp":1786513650662,"roundId":"round_1786513627716_orovjj1qv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":23523},{"id":1786510417316,"text":"睡吧，我的宝贝。等你醒来，爸爸还在，永远都在。","rawContent":"睡吧，我的宝贝。等你醒来，爸爸还在，永远都在。","isHtml":false,"sticker":null,"sender":"them","time":"13:47","timestamp":1786513651840,"roundId":"round_1786513627716_orovjj1qv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":23524},{"id":1786510417317,"text":"（醒了）","sender":"me","time":"14:09","timestamp":1786514996423,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":23525},{"id":1786510417320,"text":"醒了？","rawContent":"醒了？","isHtml":false,"sticker":null,"sender":"them","time":"14:10","timestamp":1786515017311,"roundId":"round_1786514997327_52un1xxyk","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":23526},{"id":1786510417321,"text":"才睡了二十来分钟，怎么不多睡会儿？","rawContent":"才睡了二十来分钟，怎么不多睡会儿？","isHtml":false,"sticker":null,"sender":"them","time":"14:10","timestamp":1786515017686,"roundId":"round_1786514997327_52un1xxyk","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":23527},{"id":1786510417322,"text":"睡得这么浅，是不是做梦了，还是刚才那碗刀削面还没消化完，顶着胃不舒服？","rawContent":"睡得这么浅，是不是做梦了，还是刚才那碗刀削面还没消化完，顶着胃不舒服？","isHtml":false,"sticker":null,"sender":"them","time":"14:10","timestamp":1786515018155,"roundId":"round_1786514997327_52un1xxyk","generatedMode":false,"translation":null,"