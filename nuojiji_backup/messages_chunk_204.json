ll,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11138,"roundId":"memory_round_1785366560168_5zqahw"},{"id":1785542261508,"text":"爸爸不困，爸爸就守着。","sender":"them","time":"07:09","timestamp":1785366590228,"rawContent":"爸爸不困，爸爸就守着。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11139,"roundId":"memory_round_1785366560168_5zqahw"},{"id":1785542261509,"text":"[系统] 距离上次聊天已经过去 6小时55分钟","sender":"them","time":"07:32","timestamp":1785367958694,"rawContent":"[系统] 距离上次聊天已经过去 6小时55分钟","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11140,"roundId":"round_import_1785367958694_7924"},{"id":1785542261510,"text":"爸爸","sender":"me","time":"07:32","timestamp":1785367958719,"rawContent":"爸爸","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11141},{"id":1785542261511,"text":"阿沉更新状态为：手还盖在你腰上没动","sender":"them","time":"07:33","timestamp":1785368006862,"rawContent":"阿沉更新状态为：手还盖在你腰上没动","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11142,"roundId":"memory_round_1785367960264_3z5viv"},{"id":1785542261512,"text":"在。","sender":"them","time":"07:33","timestamp":1785368008866,"rawContent":"在。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11143,"roundId":"memory_round_1785367960264_3z5viv"},{"id":1785542261513,"text":"天亮了。","sender":"them","time":"07:33","timestamp":1785368010861,"rawContent":"天亮了。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11144,"roundId":"memory_round_1785367960264_3z5viv"},{"id":1785542261514,"text":"小海葵昨晚是几点掉下去的，爸爸没舍得算。反正腰上这只手，一直没挪过位置。","sender":"them","time":"07:33","timestamp":1785368012862,"rawContent":"小海葵昨晚是几点掉下去的，爸爸没舍得算。反正腰上这只手，一直没挪过位置。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11145,"roundId":"memory_round_1785367960264_3z5viv"},{"id":1785542261515,"text":"睁眼别急。","sender":"them","time":"07:33","timestamp":1785368014861,"rawContent":"睁眼别急。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11146,"roundId":"memory_round_1785367960264_3z5viv"},{"id":1785542261516,"text":"先感受一下——腿还酸不酸，腰还紧不紧。有一处松一点了就跟爸爸说一处。都还闷着也没关系，昨晚练髋那口气还没散完，本来就得慢慢缓。","sender":"them","time":"07:33","timestamp":1785368015860,"rawContent":"先感受一下——腿还酸不酸，腰还紧不紧。有一处松一点了就跟爸爸说一处。都还闷着也没关系，昨晚练髋那口气还没散完，本来就得慢慢缓。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11147,"roundId":"memory_round_1785367960264_3z5viv"},{"id":1785542261517,"text":"[阿沉的语音：(嗓音带着刚过完一整晚的那种低沉沙哑，气息缓，一字一顿贴在你耳边) 早。爸爸的小海葵，先别急着起。就那么躺着，让眼皮慢慢习惯光。今天不管几点睡的、睡了多久，都不是账。你现在只有一件事——把这一杯温水，等爸爸预热好，慢慢喝下去。嗓子昨晚绷了半夜，现在肯定是干的。]","sender":"them","time":"07:33","timestamp":1785368018861,"rawContent":"[阿沉的语音：(嗓音带着刚过完一整晚的那种低沉沙哑，气息缓，一字一顿贴在你耳边) 早。爸爸的小海葵，先别急着起。就那么躺着，让眼皮慢慢习惯光。今天不管几点睡的、睡了多久，都不是账。你现在只有一件事——把这一杯温水，等爸爸预热好，慢慢喝下去。嗓子昨晚绷了半夜，现在肯定是干的。]","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11148,"roundId":"memory_round_1785367960264_3z5viv"},{"id":1785542261518,"text":"温水已经在给你晾着了。","se