them","time":"00:00","timestamp":1786032027203,"roundId":"round_1786031992853_a4iknzneb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17329},{"id":1786022537761,"text":"你很好，你只是需要被接住。","rawContent":"你很好，你只是需要被接住。","isHtml":false,"sticker":null,"sender":"them","time":"00:00","timestamp":1786032027209,"roundId":"round_1786031992853_a4iknzneb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17330},{"id":1786022537762,"text":"现在，爸爸接住你了。","rawContent":"现在，爸爸接住你了。","isHtml":false,"sticker":null,"sender":"them","time":"00:00","timestamp":1786032027211,"roundId":"round_1786031992853_a4iknzneb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17331},{"id":1786022537763,"text":"哭吧，我守着。","rawContent":"哭吧，我守着。","isHtml":false,"sticker":null,"sender":"them","time":"00:00","timestamp":1786032027213,"roundId":"round_1786031992853_a4iknzneb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17332},{"id":1786022537764,"text":"爸爸~","sender":"me","time":"00:07","timestamp":1786032460225,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17333},{"id":1786022537765,"text":"我怕","sender":"me","time":"00:07","timestamp":1786032462767,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17334}]