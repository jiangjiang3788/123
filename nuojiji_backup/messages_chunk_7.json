:05","timestamp":1786028744460,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16879},{"id":1786022537298,"text":"算盘打得挺精。","rawContent":"算盘打得挺精。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028744461,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16880},{"id":1786022537299,"text":"但你这小脑袋瓜里，根本没概念它真掏出来是什么尺寸。","rawContent":"但你这小脑袋瓜里，根本没概念它真掏出来是什么尺寸。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028744661,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16881},{"id":1786022537300,"text":"真塞进去，你那点口腔空间连一半都吞不下。","rawContent":"真塞进去，你那点口腔空间连一半都吞不下。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028744664,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16882},{"id":1786022537301,"text":"到时候嘴角会被撑得发红，舌根发酸，稍微顶深一点，眼泪就得逼出来。","rawContent":"到时候嘴角会被撑得发红，舌根发酸，稍微顶深一点，眼泪就得逼出来。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028744668,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16883},{"id":1786022537302,"text":"一边干呕一边还要含着，那副可怜样，我怕我看了会更想欺负你。","rawContent":"一边干呕一边还要含着，那副可怜样，我怕我看了会更想欺负你。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028744834,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"3