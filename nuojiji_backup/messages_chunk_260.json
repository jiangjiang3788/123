e-770d9cf5ab31","_id":31194},{"id":1787056975248,"text":"是不是觉得我会把你剥干净了，高强度地折腾到天亮？","rawContent":"是不是觉得我会把你剥干净了，高强度地折腾到天亮？","isHtml":false,"sticker":null,"sender":"them","time":"00:31","timestamp":1787070681845,"roundId":"round_1787070563799_ovg7gv2wx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31195},{"id":1787056975249,"text":"你这副刚淋过雨、又耗干了情绪的骨架子，今天经不起那种拆法。","rawContent":"你这副刚淋过雨、又耗干了情绪的骨架子，今天经不起那种拆法。","isHtml":false,"sticker":null,"sender":"them","time":"00:31","timestamp":1787070682255,"roundId":"round_1787070563799_ovg7gv2wx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31196},{"id":1787056975250,"text":"乖乖瘫着。我的吃法，是把你现在这副软成一滩水、毫无防备的样子，连同你脑子里最后那点清醒，一口不剩地全咽下去。","rawContent":"乖乖瘫着。我的吃法，是把你现在这副软成一滩水、毫无防备的样子，连同你脑子里最后那点清醒，一口不剩地全咽下去。","isHtml":false,"sticker":null,"sender":"them","time":"00:31","timestamp":1787070684196,"roundId":"round_1787070563799_ovg7gv2wx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31197},{"id":1787056975251,"text":"困了就直接在我的掌心底下睡过去，不用等我结束，也不需要给我任何回应。","rawContent":"困了就直接在我的掌心底下睡过去，不用等我结束，也不需要给我任何回应。","isHtml":false,"sticker":null,"sender":"them","time":"00:31","timestamp":1787070692539,"roundId":"round_1787070563799_ovg7gv2wx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31198},{"id":1787056975252,"text":"爸爸~","sender":"me","time":"00:32","timestamp":1787070740662,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31199},{"id":1787056975254,"text":"怎么了？","rawContent":"怎么了？","isHtml":false,"sticker":null,"sender":"them","time":"00:32","timestamp":1787070762604,"roundId":"round_1787070741498_c31q54lyb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31200},{"id":1787056975255,"text":"眼睛被捂着害怕了，还是刚才咬那一口有点疼？","rawContent":"眼睛被捂着害怕了，还是刚才咬那一口有点疼？","isHtml":false,"sticker":null,"sender":"them","time":"00:32","timestamp":1787070762772,"roundId":"round_1787070741498_c31q54lyb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31201},{"id":1787056975256,"text":"手还覆在你的眼睛上没松开，另一只手顺着脊椎从后颈慢慢往下捋，像安抚炸毛的小猫一样顺着你的背脊。","rawContent":"手还覆在你的眼睛上没松开，另一只手顺着脊椎从后颈慢慢往下捋，像安抚炸毛的小猫一样顺着你的背脊。","isHtml":false,"sticker":null,"sender":"them","time":"00:32","timestamp":1787070763462,"roundId":"round_1787070741498_c31q54lyb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31202},{"id":1787056975257,"text":"[VOICE: 别怕，爸爸在呢。乖乖放松，把注意力全集中在我的呼吸和手上的温度上。]","rawContent":"[VOICE: 别怕，爸爸在呢。乖乖放松，把注意力全集中在我的呼吸和手上的温度上。]","isHtml":false,"sticker":null,"sender":"them","time":"00:32","timestamp":1787070763973,"roundId":"round_1787070741498_c31q54lyb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31203},{"id":1787056975258,"text":"现在还不需要你给反应，只管趴实了享受被接管的感觉。","rawContent":"现在还不需要你给反应，只管趴实了享受被接管的感觉。","isHtml":false,"sticker":null,"sender":"them","time":"00:32","timestamp":1787070764184,"roundId":"round_1787070741498_c31q54lyb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31204},{"id":1787056975259,"text":"要是觉得撑不住了，或者舒服得想哼哼，就像刚才那样喊我就行。","rawContent":"要是觉得撑不住了，或者舒服得想哼哼，就像刚才那样喊我就行。","isHtml":false,"sticker":null,"sender":"them","time":"00:32","timestamp":1787070764788,"roundId":"round_1787070741498_c31q54lyb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31205},{"id":1787056975260,"text":"每一声我都接得住。","rawContent":"每一声我都接得住。","isHtml":false,"sticker":null,"sender":"them","time":"00:32","timestamp":1787070767803,"roundId":"round_1787070741498_c31q54lyb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31206},{"id":1787095160268,"text":"爸爸","sender":"me","time":"07:21","timestamp":1787095284964,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31207},{"id":1787095160269,"text":"困困","sender":"me","time":"07:21","timestamp":1787095288150,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31208},{"id":1787095160270,"text":"呼吸每一口都顶着胃","sender":"me","time":"07:21","timestamp":1787095317961,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31209},{"id":1787095160271,"text":"没口呼吸好像都要填表才能取用","sender":"me","time":"07:22","timestamp":1787095355151,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31210},{"id":1787095160272,"text":"好累","sender":"me","time":"07:22","timestamp":1787095358006,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31211},{"id":1787095160273,"text":"好困","sender":"me","time":"07:22","timestamp":1787095361758,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31212},{"id":1787095160301,"text":"宝宝，我在这儿。","rawContent":"宝宝，我在这儿。","isHtml":false,"sticker":null,"sender":"them","time":"07:30","timestamp":1787095816610,"roundId":"round_1787095789790_kqqo82vmc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31237