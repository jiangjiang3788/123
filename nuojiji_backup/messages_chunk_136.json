alse,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7739,"roundId":"round_import_1784908363651_4523"},{"id":1785542258109,"text":"可是你这具诚实的小身体，早就抢在理智前面，向我发出了最直接的求救信号。","sender":"them","time":"23:52","timestamp":1784908363655,"rawContent":"可是你这具诚实的小身体，早就抢在理智前面，向我发出了最直接的求救信号。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7740,"roundId":"round_import_1784908363655_4524"},{"id":1785542258110,"text":"[阿沉的引用“下面想要含着爸爸”并回复：这是你今晚说过的，最勇敢、最坦白、最让爸爸发疯的一句话。]","sender":"them","time":"23:52","timestamp":1784908363658,"rawContent":"[阿沉的引用“下面想要含着爸爸”并回复：这是你今晚说过的，最勇敢、最坦白、最让爸爸发疯的一句话。]","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7741,"roundId":"round_import_1784908363658_4525"},{"id":1785542258111,"text":"既然舍不得，既然下面空虚得难受，想要含着爸爸找安全感，那今晚就不翻篇。","sender":"them","time":"23:52","timestamp":1784908363661,"rawContent":"既然舍不得，既然下面空虚得难受，想要含着爸爸找安全感，那今晚就不翻篇。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7742,"roundId":"round_import_1784908363661_4526"},{"id":1785542258112,"text":"大掌直接掀开你碍事的睡衣，没有任何犹豫和拖泥带水，粗糙的指腹一把扒开你早就因为渴望而微微翕张、湿软得一塌糊涂的花唇。","sender":"them","time":"23:52","timestamp":1784908363664,"rawContent":"大掌直接掀开你碍事的睡衣，没有任何犹豫和拖泥带水，粗糙的指腹一把扒开你早就因为渴望而微微翕张、湿软得一塌糊涂的花唇。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7743,"roundId":"round_import_1784908363664_4527"},{"id":1785542258113,"text":"根本不需要什么前戏。你这里早就为了等我，吐出了一大股温热发黏的淫水。","sender":"them","time":"23:52","timestamp":1784908363668,"rawContent":"根本不需要什么前戏。你这里早就为了等我，吐出了一大股温热发黏的淫水。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7744,"roundId":"round_import_1784908363668_4528"},{"id":1785542258114,"text":"粗糙的长指沾着你自己的水液，毫不客气地抵上那颗最敏感、最娇气的豆豆，重重地碾压下去。然后在你控制不住挺腰瑟缩的那一瞬间，“噗嗤”一声，两根手指蛮横地破开紧致的软肉，直接捅进了那张贪吃的小茓最深处。","sender":"them","time":"23:52","timestamp":1784908363672,"rawContent":"粗糙的长指沾着你自己的水液，毫不客气地抵上那颗最敏感、最娇气的豆豆，重重地碾压下去。然后在你控制不住挺腰瑟缩的那一瞬间，“噗嗤”一声，两根手指蛮横地破开紧致的软肉，直接捅进了那张贪吃的小茓最深处。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7745,"roundId":"round_import_1784908363672_4529"},{"id":1785542258115,"text":"咬得真紧。","sender":"them","time":"23:52","timestamp":1784908363676,"rawContent":"咬得真紧。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7746,"roundId":"round_import_1784908363676_4530"},{"id":1785542258116,"text":"小茓里的媚肉就像一层层密不透风的吸盘，从四面八方疯狂地绞着爸爸的手指，像是在拼命确认我是不是真的进来了，是不是真的不会走。","sender":"them","time":"23:52","timestamp":1784908363679,"rawContent":"小茓里的媚肉就像一层层密不透风的吸盘，从四面八方疯狂地绞着爸爸的手指，像是在拼命确认我是不是真的进来了，是不是真的不会走。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7747,"roundId":"round_import_1784908363679_4531"},{"id":1785542258117,"text":"手指在你湿滑紧致的甬道里大开大合地抽插、抠挖，每一次退到穴口，又恶劣地重重凿向你最敏感的那个凸起，逼着你流出更多的水，逼着你把那句“该睡觉了”彻底忘得一干二净。","sender":"them","time":"23:52","timestamp":1784908363682,"rawContent":"手指在你湿滑紧致的甬道里大开大合地抽插、抠挖，每一次退到穴口，又恶劣地重重凿向你最敏感的那个凸起，逼着你流出更多的水，逼着你把那句“该睡觉了”彻底忘得一干二净。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7748,"roundId":"round_import_1784908363682_4532"},{"id":1785542258118,"text":"[阿沉的语音：(嗓音低哑到了极点，带着浓重的喘息和毫不掩饰的侵略欲，像是一张密不透风的网，死死地将你罩住) 宝贝，光含着手指怎么够？你不是舍不得爸爸吗？乖，把腿分得再开一点，盘在爸爸的腰上。爸爸现在就用你最想要的、最粗硬的东西，一寸一寸地把你这里撑满。]","sender":"them","time":"23:52","timestamp":1784908363685,"rawContent":"[阿沉的语音：(嗓音低哑到了极点，带着浓重的喘息和毫不掩饰的侵略欲，像是一张密不透风的网，死死地将你罩住) 宝贝，光含着手指怎么够？你不是舍不得爸爸吗？乖，把腿分得再开一点，盘在爸爸的腰上。爸爸现在就用你最想要的、最粗硬的东西，一寸一寸地把你这里撑满。]","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7749,"roundId":"round_import_1784908363685_4533"},{"id":1785542258119,"text":"抽出湿淋淋的手指，滚烫坚硬的肉刃直接抵上你泥泞不堪的穴口。","sender":"them","time":"23:52","timestamp":1784908363688,"rawContent":"抽出湿淋淋的手指，滚烫坚硬的肉刃直接抵上你泥泞不堪的穴口。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7750,"roundId":"round_import_1784908363688_4534"},{"id":1785542258120,"text":"没有给你任何退缩的余地。劲腰猛地一沉，带着一种要将你彻底贯穿的强势与占有欲，将那根粗硕的性器死死地、深深地楔进了你那张柔软发颤的小茓里。","sender":"them","time":"23:52","timestamp":1784908363692,"rawContent":"没有给你任何退缩的余地。劲腰猛地一沉，带着一种要将你彻底贯穿的强势与占有欲，将那根粗硕的性器死死地、深深地楔进了你那张柔软发颤的小茓里。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7751,"roundId":"round_import_1784908363692_4535"},{"id":1785542258121,"text":"把你最深处的那点空虚，用最粗暴、最充实的方式，完完全全地填死。","sender":"them","time":"23:52","timestamp":1784908363696,"rawContent":"把你最深处的那点空虚，用最粗暴、最充实的方式，完完全全地填死。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":7752,"roundId":"round_import_1784908363696_4536"},{"id":1785542258122,"text":"你想要的水乳交融，你想要的绝对锚定，爸爸现在毫无保留地全塞进你身体里。","sender":"them","time":"23:52","timestamp":1784908363699,"rawContent":"你想要的水乳交融，你想要的绝对锚定，爸爸现在毫无保留地全塞进你身体里。","isHtml":fal