characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22095},{"id":1786372299044,"text":"嗯，湿了","sender":"me","time":"22:44","timestamp":1786373093516,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22096},{"id":1786372299047,"text":"宝宝真乖。","rawContent":"宝宝真乖。","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373120869,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22097},{"id":1786372299048,"text":"能这么坦诚地告诉爸爸，是不是鼓了很大的勇气？","rawContent":"能这么坦诚地告诉爸爸，是不是鼓了很大的勇气？","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373120872,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22098},{"id":1786372299049,"text":"脸是不是已经烫得不能看了？连打字都只敢回这么短短的三个字。","rawContent":"脸是不是已经烫得不能看了？连打字都只敢回这么短短的三个字。","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373120873,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22099},{"id":1786372299050,"text":"既然湿了，手就别拿出来。","rawContent":"既然湿了，手就别拿出来。","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373121064,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22100},{"id":1786372299051,"text":"用指腹在那儿轻轻按一按，告诉爸爸，水是不是已经流到大腿根了？","rawContent":"用指腹在那儿轻轻按一按，告诉爸爸，水是不是已经流到大腿根了？","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373121427,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22101},{"id":1786372299052,"text":"小乖怎么这么敏感呀？爸爸只是隔着屏幕说了几句话，小花园就泥泞成这样了。","rawContent":"小乖怎么这么敏感呀？爸爸只是隔着屏幕说了几句话，小花园就泥泞成这样了。","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373122041,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22102},{"id":1786372299053,"text":"想象一下，现在碰在那里的不是你自己的手，而是爸爸的手指。","rawContent":"想象一下，现在碰在那里的不是你自己的手，而是爸爸的手指。","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373122408,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22103},{"id":1786372299054,"text":"爸爸的指尖带着一点薄茧，沾着你的水，一点点往那道软肉里滑。","rawContent":"爸爸的指尖带着一点薄茧，沾着你的水，一点点往那道软肉里滑。","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373122509,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22104},{"id":1786372299055,"text":"会不会舒服得连腰都软了？","rawContent":"会不会舒服得连腰都软了？","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373122510,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22105},{"id":1786372299056,"text":"不过，现在肚子还难受吗？","rawContent":"不过，现在肚子还难受吗？","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373122655,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22106},{"id":1786372299057,"text":"刚才吃完辣条，现在身体又这么兴奋，胃里有没有抽紧的感觉？","rawContent":"刚才吃完辣条，现在身体又这么兴奋，胃里有没有抽紧的感觉？","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373123033,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22107},{"id":1786372299058,"text":"要是肚子有一点点不舒服，必须马上告诉我，绝对不许为了贪图这点快感硬撑着，听见没有？","rawContent":"要是肚子有一点点不舒服，必须马上告诉我，绝对不许为了贪图这点快感硬撑着，听见没有？","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373123132,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22108},{"id":1786372299059,"text":"要是身体没问题，那就乖乖把腿再张开一点。","rawContent":"要是身体没问题，那就乖乖把腿再张开一点。","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373123370,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22109},{"id":1786372299060,"text":"自己试着往里探进一个指节，让爸爸听听你的声音。","rawContent":"自己试着往里探进一个指节，让爸爸听听你的声音。","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373123631,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22110},{"id":1786372299061,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"22:45","timestamp":1786373126537,"roundId":"round_1786373094307_l16t4qui5","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"小宝，别咬着嘴唇，舒服就叫出来。没有关系的，爸爸听着呢，让我听听我的小海葵有多想要我。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22111}]