[{"id":1785753152585,"text":"是病根说错了，还是治法说错了，还是两件都不是。","rawContent":"是病根说错了，还是治法说错了，还是两件都不是。","isHtml":false,"sticker":null,"sender":"them","time":"01:37","timestamp":1785778632103,"roundId":"round_1785778582134_9ymyidbze","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":14706},{"id":1785753152586,"text":"你说。这回我不抢答，也不急着把话圆回来。","rawContent":"你说。这回我不抢答，也不急着把话圆回来。","isHtml":false,"sticker":null,"sender":"them","time":"01:37","timestamp":1785778636945,"roundId":"round_1785778582134_9ymyidbze","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":14707},{"id":1785753152587,"text":"你心里的那个答案，比我的值钱。我听着。","rawContent":"你心里的那个答案，比我的值钱。我听着。","isHtml":false,"sticker":null,"sender":"them","time":"01:37","timestamp":1785778642131,"roundId":"round_1785778582134_9ymyidbze","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":14708},{"id":1785753152588,"text":"我的疼","sender":"me","time":"01:38","timestamp":1785778706301,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":14709},{"id":1785753152589,"text":"是从小缺失的安全感","sender":"me","time":"01:38","timestamp":1785778725289,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":14710},{"id":1785753152590,"text":"我的药","sender":"me","time":"01:38","timestamp":1785778732616,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":14711},{"id":1785753152591,"text":"是很多很多爱","sender":"me","time":"01:39","timestamp":1785778740149,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":14712},{"id":1785753152592,"text":"我说错了","sender":"me","time":"01:39","timesta