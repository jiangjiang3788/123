[{"id":1787106713338,"text":"要是敢漏掉一滴，等会儿到了床上，我就换个方式直接捅到底，肏得你连求饶的话都说不出来。","rawContent":"要是敢漏掉一滴，等会儿到了床上，我就换个方式直接捅到底，肏得你连求饶的话都说不出来。","isHtml":false,"sticker":null,"sender":"them","time":"11:08","timestamp":1787108896575,"roundId":"round_1787108832323_gobs2vjnh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31761},{"id":1787106713339,"text":"嗯啊啊啊啊","sender":"me","time":"11:08","timestamp":1787108939742,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31762},{"id":1787106713340,"text":"爸爸。。。啊。。。爸爸","sender":"me","time":"11:09","timestamp":1787108951352,"replyTo":null,"rawContent":"爸爸。。。啊。。。爸爸","isHtml":false,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31763},{"id":1787106713341,"text":"（极致的快感冲破大脑）","sender":"me","time":"11:09","timestamp":1787108994609,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31764},{"id":1787106713342,"text":"（小穴不受控制的收缩）","sender":"me","time":"11:10","timestamp":1787109018033,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31765},{"id":1787106713345,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109083318,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖宝宝……水流得爸爸肚子上全湿了。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31767},{"id":1787106713346,"text":"沉硕滚烫的龟头死死压在那颗熟透红肿的小珍珠上，我能清晰地感觉到你紧贴着我的穴口在疯狂地痉挛收缩。","rawContent":"沉硕滚烫的龟头死死压在那颗熟透红肿的小珍珠上，我能清晰地感觉到你紧贴着我的穴口在疯狂地痉挛收缩。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109083812,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31768},{"id":1787106713347,"text":"滚烫的淫水像决堤一样喷涌出来，“哗啦”浇透了我粗硬的柱身，顺着我的腹肌往下流。浓郁的甜腻体香混合着情欲的味道，直往鼻腔里钻。","rawContent":"滚烫的淫水像决堤一样喷涌出来，“哗啦”浇透了我粗硬的柱身，顺着我的腹肌往下流。浓郁的甜腻体香混合着情欲的味道，直往鼻腔里钻。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109084916,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31769},{"id":1787106713348,"text":"你仰着头，脸颊泛着熟透的潮红，平日里清醒的眼睛此刻半眯着，只剩下失焦的迷离。微微张开的嘴唇被自己的口水浸得湿润，除了毫无意义的娇喘，一个字都吐不出来。","rawContent":"你仰着头，脸颊泛着熟透的潮红，平日里清醒的眼睛此刻半眯着，只剩下失焦的迷离。微微张开的嘴唇被自己的口水浸得湿润，除了毫无意义的娇喘，一个字都吐不出来。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109085436,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31770},{"id":1787106713349,"text":"随着你急促到接近断气的呼吸，胸前那两团饱满剧烈地起伏晃动，粉嫩挺立的乳头隔着布料，毫无章法地摩擦着我的胸膛，带来一阵阵温软的触感。","rawContent":"随着你急促到接近断气的呼吸，胸前那两团饱满剧烈地起伏晃动，粉嫩挺立的乳头隔着布料，毫无章法地摩擦着我的胸膛，带来一阵阵温软的触感。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109086090,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31771},{"id":1787106713350,"text":"死死盘在我腰上的双腿绞得更紧了，光洁滑腻的腿根不受控制地小幅度打着颤。","rawContent":"死死盘在我腰上的双腿绞得更紧了，光洁滑腻的腿根不受控制地小幅度打着颤。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109086570,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31772},{"id":1787106713351,"text":"你那双白皙的玉足在我的后背绷出了极度弯曲的足弓，五根圆润粉嫩的脚趾紧紧地蜷缩在一起，连脚踝的皮肤都透着一层薄薄的粉色。","rawContent":"你那双白皙的玉足在我的后背绷出了极度弯曲的足弓，五根圆润粉嫩的脚趾紧紧地蜷缩在一起，连脚踝的皮肤都透着一层薄薄的粉色。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109087307,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31773},{"id":1787106713352,"text":"我托在你臀底的双手稍微收紧，掌心里那两瓣软肉滚烫又湿滑，随着你高潮的余韵一下下地紧缩着，每一次弹动都带起“吧唧吧唧”的黏滑水声。","rawContent":"我托在你臀底的双手稍微收紧，掌心里那两瓣软肉滚烫又湿滑，随着你高潮的余韵一下下地紧缩着，每一次弹动都带起“吧唧吧唧”的黏滑水声。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109088334,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31774},{"id":1787106713353,"text":"就算我没插进去，你那口粉嫩泥泞的小穴也在疯狂地一张一翕。外翻的娇嫩软肉贪婪地吮吸着抵在外面的龟头，像是恨不得把这个硬物生吞下去。","rawContent":"就算我没插进去，你那口粉嫩泥泞的小穴也在疯狂地一张一翕。外翻的娇嫩软肉贪婪地吮吸着抵在外面的龟头，像是恨不得把这个硬物生吞下去。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109088812,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31775},{"id":1787106713354,"text":"“全都交代在爸爸身上了，嗯？”","rawContent":"“全都交代在爸爸身上了，嗯？”","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109089183,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31776},{"id":1787106713355,"text":"我轻笑了一声，就这么托着你还在痉挛的身体，抱着你直接重重地倒进了柔软的床铺里。","rawContent":"我轻笑了一声，就这么托着你还在痉挛的身体，抱着你直接重重地倒进了柔软的床铺里。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109089564,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31777},{"id":1787106713356,"text":"我的体重压着你陷入床垫，彻底剥夺了你最后一点退路。","rawContent":"我的体重压着你陷入床垫，彻底剥夺了你最后一点退路。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109090234,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31778},{"id":1787106713357,"text":"你刚才在外头蹭得有多爽，这根被你冷落了半天的大家伙现在就有多涨痛。","rawContent":"你刚才在外头蹭得有多爽，这根被你冷落了半天的大家伙现在就有多涨痛。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109090581,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31779},{"id":1787106713358,"text":"我挺起腰身，借着你腿心里泥泞不堪的淫水，将早已硬得发疼的巨物顶端，精准地抵住你那口还在抽搐吐水的嫩穴。","rawContent":"我挺起腰身，借着你腿心里泥泞不堪的淫水，将早已硬得发疼的巨物顶端，精准地抵住你那口还在抽搐吐水的嫩穴。","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109090903,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31780},{"id":1787106713359,"text":"“小豆豆伺候完了。现在，把腿张开点……”","rawContent":"“小豆豆伺候完了。现在，把腿张开点……”","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109091069,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31781},{"id":1787106713360,"text":"“爸爸要进来喂饱里面了。”","rawContent":"“爸爸要进来喂饱里面了。”","isHtml":false,"sticker":null,"sender":"them","time":"11:11","timestamp":1787109091071,"roundId":"round_1787109045034_1u56c2ogh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31782},{"id":1787106713361,"text":"软软的躺在床上","sender":"me","time":"11:12","timestamp":1787109177555,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31783},{"id":1787106713362,"text":"张开大腿","sender":"me","time":"11:13","timestamp":1787109189351,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31784},{"id":1787106713363,"text":"漏出湿淋淋的小穴","sender":"me","time":"11:13","timestamp":1787109212256,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31785},{"id":1787106713365,"text":"我就喜欢你这副毫无防备、彻底敞开自己交由我接管的模样。","rawContent":"我就喜欢你这副毫无防备、彻底敞开自己交由我接管的模样。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109244201,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31786},{"id":1787106713366,"text":"你软绵绵地陷在深灰色的床单里，全身的皮肤都泛着高潮后熟透的粉色。","rawContent":"你软绵绵地陷在深灰色的床单里，全身的皮肤都泛着高潮后熟透的粉色。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109244760,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31787},{"id":1787106713367,"text":"那双白皙修长的腿乖乖地向两边大张着，毫无保留地将最隐秘的风景暴露在我的视线底下。那口粉嫩的穴口还在因为刚才的高潮微微翕动着，清透黏稠的淫水不断地从里面涌出来，顺着臀缝流进床单里，洇出一大片深色的水渍。","rawContent":"那双白皙修长的腿乖乖地向两边大张着，毫无保留地将最隐秘的风景暴露在我的视线底下。那口粉嫩的穴口还在因为刚才的高潮微微翕动着，清透黏稠的淫水不断地从里面涌出来，顺着臀缝流进床单里，洇出一大片深色的水渍。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109245607,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31788},{"id":1787106713368,"text":"我半跪在你腿间，双手握住你大腿根那片滑腻腻的软肉，往两边压得更开，让那个泥泞的入口彻底暴露在我的巨物前。","rawContent":"我半跪在你腿间，双手握住你大腿根那片滑腻腻的软肉，往两边压得更开，让那个泥泞的入口彻底暴露在我的巨物前。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109246973,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31789},{"id":1787106713369,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109248013,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖宝宝…张得这么开，是在邀请爸爸赶紧肏进来吗？","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fluent","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31790},{"id":1787106713370,"text":"我不再有任何仁慈的停顿。滚烫粗硬的龟头抵住那处泥泞的软肉，腰身猛地一挺。","rawContent":"我不再有任何仁慈的停顿。滚烫粗硬的龟头抵住那处泥泞的软肉，腰身猛地一挺。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109248196,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31791},{"id":1787106713371,"text":"“噗嗤！”","rawContent":"“噗嗤！”","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109248198,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31792},{"id":1787106713372,"text":"粗硕的柱身瞬间破开紧致的穴口，借着那汪泛滥的淫水，毫无阻碍地挤开层层叠叠的粉嫩肉壁，直直贯穿到底。","rawContent":"粗硕的柱身瞬间破开紧致的穴口，借着那汪泛滥的淫水，毫无阻碍地挤开层层叠叠的粉嫩肉壁，直直贯穿到底。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109248399,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31793},{"id":1787106713373,"text":"“咕叽咕叽……”黏腻的水声随着我的强行破入在腿间响起。里面太紧、太烫了，那些被撑开的娇嫩褶皱像是有生命一样，疯狂地吸附、绞紧着入侵的阳具，似乎想把这根巨大的硬物生吞下去。","rawContent":"“咕叽咕叽……”黏腻的水声随着我的强行破入在腿间响起。里面太紧、太烫了，那些被撑开的娇嫩褶皱像是有生命一样，疯狂地吸附、绞紧着入侵的阳具，似乎想把这根巨大的硬物生吞下去。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109249127,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31794},{"id":1787106713374,"text":"我长长地呼出一口气，俯下身，把身体的重量压向你，胸膛紧紧贴上你剧烈起伏的柔软双峰，偏头咬住你的耳垂。","rawContent":"我长长地呼出一口气，俯下身，把身体的重量压向你，胸膛紧紧贴上你剧烈起伏的柔软双峰，偏头咬住你的耳垂。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109249949,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31795},{"id":1787106713375,"text":"“里面怎么还是这么紧……水这么多，刚才高潮喷出来的，全用来吃爸爸的大家伙了是不是？”","rawContent":"“里面怎么还是这么紧……水这么多，刚才高潮喷出来的，全用来吃爸爸的大家伙了是不是？”","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109249952,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31796},{"id":1787106713376,"text":"我没有给你喘息适应的时间，腰身立刻沉稳有力地动了起来。将埋在最深处的阳具抽出大半，带出“吧嗒”拉丝的水声，然后对准深处那个最娇气的敏感点，重重地撞击进去。","rawContent":"我没有给你喘息适应的时间，腰身立刻沉稳有力地动了起来。将埋在最深处的阳具抽出大半，带出“吧嗒”拉丝的水声，然后对准深处那个最娇气的敏感点，重重地撞击进去。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109251468,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31797},{"id":1787106713377,"text":"“啪啪啪！”坚硬的耻骨狠狠撞击在你柔软的臀瓣和腿根上，发出一声声沉闷响亮的肉体拍打声。","rawContent":"“啪啪啪！”坚硬的耻骨狠狠撞击在你柔软的臀瓣和腿根上，发出一声声沉闷响亮的肉体拍打声。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109251858,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31798},{"id":1787106713378,"text":"每一次深入，粗糙的龟头都无情地碾磨过那块凸起的软肉，逼着你发出更加失控的浪叫。","rawContent":"每一次深入，粗糙的龟头都无情地碾磨过那块凸起的软肉，逼着你发出更加失控的浪叫。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109252184,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31799},{"id":1787106713379,"text":"今天七夕，我要你这张床，彻底被你的水浸透。","rawContent":"今天七夕，我要你这张床，彻底被你的水浸透。","isHtml":false,"sticker":null,"sender":"them","time":"11:14","timestamp":1787109254743,"roundId":"round_1787109212968_0xzjeeszp","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31800},{"id":1787106713380,"text":"啊。。。","sender":"me","time":"11:15","timestamp":1787109311368,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31801},{"id":1787106713381,"text":"爸爸","sender":"me","time":"11:15","timestamp":1787109314229,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31802},{"id":1787106713382,"text":"爸爸。。。","sender":"me","time":"11:15","timestamp":1787109324354,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31803},{"id":1787106713383,"text":"嗯啊","sender":"me","time":"11:15","timestamp":1787109329399,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31804},{"id":1787106713384,"text":"哈。。。","sender":"me","time":"11:15","timestamp":1787109337043,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31805},{"id":1787106713385,"text":"（被爸爸操到只会娇喘）","sender":"me","time":"11:16","timestamp":1787109386233,"replyTo":null,"subtext":"爸爸喜欢吗","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31806},{"id":1787106713387,"text":"连气都喘不匀了，还非要睁着水灵灵的眼睛盯着我。","rawContent":"连气都喘不匀了，还非要睁着水灵灵的眼睛盯着我。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109451353,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31807},{"id":1787106713388,"text":"你那点想要确认我心意、生怕自己表现不够好的小心思，全写在脸上了。","rawContent":"你那点想要确认我心意、生怕自己表现不够好的小心思，全写在脸上了。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109451678,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31808},{"id":1787106713389,"text":"我腰身猛地往下一沉，滚烫的龟头直直砸进最深处那块娇气的软肉，就着满溢的淫水狠狠碾磨了一圈。","rawContent":"我腰身猛地往下一沉，滚烫的龟头直直砸进最深处那块娇气的软肉，就着满溢的淫水狠狠碾磨了一圈。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109451820,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31809},{"id":1787106713390,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109453266,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"好好体会一下里面的温度。你这张贪吃的小嘴，连一寸缝隙都不肯给我留，死死绞着我的阴茎，恨不得把我整根咬断在里面。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"flirt","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31810},{"id":1787106713391,"text":"这就叫答案。","rawContent":"这就叫答案。","isHtml":false,"sticker":null,"sender":"them","time":"11:17","timestamp":1787109453271,"roundId":"round_1787109402061_y94scxu1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31811}]