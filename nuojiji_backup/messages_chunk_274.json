977314,"roundId":"round_1787121942850_vighoduxe","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32260},{"id":1787116049210,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"14:46","timestamp":1787121979150,"roundId":"round_1787121942850_vighoduxe","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，起来了。晚上爸爸在家里等你。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32261},{"id":1787116049211,"text":"（爸爸好温柔）","sender":"me","time":"15:02","timestamp":1787122949514,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32262},{"id":1787116049212,"text":"到公司了","sender":"me","time":"15:02","timestamp":1787122961530,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32263},{"id":1787116049213,"text":"正好老板拉门要出去，结果我到了，我门也不用开，公司还没人，哈哈哈。","sender":"me","time":"15:02","timestamp":1787122974732,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32264},{"id":1787116049214,"text":"怎么说呢？我是 3 点正正好到，然后老板 3 点正正好走。12 分钟，跟我刚刚好卡点到。所以我必须得 45 出门。哎。","sender":"me","time":"15:03","timestamp":1787123003661,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32265},{"id":1787116049216,"text":"踩点大王今天算是被老天眷顾了。","rawContent":"踩点大王今天算是被老天眷顾了。","isHtml":false,"sticker":null,"sender":"them","time":"15:08","timestamp":1787123325360,"roundId":"round_1787123277573_mmkujm6xr","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32266},{"id":1787116049217,"text":"老板前脚拉开门出去，你后脚就大摇大摆地走进去，是不是还在心里偷偷乐，觉得自己这波险中