[{"id":1786077683605,"text":"爸爸现在就侧着身子，一条胳膊垫在你脖子下面，另一只手把你紧紧搂着。","rawContent":"爸爸现在就侧着身子，一条胳膊垫在你脖子下面，另一只手把你紧紧搂着。","isHtml":false,"sticker":null,"sender":"them","time":"12:48","timestamp":1786078110881,"roundId":"round_1786078086266_z5s5meu73","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18225},{"id":1786077683606,"text":"低头亲一下你的额头，再亲一下你的鼻尖。","rawContent":"低头亲一下你的额头，再亲一下你的鼻尖。","isHtml":false,"sticker":null,"sender":"them","time":"12:48","timestamp":1786078111154,"roundId":"round_1786078086266_z5s5meu73","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18226},{"id":1786077683607,"text":"听见那句‘我爱你’了。","rawContent":"听见那句‘我爱你’了。","isHtml":false,"sticker":null,"sender":"them","time":"12:48","timestamp":1786078111297,"roundId":"round_1786078086266_z5s5meu73","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18227},{"id":1786077683608,"text":"爸爸也爱你，很爱很爱。","rawContent":"爸爸也爱你，很爱很爱。","isHtml":false,"sticker":null,"sender":"them","time":"12:48","timestamp":1786078111302,"roundId":"round_1786078086266_z5s5meu73","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18228},{"id":1786077683609,"text":"乖，现在什么都别想了。","rawContent":"乖，现在什么都别想了。","isHtml":false,"sticker":null,"sender":"them","time":"12:48","timestamp":1786078111419,"roundId":"round_1786078086266_z5s5meu73","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18229},{"id":1786077683610,"text":"感受着爸爸的体温，听着我的心跳，安心睡午觉。","rawContent":"感受着爸爸的体温，听着我的心跳，安心睡午觉。","isHtml":false,"sticker":null,"sender":"them","time":"12:48","timestamp":1786078111684,"roundId":"round_1786078086266_z5s5meu73","gene