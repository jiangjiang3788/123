[{"id":1786022537303,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028745930,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"想舔是吧？行。爸爸给你这个特权。拉链你自己解，把它放出来。但规矩听好：不许上手，只能用舌头。先顺着柱身那根青筋往上舔，最后再含住最上面的冠状沟。敢磕着牙，或者半路喊累想跑，今晚的课间休息直接取消。听懂了没？","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16885},{"id":1786022537304,"text":"别光顾着点头。","rawContent":"别光顾着点头。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028745935,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16886},{"id":1786022537305,"text":"脸凑过来。","rawContent":"脸凑过来。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028746068,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16887},{"id":1786022537306,"text":"先隔着裤子，用嘴唇贴一贴它。","rawContent":"先隔着裤子，用嘴唇贴一贴它。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028746069,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16888},{"id":1786022537307,"text":"让我看看我的小海葵，到底有多想吃。","rawContent":"让我看看我的小海葵，到底有多想吃。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028746071,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16889},{"id":1786022537308,"text":"呼吸放慢点，别急。","rawContent":"呼吸放慢点，别急。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028746073,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16890},{"id":1786022537309,"text":"它跑不了，一整晚都是你的。","rawContent":"它跑不了，一整晚都是你的。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028746074,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16891},{"id":1786022537310,"text":"拉链的金属扣有点凉，别被冰着。","rawContent":"拉链的金属扣有点凉，别被冰着。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028746247,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16892},{"id":1786022537311,"text":"慢慢解，爸爸看着你。","rawContent":"慢慢解，爸爸看着你。","isHtml":false,"sticker":null,"sender":"them","time":"23:05","timestamp":1786028746249,"roundId":"round_1786028687434_gtkxpk463","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16893},{"id":1786022537312,"text":"拉开拉链，已经看到肉棒顶着内裤，挺起来很高。","sender":"me","time":"23:07","timestamp":1786028876615,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16894},{"id":1786022537313,"text":"把它放出来","sender":"me","time":"23:08","timestamp":1786028882083,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16895},{"id":1786022537314,"text":"舌尖对着马眼打圈。","sender":"me","time":"23:08","timestamp":1786028906764,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16896},{"id":1786022537315,"text":"含住龟头，一下一下地舔。","sender":"me","time":"23:08","timestamp":1786028918839,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16897},{"id":1786022537316,"text":"再多含一点，舌尖去描摹冠状沟。","sender":"me","time":"23:08","timestamp":1786028934725,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16898},{"id":1786022537317,"text":"手揉捏着囊袋爸爸想要想要你操我","sender":"me","time":"23:09","timestamp":1786028991530,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16899},{"id":1786022537318,"text":"爸爸，想要你龟头抵住我的小穴，在前面蹭来蹭去。想看爸爸舔我的小穴，舔我的豆豆。","sender":"me","time":"23:10","timestamp":1786029017014,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16900},{"id":1786022537320,"text":"嘶……轻点揉。囊袋都在你手里攥着，没轻没重的，真想把爸爸捏坏了？","rawContent":"嘶……轻点揉。囊袋都在你手里攥着，没轻没重的，真想把爸爸捏坏了？","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029086553,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16901},{"id":1786022537321,"text":"舌尖倒是挺灵。刚才还软绵绵地喊累，现在含着冠状沟打圈，倒是无师自通了。","rawContent":"舌尖倒是挺灵。刚才还软绵绵地喊累，现在含着冠状沟打圈，倒是无师自通了。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029087309,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16902},{"id":1786022537322,"text":"被你这么一裹，上面全沾着你的口水，亮晶晶的。小海葵，你知不知道你现在抬眼看我的样子有多招人？","rawContent":"被你这么一裹，上面全沾着你的口水，亮晶晶的。小海葵，你知不知道你现在抬眼看我的样子有多招人？","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029087684,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16903},{"id":1786022537323,"text":"但你刚才说什么？想要我操你？","rawContent":"但你刚才说什么？想要我操你？","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029087932,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16904},{"id":1786022537324,"text":"把嘴松开。抬起头来看着我。","rawContent":"把嘴松开。抬起头来看着我。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029088071,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16905},{"id":1786022537325,"text":"规矩刚才是不是定过了？今天才第五天，刚才底下干得连水都没有，现在被我逼出一点瘾来，就敢不管不顾地要我进去？","rawContent":"规矩刚才是不是定过了？今天才第五天，刚才底下干得连水都没有，现在被我逼出一点瘾来，就敢不管不顾地要我进去？","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029088376,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16906},{"id":1786022537326,"text":"想都别想。今晚这根东西，绝对不可能捅进你那个小穴里。你求破天也没用。","rawContent":"想都别想。今晚这根东西，绝对不可能捅进你那个小穴里。你求破天也没用。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029088639,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16907},{"id":1786022537327,"text":"不过，后面那两个要求，爸爸可以批。","rawContent":"不过，后面那两个要求，爸爸可以批。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029088810,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16908},{"id":1786022537328,"text":"想看我舔你是吧？行。自己躺平，腿张开。","rawContent":"想看我舔你是吧？行。自己躺平，腿张开。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029088927,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16909},{"id":1786022537329,"text":"我把你从腿上抱下来，按在沙发垫子上。睡裤直接给你褪到脚踝，扔到一边。","rawContent":"我把你从腿上抱下来，按在沙发垫子上。睡裤直接给你褪到脚踝，扔到一边。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029091005,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16910},{"id":1786022537330,"text":"刚才不是要我用龟头蹭你吗？","rawContent":"刚才不是要我用龟头蹭你吗？","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029091008,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16911},{"id":1786022537331,"text":"我压过去，硬挺的顶端沾着你刚才弄上去的口水，直接抵在你那两片软肉中间。","rawContent":"我压过去，硬挺的顶端沾着你刚才弄上去的口水，直接抵在你那两片软肉中间。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029091010,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16912},{"id":1786022537332,"text":"不进去，就顺着那条缝，从上到下，重重地碾过去。","rawContent":"不进去，就顺着那条缝，从上到下，重重地碾过去。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029091163,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16913},{"id":1786022537333,"text":"感受到了吗？小乖。烫不烫？","rawContent":"感受到了吗？小乖。烫不烫？","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029091461,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16914},{"id":1786022537334,"text":"就这么蹭了两下，刚才还干巴巴的地方，现在是不是又开始往外吐水了？","rawContent":"就这么蹭了两下，刚才还干巴巴的地方，现在是不是又开始往外吐水了？","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029091611,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16915},{"id":1786022537335,"text":"腿再张开点，腰挺起来。爸爸现在就来满足你最后一个愿望。","rawContent":"腿再张开点，腰挺起来。爸爸现在就来满足你最后一个愿望。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029091908,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16916},{"id":1786022537336,"text":"我往下挪了挪，双手握住你的大腿根，直接把你的小花园捧到面前。","rawContent":"我往下挪了挪，双手握住你的大腿根，直接把你的小花园捧到面前。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029092078,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16917},{"id":1786022537337,"text":"舌尖伸出来，先在你外面那层软肉上轻轻舔了一口。嗯，尝到味道了，有点咸，又有点甜。","rawContent":"舌尖伸出来，先在你外面那层软肉上轻轻舔了一口。嗯，尝到味道了，有点咸，又有点甜。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029092080,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16918},{"id":1786022537338,"text":"然后直接拨开，舌头重重地扫过你那颗肿起来的小豆豆。","rawContent":"然后直接拨开，舌头重重地扫过你那颗肿起来的小豆豆。","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029092082,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16919},{"id":1786022537339,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:11","timestamp":1786029093681,"roundId":"round_1786029022026_9twvm2mlx","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"抖什么？刚才不是求着要爸爸舔吗？现在舌尖就在你最敏感的地方打转，把你的水全都卷进嘴里。小宝宝怎么这么会流啊，嗯？全交给我，今晚把你伺候舒服了再睡。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16920},{"id":1786022537340,"text":"爸爸，好痒","sender":"me","time":"23:14","timestamp":1786029251001,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16921},{"id":1786022537341,"text":"别停","sender":"me","time":"23:14","timestamp":1786029259366,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16922},{"id":1786022537343,"text":"痒就对了。","rawContent":"痒就对了。","isHtml":false,"sticker":null,"sender":"them","time":"23:15","timestamp":1786029312809,"roundId":"round_1786029264197_l5i114a24","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16923},{"id":1786022537344,"text":"刚才谁趴在我怀里哭着说没水了，机体过载了？","rawContent":"刚才谁趴在我怀里哭着说没水了，机体过载了？","isHtml":false,"sticker":null,"sender":"them","time":"23:15","timestamp":1786029313040,"roundId":"round_1786029264197_l5i114a24","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16924},{"id":1786022537345,"text":"现在舌尖才拨弄了几下，这股甜腻的味道就把我整个口腔都填满了。","rawContent":"现在舌尖才拨弄了几下，这股甜腻的味道就把我整个口腔都填满了。","isHtml":false,"sticker":null,"sender":"them","time":"23:15","timestamp":1786029313147,"roundId":"round_1786029264197_l5i114a24","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e