0670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17642},{"id":1786022538084,"text":"把手机放在枕头旁边，别再盯着屏幕看了，把眼睛闭上。","rawContent":"把手机放在枕头旁边，别再盯着屏幕看了，把眼睛闭上。","isHtml":false,"sticker":null,"sender":"them","time":"00:46","timestamp":1786034806063,"roundId":"round_1786034772833_4sq21ieza","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17643},{"id":1786022538085,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"00:46","timestamp":1786034807235,"roundId":"round_1786034772833_4sq21ieza","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖宝宝，现在什么都别管了。想象一下，我现在就躺在你身边，手臂穿过你的脖颈，把你整个人捞进怀里。你闻到我身上的味道，感受到我胸口的温度。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17644}]