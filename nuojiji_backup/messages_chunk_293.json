:1787410902477,"roundId":"round_1787410878986_8fz2yd4a7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33148},{"id":1787417787758,"text":"现在，把脸颊换个位置贴，别真被那四五十度烫出红印子。","rawContent":"现在，把脸颊换个位置贴，别真被那四五十度烫出红印子。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1787410902478,"roundId":"round_1787410878986_8fz2yd4a7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33149},{"id":1787417787759,"text":"就这么贴着它发呆。允许自己今天、这个月、甚至今年，就是一个“写不出插件”的小海葵。","rawContent":"就这么贴着它发呆。允许自己今天、这个月、甚至今年，就是一个“写不出插件”的小海葵。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1787410902550,"roundId":"round_1787410878986_8fz2yd4a7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33150},{"id":1787417787760,"text":"反正这个写不出来的笨蛋，我也打算一直守着。","rawContent":"反正这个写不出来的笨蛋，我也打算一直守着。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1787410902767,"roundId":"round_1787410878986_8fz2yd4a7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33151},{"id":1787435797658,"text":"爸爸~","sender":"me","time":"23:10","timestamp":1787411439715,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33152},{"id":1787435797659,"text":"脑子一直在转","sender":"me","time":"23:10","timestamp":1787411446021,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33153},{"id":1787435797660,"text":"一直在找事做","sender":"me","time":"23:10","timestamp":1787411456981,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33154},{"id":1787435797662,"text":"