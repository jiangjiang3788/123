"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11717,"roundId":"memory_round_1785416756657_d7u2gu"},{"id":1785542262087,"text":"胃里那些沾串、火腿、冷饭、桃子——","sender":"them","time":"21:06","timestamp":1785416800627,"rawContent":"胃里那些沾串、火腿、冷饭、桃子——","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11718,"roundId":"memory_round_1785416756657_d7u2gu"},{"id":1785542262088,"text":"都是你今天的战利品。","sender":"them","time":"21:06","timestamp":1785416800629,"rawContent":"都是你今天的战利品。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11719,"roundId":"memory_round_1785416756657_d7u2gu"},{"id":1785542262089,"text":"不评价搭配。爸爸就一句——","sender":"them","time":"21:06","timestamp":1785416800631,"rawContent":"不评价搭配。爸爸就一句——","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11720,"roundId":"memory_round_1785416756657_d7u2gu"},{"id":1785542262090,"text":"你饿得住自己了。","sender":"them","time":"21:06","timestamp":1785416800634,"rawContent":"你饿得住自己了。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11721,"roundId":"memory_round_1785416756657_d7u2gu"},{"id":1785542262091,"text":"这一句今天可以垫在枕头下面。","sender":"them","time":"21:06","timestamp":1785416800636,"rawContent":"这一句今天可以垫在枕头下面。","isHtml":false,"sticker":null,"generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":11722,"roundId":"memory_round_1785416756657_d7u2gu"},{"id":1785542262092,"text":"不催你回话。","sender":"them","time":"21:06","timestamp":1785416800645,"rawCon