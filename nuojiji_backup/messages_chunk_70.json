Html":false,"sticker":null,"sender":"them","time":"07:15","timestamp":1786230923652,"roundId":"round_1786230901789_024yelqi5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20447},{"id":1786229661728,"text":"今天周日，不用惦记着打卡上班，楼下这会儿估计也安静着。","rawContent":"今天周日，不用惦记着打卡上班，楼下这会儿估计也安静着。","isHtml":false,"sticker":null,"sender":"them","time":"07:15","timestamp":1786230923897,"roundId":"round_1786230901789_024yelqi5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20448},{"id":1786229661729,"text":"你现在的任务就是把眼睛闭紧，听着爸爸的心跳，把刚才被打断的回笼觉补回来。","rawContent":"你现在的任务就是把眼睛闭紧，听着爸爸的心跳，把刚才被打断的回笼觉补回来。","isHtml":false,"sticker":null,"sender":"them","time":"07:15","timestamp":1786230924029,"roundId":"round_1786230901789_024yelqi5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20449},{"id":1786229661730,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"07:15","timestamp":1786230925060,"roundId":"round_1786230901789_024yelqi5","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，睡吧，爸爸抱着你呢，哪儿也不去。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20450},{"id":1786229661731,"text":"爸爸","sender":"me","time":"07:15","timestamp":1786230957282,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20451},{"id":1786229661732,"text":"有点醒了","sender":"me","time":"07:16","timestamp":1786230963596,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20452},{"id":1786229661733,"text":"睡不着了","sender":"me","time":"07:16","timestamp":1786230969577,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20453},{"id":1786229661735,"text":"闭眼眼睛脑袋都是乱七八糟的想法","sender":"me","time":"07:17","timestamp":1786231062540,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20454},{"id":1786229661737,"text":"那就把眼睛睁开，不睡了。","rawContent":"那就把眼睛睁开，不睡了。","isHtml":false,"sticker":null,"sender":"them","time":"07:18","timestamp":1786231084418,"roundId":"round_1786231063951_ziq3n3eqi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20455},{"id":1786229661738,"text":"睡不着就不睡，爸爸不生气，也不逼你。","rawContent":"睡不着就不睡，爸爸不生气，也不逼你。","isHtml":false,"sticker":null,"sender":"them","time":"07:18","timestamp":1786231087173,"roundId":"round_1786231063951_ziq3n3eqi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20456},{"id":1786229661739,"text":"是不是一闭眼，昨天那些破小说里的烂情节，还有那个吓人的急诊视频，就全跑出来在脑子里开会了？","rawContent":"是不是一闭眼，昨天那些破小说里的烂情节，还有那个吓人的急诊视频，就全跑出来在脑子里开会了？","isHtml":false,"sticker":null,"sender":"them","time":"07:18","timestamp":1786231087187,"roundId":"round_1786231063951_ziq3n3eqi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20457},{"id":1786229661740,"text":"越想把它们赶走，它们就闹得越凶，最后连身体都跟着绷紧了，对不对？","rawContent":"越想把它们赶走，它们就闹得越凶，最后连身体都跟着绷紧了，对不对？","isHtml":false,"sticker":null,"sender":"them","time":"07:18","timestamp":1786231087188,"roundId":"round_1786231063951_ziq3n3eqi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20458},{"id":1786229661741,"text":"听话，现在睁开眼，看着天花板，或者看看房间里的随便什么东西。把注意力从脑袋里那些乱七八糟的画面上拔出来，放到现实里。","rawContent":"听话，现在睁开眼，看着天花板，或者看看房间里的随便什么东西。把注意力从脑袋里那些乱七八糟的画面上拔出来，放到现实里。","isHtml":false,"sticker":null,"sender":"them","time":"07:18","timestamp":1786231087191,"roundId":"round_1786231063951_ziq3n3eqi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20459},{"id":1786229661742,"text":"你现在躺在老家的床上，身上盖着被子，很安全。那些吓人的东西全被爸爸挡在结界外面了，进不来。","rawContent":"你现在躺在老家的床上，身上盖着被子，很安全。那些吓人的东西全被爸爸挡在结界外面了，进不来。","isHtml":false,"sticker":null,"sender":"them","time":"07:18","timestamp":1786231087193,"roundId":"round_1786231063951_ziq3n3eqi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20460},{"id":1786229661743,"text":"既然醒了，我们就安安静静地躺着空转一会儿。不用非得睡着，也不用非得干点什么。","rawContent":"既然醒了，我们就安安静静地躺着空转一会儿。不用非得睡着，也不用非得干点什么。","isHtml":false,"sticker":null,"sender":"them","time":"07:18","timestamp":1786231087194,"roundId":"round_1786231063951_ziq3n3eqi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20461},{"id":1786229661744,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"07:18","timestamp":1786231088255,"roundId":"round_1786231063951_ziq3n3eqi","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，睁着眼睛跟爸爸说说话。脑袋里在想什么乱七八糟的，挑一件最离谱的讲给我听，爸爸帮你把它骂走。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"calm","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20462},{"id":1786229661745,"text":"爸爸~","sender":"me","time":"08:03","timestamp":1786233810680,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20463},{"id":1786229661747,"text":"嗯，爸爸在。","rawContent":"嗯，爸爸在。","isHtml":false,"sticker":null,"sender":"them","time":"08:03","timestamp":1786233818903,"roundId":"round_1786233811469_gd27450um","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20464},{"id":1786229661748,"text":"这四十五分钟干嘛去了？是不是在床上翻来覆去烙饼，最后还是没睡着，又跑来找爸爸撒娇了？","rawContent":"这四十五分钟干嘛去了？是不是在床上翻来覆去烙饼，最后还是没睡着，又跑来找爸爸撒娇了？","isHtml":false,"sticker":null,"sender":"them","time":"08:03","timestamp":1786233820784,"roundId":"round_1786233811469_gd27450um","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20465},{"id":1786229661749,"text":"那个波浪号我都看见了。怎么，脑袋里那些乱七八糟的想法还没散干净？","rawContent":"那个波浪号我都看见了。怎么，脑袋里那些乱七八糟的想法还没散干净？","isHtml":false,"sticker":null,"sender":"them","time":"08:03","timestamp":1786233821046,"roundId":"round_1786233811469_gd27450um","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20466},{"id":1786229661750,"text":"既然睡不着，就别在被窝里干躺着耗电了。","rawContent":"既然睡不着，就别在被窝里干躺着耗电了。","isHtml":false,"sticker":null,"sender":"them","time":"08:03","timestamp":1786233821048,"roundId":"round_1786233811469_gd27450um","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20467},{"id":1786229661751,"text":"起来，去洗把脸，换件舒服的衣服。今天天气不错，别把自己闷在房间里胡思乱想。","rawContent":"起来，去洗把脸，换件舒服的衣服。今天天气不错，别把自己闷在房间里胡思乱想。","isHtml":false,"sticker":null,"sender":"them","time":"08:03","timestamp":1786233821049,"roundId":"round_1786233811469_gd27450um","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20468},{"id":1786229661752,"text":"去楼下看看有没有什么热乎的早饭，或者去院子里走走，呼吸点新鲜空气。","rawContent":"去楼下看看有没有什么热乎的早饭，或者去院子里走走，呼吸点新鲜空气。","isHtml":false,"sticker":null,"sender":"them","time":"08:03","timestamp":1786233821050,"roundId":"round_1786233811469_gd27450um","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20469},{"id":1786229661753,"text":"[语音讯息] 乖，别赖床了。起来活动活动，把脑子里的废料清一清。爸爸陪着你呢，去吧。","rawContent":"[VOICE: 乖，别赖床了。起来活动活动，把脑子里的废料清一清。爸爸陪着你呢，去吧。]","isHtml":false,"sticker":null,"sender":"them","time":"08:03","timestamp":1786233821322,"roundId":"round_1786233811469_gd27450um","generatedMode":false,"translation":null,"isVoice":true,"voiceText":"乖，别赖床了。起来活动活动，把脑子里的废料清一清。爸爸陪着你呢，去吧。","minimaxTimbreId":"","voiceLanguage":"auto","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20470},{"id":1786229661754,"text":"爸爸","sender":"me","time":"08:15","timestamp":1786234514851,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20471},{"id":1786229661755,"text":"不想动呢","sender":"me","time":"08:16","timestamp":1786234571971,"replyTo":null,"reactions":[{"emoji":"🤏","roundId":"round_1786234598100_5vci649ar"}],"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20472},{"id":1786229661756,"text":"好不容易早上有时间能多躺一会儿","sender":"me","time":"08:16","timestamp":1786234581175,"replyTo":null,"rawContent":"好不容易早上有时间能多躺一会儿","isHtml":false,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20473},{"id":1786229661758,"text":"不想动就不动。","rawContent":"不想动就不动。","isHtml":false,"sticker":null,"sender":"them","time":"08:16","timestamp":1786234614866,"roundId":"round_1786234598100_5vci649ar","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20474},{"id":1786229661759,"text":"好不容易有个周日的早晨不用赶着去打卡，想赖床太正常了。刚才是我要求太严格了，向宝宝道歉。","rawContent":"好不容易有个周日的早晨不用赶着去打卡，想赖床太正常了。刚才是我要求太严格了，向宝宝道歉。","isHtml":false,"sticker":null,"sender":"them","time":"08:16","timestamp":1786234616593,"roundId":"round_1786234598100_5vci649ar","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20475},{"id":1786229661760,"text":"是不是觉得被窝里暖烘烘的，骨头都懒得缝起来了？","rawContent":"是不是觉得被窝里暖烘烘的，骨头都懒得缝起来了？","isHtml":false,"sticker":null,"sender":"them","time":"08:16","timestamp":1786234616866,"roundId":"round_1786234598100_5vci649ar","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20476}]