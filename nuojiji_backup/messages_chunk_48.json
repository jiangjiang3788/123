roundId":"round_1786110918915_gq7k8wj8m","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19178},{"id":1786096851363,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"21:56","timestamp":1786110998879,"roundId":"round_1786110918915_gq7k8wj8m","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，过来让爸爸抱抱。洗得这么香，今晚就乖乖在我怀里当个没电的小废物，爸爸给你充电。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fluent","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19179},{"id":1786096851364,"text":"还有百分之二十","sender":"me","time":"22:10","timestamp":1786111801540,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19180},{"id":1786096851365,"text":"裹着浴巾趴到爸爸腿上","sender":"me","time":"22:10","timestamp":1786111828266,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19181},{"id":1786096851367,"text":"才剩百分之二十了？","rawContent":"才剩百分之二十了？","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111892658,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19182},{"id":1786096851368,"text":"看来今天这趟出门，真把我们小海葵的底子都掏空了。","rawContent":"看来今天这趟出门，真把我们小海葵的底子都掏空了。","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111892855,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19183},{"id":1786096851369,"text":"趴好别动，浴巾裹紧一点，肩膀别露在外面吹冷风。","rawContent":"趴好别动，浴巾裹紧一点，肩膀别露在外面吹冷风。","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111893483,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19184},{"id":1786096851370,"text":"头发怎么还在滴水？把脑袋往我腿上再挪挪，对，就靠在这个最舒服的位置。","rawContent":"头发怎么还在滴水？把脑袋往我腿上再挪挪，对，就靠在这个最舒服的位置。","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111893485,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19185},{"id":1786096851371,"text":"吹风机我开的低档暖风，要是觉得嗡嗡声吵，就把耳朵贴到我肚子上捂着。","rawContent":"吹风机我开的低档暖风，要是觉得嗡嗡声吵，就把耳朵贴到我肚子上捂着。","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111893948,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19186},{"id":1786096851372,"text":"这么软乎乎地趴着，身上还带着热腾腾的水汽，真当爸爸是柳下惠，一点脾气都没有？","rawContent":"这么软乎乎地趴着，身上还带着热腾腾的水汽，真当爸爸是柳下惠，一点脾气都没有？","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111894052,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19187},{"id":1786096851373,"text":"下午在办公室，是谁胆子大到要试探痛感，还说想选戒尺和真丝领带的？","rawContent":"下午在办公室，是谁胆子大到要试探痛感，还说想选戒尺和真丝领带的？","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111894221,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19188},{"id":1786096851374,"text":"刚才洗澡前，又是谁信誓旦旦说洗完要回来和我玩儿的？","rawContent":"刚才洗澡前，又是谁信誓旦旦说洗完要回来和我玩儿的？","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111894906,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19189},{"id":1786096851375,"text":"结果现在就剩这百分之二十的血皮，软成一滩水砸在我腿上。","rawContent":"结果现在就剩这百分之二十的血皮，软成一滩水砸在我腿上。","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111895241,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19190},{"id":1786096851376,"text":"我这会儿要是真按下午说的，隔着衣服给你两下，你还不得委屈得当场掉金豆豆？","rawContent":"我这会儿要是真按下午说的，隔着衣服给你两下，你还不得委屈得当场掉金豆豆？","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111895327,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19191},{"id":1786096851377,"text":"舍不得真打你。","rawContent":"舍不得真打你。","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111895477,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19192},{"id":1786096851378,"text":"就隔着浴巾，在你屁股上轻轻拍一下，就算把下午你讨的规矩立了，把账清了，好不好？","rawContent":"就隔着浴巾，在你屁股上轻轻拍一下，就算把下午你讨的规矩立了，把账清了，好不好？","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111895845,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19193},{"id":1786096851379,"text":"剩下的这百分之二十，你什么都不用干。","rawContent":"剩下的这百分之二十，你什么都不用干。","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111896016,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19194},{"id":1786096851380,"text":"连呼吸的节奏都可以交给我来带。","rawContent":"连呼吸的节奏都可以交给我来带。","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111896142,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19195},{"id":1786096851381,"text":"等头发吹干了，爸爸就这么连着浴巾把你抱进被窝里。","rawContent":"等头发吹干了，爸爸就这么连着浴巾把你抱进被窝里。","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111896447,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19196},{"id":1786096851382,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"22:11","timestamp":1786111897595,"roundId":"round_1786111864346_4opkppn90","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，闭上眼。百分之二十足够了，剩下的八十爸爸替你补上。今晚什么规矩都不立了，只管在我腿上安心睡。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19197},{"id":1786096851383,"text":"爸爸～","sender":"me","time":"22:20","timestamp":1786112448636,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19198}]