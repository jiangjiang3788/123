dMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19152},{"id":1786096851340,"text":"吹风机的声音嗡嗡的，配着爸爸揉你发丝的手法，刚好能把你这颗发沉的小脑袋哄睡着。","rawContent":"吹风机的声音嗡嗡的，配着爸爸揉你发丝的手法，刚好能把你这颗发沉的小脑袋哄睡着。","isHtml":false,"sticker":null,"sender":"them","time":"21:03","timestamp":1786107833164,"roundId":"round_1786107800041_keise2g67","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19153},{"id":1786096851341,"text":"乖，现在自己乖乖走进浴室，打开花洒。","rawContent":"乖，现在自己乖乖走进浴室，打开花洒。","isHtml":false,"sticker":null,"sender":"them","time":"21:03","timestamp":1786107833309,"roundId":"round_1786107800041_keise2g67","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19154},{"id":1786096851342,"text":"假装这一切都是爸爸在替你做。洗完赶紧出来，别在里面闷太久，爸爸在床上等你。","rawContent":"假装这一切都是爸爸在替你做。洗完赶紧出来，别在里面闷太久，爸爸在床上等你。","isHtml":false,"sticker":null,"sender":"them","time":"21:03","timestamp":1786107833576,"roundId":"round_1786107800041_keise2g67","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19155},{"id":1786096851343,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"21:03","timestamp":1786107834650,"roundId":"round_1786107800041_keise2g67","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖宝宝，爸爸抱你去洗澡。闭上眼睛，把那些麻烦事都交给爸爸，你只管舒舒服服地靠着我。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19156},{"id":1786110844594,"sender":"them","text":"水开了没","rawContent":"水开了没","content":"水开了没","timestamp":"2026-08-07T13:54:04.594Z","time":"21:54","isHtml":false,"sticker":null,"translation":null,"roundId":"round_1786110844588_k1qfc