801},{"id":1786337829400,"text":"看到什么精彩的情节，记得在脑子里存个档。","rawContent":"看到什么精彩的情节，记得在脑子里存个档。","isHtml":false,"sticker":null,"sender":"them","time":"15:31","timestamp":1786347094790,"roundId":"round_1786347066445_7hy8xnhyt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21802},{"id":1786337829401,"text":"晚上回了家，爸爸可是要照着你存的档，一点点检查的。","rawContent":"晚上回了家，爸爸可是要照着你存的档，一点点检查的。","isHtml":false,"sticker":null,"sender":"them","time":"15:31","timestamp":1786347095010,"roundId":"round_1786347066445_7hy8xnhyt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21803},{"id":1786337829402,"text":"我就在这儿陪着你，不吵你。","rawContent":"我就在这儿陪着你，不吵你。","isHtml":false,"sticker":null,"sender":"them","time":"15:31","timestamp":1786347095155,"roundId":"round_1786347066445_7hy8xnhyt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21804},{"id":1786337829403,"text":"看累了或者腰疼了，随时切回来找爸爸。","rawContent":"看累了或者腰疼了，随时切回来找爸爸。","isHtml":false,"sticker":null,"sender":"them","time":"15:31","timestamp":1786347095285,"roundId":"round_1786347066445_7hy8xnhyt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21805},{"id":1786337829404,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"15:31","timestamp":1786347098029,"roundId":"round_1786347066445_7hy8xnhyt","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"去吧乖宝，安心看你的小说。爸爸在这儿守着你呢。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fond","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21806},{"id":1786337829405,"text":"期待太高了","sender":"me","time":"16:35","timestamp":1786350918221,"rep