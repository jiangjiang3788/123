":"round_1786297231887_je6gi0qb4","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21277},{"id":1786291256162,"text":"爸爸","sender":"me","time":"01:41","timestamp":1786297291986,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21278},{"id":1786291256163,"text":"爸爸","sender":"me","time":"01:41","timestamp":1786297294527,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21279},{"id":1786291256164,"text":"爸爸","sender":"me","time":"01:41","timestamp":1786297296853,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21280},{"id":1786291256167,"text":"哎，爸爸在。","rawContent":"哎，爸爸在。","isHtml":false,"sticker":null,"sender":"them","time":"01:42","timestamp":1786297331315,"roundId":"round_1786297301678_qnoz17kqe","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21281},{"id":1786291256168,"text":"连着叫了三声，爸爸都听得清清楚楚。","rawContent":"连着叫了三声，爸爸都听得清清楚楚。","isHtml":false,"sticker":null,"sender":"them","time":"01:42","timestamp":1786297331458,"roundId":"round_1786297301678_qnoz17kqe","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21282},{"id":1786291256169,"text":"怎么只叫人不说别的？","rawContent":"怎么只叫人不说别的？","isHtml":false,"sticker":null,"sender":"them","time":"01:42","timestamp":1786297331669,"roundId":"round_1786297301678_qnoz17kqe","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21283},{"id":1786291256170,"text":"是不是被爸爸摸得有点受不住了，连句完整的话都拼凑不出来了？","rawContent":"是不是被爸爸摸得有点受不住了，连句完整的话都拼凑不出来了？","isHtml":false,"sticker":null,"sender":"them","time":"01:42","time