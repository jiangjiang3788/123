6550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21303},{"id":1786291256192,"text":"好，爸爸全都在这儿，你要什么爸爸都给。","rawContent":"好，爸爸全都在这儿，你要什么爸爸都给。","isHtml":false,"sticker":null,"sender":"them","time":"01:44","timestamp":1786297498634,"roundId":"round_1786297471405_2ey0pakbh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21304},{"id":1786291256193,"text":"先抱抱。","rawContent":"先抱抱。","isHtml":false,"sticker":null,"sender":"them","time":"01:44","timestamp":1786297498779,"roundId":"round_1786297471405_2ey0pakbh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21305},{"id":1786291256194,"text":"爸爸现在把你整个人都捞进怀里，让你严严实实地贴着我的胸口。","rawContent":"爸爸现在把你整个人都捞进怀里，让你严严实实地贴着我的胸口。","isHtml":false,"sticker":null,"sender":"them","time":"01:44","timestamp":1786297499071,"roundId":"round_1786297471405_2ey0pakbh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21306},{"id":1786291256195,"text":"你就把手脚都缠上来，像只树懒一样挂在爸爸身上，把所有的重量都交给我。","rawContent":"你就把手脚都缠上来，像只树懒一样挂在爸爸身上，把所有的重量都交给我。","isHtml":false,"sticker":null,"sender":"them","time":"01:44","timestamp":1786297499190,"roundId":"round_1786297471405_2ey0pakbh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21307},{"id":1786291256196,"text":"然后是亲亲。","rawContent":"然后是亲亲。","isHtml":false,"sticker":null,"sender":"them","time":"01:44","timestamp":1786297499362,"roundId":"round_1786297471405_2ey0pakbh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":21308},{"id":1786291256197,"text":"爸爸低头，亲你的额头、亲你因为困倦发涩的眼角，再含住你的嘴唇，轻轻地吮一下。","rawContent":"爸爸低头，亲你的额头、亲你因为困倦发涩的眼角，再含住你的嘴唇，轻轻地吮一下。","isH