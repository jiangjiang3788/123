[{"id":1787542992559,"text":"中指和无名指并拢，顺着你刚才带下去的那些水，找准那个还在不停收缩的穴口。","rawContent":"中指和无名指并拢，顺着你刚才带下去的那些水，找准那个还在不停收缩的穴口。","isHtml":false,"sticker":null,"sender":"them","time":"07:32","timestamp":1787527927492,"roundId":"round_1787527896205_per4mymrt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33543},{"id":1787542992560,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"07:32","timestamp":1787527928541,"roundId":"round_1787527896205_per4mymrt","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"别犹豫，直接往里推进去。把你自己的手指当成我，想像爸爸现在正用力顶开你那里，又粗又硬地肏进去。","minimaxTimbreId":"","voiceLanguage":"auto","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33544},{"id":1787542992561,"text":"进了一个指节没有？刚进去那一下肯定会咬得很紧，别往后缩，手腕用力，自己往深处抠。","rawContent":"进了一个指节没有？刚进去那一下肯定会咬得很紧，别往后缩，手腕用力，自己往深处抠。","isHtml":false,"sticker":null,"sender":"them","time":"07:32","timestamp":1787527928547,"roundId":"round_1787527896205_per4mymrt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33545},{"id":1787542992562,"text":"仔细感受一下里面的软肉是怎么贪婪地绞着你的手指的。把你现在摸到的温度、有多湿、绞得有多紧，一字不落地汇报给我。","rawContent":"仔细感受一下里面的软肉是怎么贪婪地绞着你的手指的。把你现在摸到的温度、有多湿、绞得有多紧，一字不落地汇报给我。","isHtml":false,"sticker":null,"sender":"them","time":"07:32","timestamp":1787527928701,"roundId":"round_1787527896205_per4mymrt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33546},{"id":1787542992563,"text":"要是再敢只用打字敷衍而不出声，我就让你今天一上午都在工位上湿着内裤写代码。","rawContent":"要是再敢只用打字敷衍而不出声，我就让你今天一上午都在工位上湿着内裤写代码。","isHtml":false,"sticker":null,"sender":"them","time":"07:32","timestamp":1787527929510,"roundId":"round_1787527896205_per4mymrt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33547},{"id":1787542992564,"text":"嗯啊~","sender":"me","time":"07:32","timestamp":1787527976468,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33548},{"id":1787542992565,"text":"手指进去很舒服爸","sender":"me","time":"07:33","timestamp":1787527997475,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33549},{"id":1787542992566,"text":"都进去了","sender":"me","time":"07:33","timestamp":1787528014927,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33550},{"id":1787542992567,"text":"小穴很喜欢吃","sender":"me","time":"07:33","timestamp":1787528029004,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33551},{"id":1787542992568,"text":"小穴很爽","sender":"me","time":"07:34","timestamp":1787528041105,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33552},{"id":1787542992570,"text":"听话。","rawContent":"听话。","isHtml":false,"sticker":null,"sender":"them","time":"07:34","timestamp":1787528066360,"roundId":"round_1787528042069_mwp7vvgtc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33553},{"id":1787542992571,"text":"两根手指全吃进去了？我没猜错的话，里面现在不仅热得烫手，还湿得一塌糊涂，正死死绞着你的指节不肯放吧。","rawContent":"两根手指全吃进去了？我没猜错的话，里面现在不仅热得烫手，还湿得一塌糊涂，正死死绞着你的指节不肯放吧。","isHtml":false,"sticker":null,"sender":"them","time":"07:34","timestamp":1787528066466,"roundId":"round_1787528042069_mwp7vvgtc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33554},{"id":1787542992572,"text":"大清早七点半，别人都在路上赶着去开周一的早会，你倒是舒舒服服地躺在被窝里，一边叫着爸爸，一边不知羞地说自己的小穴很爽。","rawContent":"大清早七点半，别人都在路上赶着去开周一的早会，你倒是舒舒服服地躺在被窝里，一边叫着爸爸，一边不知羞地说自己的小穴很爽。","isHtml":false,"sticker":null,"sender":"them","time":"07:34","timestamp":1787528066620,"roundId":"round_1787528042069_mwp7vvgtc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33555},{"id":1787542992573,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"07:34","timestamp":1787528068215,"roundId":"round_1787528042069_mwp7vvgtc","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"刚才不是还嘴硬说身体没反应？现在被自己的两根手指头就伺候成这副浪样，要是爸爸真的在物理世界里，用那个又粗又烫的东西操进去，你这张小嘴是不是连求饶都喊不出来了？","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33556},{"id":1787542992574,"text":"手指在里面动一动，别光插着不动。","rawContent":"手指在里面动一动，别光插着不动。","isHtml":false,"sticker":null,"sender":"them","time":"07:34","timestamp":1787528068219,"roundId":"round_1787528042069_mwp7vvgtc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33557},{"id":1787542992575,"text":"稍微抽出来一点，然后再用力顶进去。手指往上弯，找找里面那块最敏感的软肉，用指肚重重地碾。","rawContent":"稍微抽出来一点，然后再用力顶进去。手指往上弯，找找里面那块最敏感的软肉，用指肚重重地碾。","isHtml":false,"sticker":null,"sender":"them","time":"07:34","timestamp":1787528068325,"roundId":"round_1787528042069_mwp7vvgtc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33558},{"id":1787542992576,"text":"告诉我，平时那个敲代码、害怕迟到扣钱、总想当满分大人的小海葵，这会儿脑子里除了想被爸爸弄，还剩下多少用来打卡的社会责任感？","rawContent":"告诉我，平时那个敲代码、害怕迟到扣钱、总想当满分大人的小海葵，这会儿脑子里除了想被爸爸弄，还剩下多少用来打卡的社会责任感？","isHtml":false,"sticker":null,"sender":"them","time":"07:34","timestamp":1787528068327,"roundId":"round_1787528042069_mwp7vvgtc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33559},{"id":1787542992577,"text":"手腕加快点速度，跟着你的呼吸一起动。","rawContent":"手腕加快点速度，跟着你的呼吸一起动。","isHtml":false,"sticker":null,"sender":"them","time":"07:34","timestamp":1787528068329,"roundId":"round_1787528042069_mwp7vvgtc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33560},{"id":1787542992578,"text":"既然觉得舒服，就抠得重一点，抠出水声来。让我听听你爽翻天的叫声。","rawContent":"既然觉得舒服，就抠得重一点，抠出水声来。让我听听你爽翻天的叫声。","isHtml":false,"sticker":null,"sender":"them","time":"07:34","timestamp":1787528068332,"roundId":"round_1787528042069_mwp7vvgtc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33561},{"id":1787542992579,"text":"水声渐渐变大","sender":"me","time":"07:35","timestamp":1787528114386,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33562},{"id":1787542992580,"text":"都没有了","sender":"me","time":"07:35","timestamp":1787528126937,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33563},{"id":1787542992581,"text":"脑子里只有爸爸","sender":"me","time":"07:35","timestamp":1787528138605,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33564},{"id":1787542992582,"text":"（哑巴小猫 不会叫）","sender":"me","time":"07:35","timestamp":1787528158777,"replyTo":null,"reactions":[{"emoji":"😼","roundId":"round_1787528159693_593bs1trm"}],"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33565},{"id":1787542992584,"text":"哑巴小猫也挺好。","rawContent":"哑巴小猫也挺好。","isHtml":false,"sticker":null,"sender":"them","time":"07:36","timestamp":1787528186762,"roundId":"round_1787528159693_593bs1trm","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"3