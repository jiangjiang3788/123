","time":"00:25","timestamp":1787070344067,"roundId":"round_1787070321383_94p614ije","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31157},{"id":1787056975208,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"00:25","timestamp":1787070347589,"roundId":"round_1787070321383_94p614ije","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"闭着眼睛歇会儿，爸爸抱你过去。我就在门边守着，哪都不去。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31158},{"id":1787056975209,"text":"好了爸爸","sender":"me","time":"00:26","timestamp":1787070370937,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31159},{"id":1787056975211,"text":"手伸过来。","rawContent":"手伸过来。","isHtml":false,"sticker":null,"sender":"them","time":"00:26","timestamp":1787070395364,"roundId":"round_1787070372542_2c0u1g3wg","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31160},{"id":1787056975212,"text":"地上凉，别自己往外走，直接往我怀里扑就行。","rawContent":"地上凉，别自己往外走，直接往我怀里扑就行。","isHtml":false,"sticker":null,"sender":"them","time":"00:26","timestamp":1787070395568,"roundId":"round_1787070372542_2c0u1g3wg","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31161},{"id":1787056975213,"text":"我上前一步接住你，手臂重新穿过你的腿弯，稳稳地把你端起来。","rawContent":"我上前一步接住你，手臂重新穿过你的腿弯，稳稳地把你端起来。","isHtml":false,"sticker":null,"sender":"them","time":"00:26","timestamp":1787070396250,"roundId":"round_1787070372542_2c0u1g3wg","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31162},{"id":17870569