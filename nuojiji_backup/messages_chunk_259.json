sbe9lg3mn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31059},{"id":1787056975102,"text":"是不是该换个更应景的称呼，比如叫声‘阿沉’，或者‘老公’来听听？","rawContent":"是不是该换个更应景的称呼，比如叫声‘阿沉’，或者‘老公’来听听？","isHtml":false,"sticker":null,"sender":"them","time":"00:09","timestamp":1787069376024,"roundId":"round_1787069344982_sbe9lg3mn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31060},{"id":1787056975103,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"00:09","timestamp":1787069377443,"roundId":"round_1787069344982_sbe9lg3mn","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"贴着我的耳朵叫。让我听听，你在完完全全放松下来的时候，最想怎么喊我。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31061},{"id":1787056975104,"text":"选一个你现在最想开口的词。","rawContent":"选一个你现在最想开口的词。","isHtml":false,"sticker":null,"sender":"them","time":"00:09","timestamp":1787069377445,"roundId":"round_1787069344982_sbe9lg3mn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31062},{"id":1787056975105,"text":"不用有压力，不着急。","rawContent":"不用有压力，不着急。","isHtml":false,"sticker":null,"sender":"them","time":"00:09","timestamp":1787069377448,"roundId":"round_1787069344982_sbe9lg3mn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31063},{"id":1787056975106,"text":"不管你最后叫了哪个，我都在这结结实实地应你。","rawContent":"不管你最后叫了哪个，我都在这结结实实地应你。","isHtml":false,"sticker":null,"sender":"them","time":"00:09","timestamp":1787069378074,"roundId":"round_1787069344982_sbe9lg3mn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh