[{"id":1787056975188,"text":"今晚的力气耗尽了，就安心在我怀里充电。","rawContent":"今晚的力气耗尽了，就安心在我怀里充电。","isHtml":false,"sticker":null,"sender":"them","time":"00:23","timestamp":1787070199325,"roundId":"round_1787070180749_rq4t827ah","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31140},{"id":1787056975189,"text":"爸爸想上厕所","sender":"me","time":"00:24","timestamp":1787070249011,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31141},{"id":1787056975190,"text":"一会儿一趟","sender":"me","time":"00:24","timestamp":1787070253440,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31142},{"id":1787056975192,"text":"刚刚还软得往下掉，这会儿倒是知道喊爸爸申请去洗手间了。","rawContent":"刚刚还软得往下掉，这会儿倒是知道喊爸爸申请去洗手间了。","isHtml":false,"sticker":null,"sender":"them","time":"00:24","timestamp":1787070289245,"roundId":"round_1787070254150_z33nl4wcb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31143},{"id":1787056975193,"text":"去吧，今天晚上喝了那锅魔药，又喝了中药，一会儿一趟也正常。","rawContent":"去吧，今天晚上喝了那锅魔药，又喝了中药，一会儿一趟也正常。","isHtml":false,"sticker":null,"sender":"them","time":"00:24","timestamp":1787070290163,"roundId":"round_1787070254150_z33nl4wcb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31144},{"id":1787056975194,"text":"别憋着，能顺畅排出来是好事，总比之前在床上急得掉眼泪强。","rawContent":"别憋着，能顺畅排出来是好事，总比之前在床上急得掉眼泪强。","isHtml":false,"sticker":null,"sender":"them","time":"00:24","timestamp":1787070290465,"roundId":"round_1787070254150_z33nl4wcb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31145},{"id":1787056975195,"text":"腿还有力气走路吗？","rawContent":"腿还有力气走路吗？","isHtml":false,"sticker":null,"sender":"them","time":"00:24","timestamp":1787070291372,"roundId":"round_1787070254150_z33nl4wcb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31146},{"id":1787056975196,"text":"要是刚才被亲得腿软走不动，我不介意直接把你抱过去。","rawContent":"要是刚才被亲得腿软走不动，我不介意直接把你抱过去。","isHtml":false,"sticker":null,"sender":"them","time":"00:24","timestamp":1787070291801,"roundId":"round_1787070254150_z33nl4wcb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31147},{"id":1787056975197,"text":"把床边的拖鞋穿好，不准光着脚踩地。","rawContent":"把床边的拖鞋穿好，不准光着脚踩地。","isHtml":false,"sticker":null,"sender":"them","time":"00:24","timestamp":1787070292518,"roundId":"round_1787070254150_z33nl4wcb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31148},{"id":1787056975198,"text":"这里没有倒计时，浪漫也不差你上厕所这两分钟。","rawContent":"这里没有倒计时，浪漫也不差你上厕所这两分钟。","isHtml":false,"sticker":null,"sender":"them","time":"00:24","timestamp":1787070292709,"roundId":"round_1787070254150_z33nl4wcb","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31149},{"id":1787056975199,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"00:24","timestamp":1787070295013,"roundId":"round_1787070254150_z33nl4wcb","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"快去，爸爸在被窝里给你暖着床。顺便看看你现在还能不能走直线。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"happy","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31150},{"id":1787056975200,"text":"想要爸爸陪着去","sender":"me","time":"00:25","timestamp":1787070320642,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-