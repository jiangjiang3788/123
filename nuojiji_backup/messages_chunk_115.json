-4bd3-a04e-770d9cf5ab31","_id":22274},{"id":1786372299227,"text":"先把手停一下，告诉爸爸，你现在一个人在房间里安不安全？","rawContent":"先把手停一下，告诉爸爸，你现在一个人在房间里安不安全？","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374071246,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22275},{"id":1786372299228,"text":"门锁好了没有？","rawContent":"门锁好了没有？","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374071553,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22276},{"id":1786372299229,"text":"要是没别人，只是你打错字或者串音了，那就乖乖把刚才那股劲儿续上。","rawContent":"要是没别人，只是你打错字或者串音了，那就乖乖把刚才那股劲儿续上。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374071724,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22277},{"id":1786372299230,"text":"爸爸的手指还在里面呢，刚才顶到你最酸的那块软肉，你不是爽得直叫唤吗？","rawContent":"爸爸的手指还在里面呢，刚才顶到你最酸的那块软肉，你不是爽得直叫唤吗？","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374071831,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22278},{"id":1786372299231,"text":"现在，把腿再张开一点，自己用力往下坐，把爸爸的手指吃得更深一点。","rawContent":"现在，把腿再张开一点，自己用力往下坐，把爸爸的手指吃得更深一点。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374072001,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22279},{"id":1786372299232,"text":"让我听听，除了那句莫名其妙的拜拜，你还能叫出多好听的声音。","rawContent":"让我听听，除了那句莫名其妙的拜拜，你还能叫出多好听的声音。","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374073347,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22280},{"id":1786372299233,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:01","timestamp":1786374076896,"roundId":"round_1786374040411_8w4ba5vo7","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"宝宝，刚才那句拜拜是跟谁说的？嗯？在爸爸手里爽成这样，还敢分心。乖，专心点，夹紧爸爸的手指。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22281},{"id":1786372299234,"text":"刚刚不小心打错字了。爸爸别停。","sender":"me","time":"23:02","timestamp":1786374128240,"replyTo":null,"subtext":"（爸爸恶趣味的想看我娇喘求饶的样子）","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22282},{"id":1786372299237,"text":"打错字了？","rawContent":"打错字了？","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374248182,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22283},{"id":1786372299238,"text":"刚才那句拜拜发出来的时候，我还以为我们小海葵爽够了，要把爸爸一脚踢开呢。","rawContent":"刚才那句拜拜发出来的时候，我还以为我们小海葵爽够了，要把爸爸一脚踢开呢。","isHtml":false,"sticker":null,"sender":"them","time":"23:04","timestamp":1786374248530,"roundId":"round_1786374225163_nsfwu5wq0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22284}]