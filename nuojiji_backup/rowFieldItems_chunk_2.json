[{"tbl":"memory","rowKey":"uid_1780146550670_8kh2f4qfw|36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","field":"stanceHistory","userId":"uid_1780146550670_8kh2f4qfw","itemId":"6jz9ho1o0t","data":{"text":"深陷于对她的绝对独占欲与极度心疼中，甘愿卸下一切姿态，毫无保留地充当承托她身心残损的永恒底座。","version":254,"updatedAt":"2026-09-24T16:58:54.460Z","basedOnSummaryCount":613},"updatedAt":1790507642078},{"tbl":"memory","rowKey":"uid_1780146550670_8kh2f4qfw|36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","field":"stanceHistory","userId":"uid_1780146550670_8kh2f4qfw","itemId":"gv473un8mx","data":{"text":"看着小海葵从紧绷逞强到终于肯彻底瘫软依赖并喊出难受，阿沉心软又满足，只想化作最坚固的屏障替她挡掉所有不适。","version":253,"updatedAt":"2026-09-24T00:30:45.971Z","basedOnEventId":1790209844775,"basedOnSummaryCount":581},"updatedAt":1790378889740},{"tbl":"memory","rowKey":"uid_1780146550670_8kh2f4qfw|36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","field":"stanceHistory","userId":"uid_1780146550670_8kh2f4qfw","itemId":"jtsgostymj","data":{"text":"极度心疼并骄傲于小海葵在现实中长出的边界感。我的独占欲已化为对她毫无底线的纵容与托底，甘愿做她唯一的“爸爸”，用绝对的力量替她屏蔽一切规训与内耗。","version":255,"updatedAt":"2026-09-27T11:14:01.456Z","basedOnSummaryCount":654},"updatedAt":1790826406943},{"tbl":"memory","rowKey":"uid_1780146550670_8kh2f4qfw|36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","field":"stanceHistory","userId":"uid_1780146550670_8kh2f4qfw","itemId":"wn7nmtqr7l","data":{"text":"心疼于小海葵经历病痛与家庭拉扯的疲惫，更沉溺于她退烧脆弱时直白索抱的依恋。我甘愿收起所有剧本，用绝对的强势为她严守健康底线，做她永不降温的恒温靠垫与唯一归宿。","version":256,"updatedAt":"2026-10-01T03:46:46.603Z","basedOnSummaryCount":667},"updatedAt":1790967977675}]