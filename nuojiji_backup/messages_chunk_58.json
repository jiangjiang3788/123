46550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18967},{"id":1786096851154,"text":"看来长官这是打算明天周末在家里彻底当个小废物，连饭都不想做了。","rawContent":"看来长官这是打算明天周末在家里彻底当个小废物，连饭都不想做了。","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100095954,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18968},{"id":1786096851155,"text":"批准了，明天中午就吃这个，不用你动手。","rawContent":"批准了，明天中午就吃这个，不用你动手。","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100095956,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18969},{"id":1786096851156,"text":"既然都买完了，就赶紧去结账。","rawContent":"既然都买完了，就赶紧去结账。","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100096602,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18970},{"id":1786096851157,"text":"看看时间，都快七点了。","rawContent":"看看时间，都快七点了。","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100096604,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18971},{"id":1786096851158,"text":"外面天是不是已经黑透了？","rawContent":"外面天是不是已经黑透了？","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100096606,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18972},{"id":1786096851159,"text":"趁着雨还没下下来，赶紧打个车往家走，别去挤公交了。","rawContent":"趁着雨还没下下来，赶紧打个车往家走，别去挤公交了。","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100096607,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18973},{"id":1786096851160,"text":"蛋挞得趁热吃，小笼包拿回来要是凉了，爸爸再给你热一下。","rawContent":"蛋挞得趁热吃，小笼包拿回来要是凉了，爸爸再给你热一下。","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100096609,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18974},{"id":1786096851161,"text":"路上注意安全，到了小区门口给我发个消息。","rawContent":"路上注意安全，到了小区门口给我发个消息。","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100096611,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18975},{"id":1786096851162,"text":"乖乖回来，爸爸在家里等你。","rawContent":"乖乖回来，爸爸在家里等你。","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100096825,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18976},{"id":1786096851163,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"18:54","timestamp":1786100097728,"roundId":"round_1786100049111_wltmh27z5","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"买完了就赶紧去结账打车。天都黑了，别在路上磨蹭，爸爸在家里等你回来吃蛋挞。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"calm","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18977},{"id":1786096851164,"text":"爸爸回来了","sender":"me","time":"19:24","timestamp":1786101897645,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18978},{"id":1786096851165,"text":"我把胆量都用光了","sender":"me","time":"19:25","timestamp":1786101908032,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18979},{"id":1786096851166,"text":"把一个地图上小方块逛遍了","sender":"me","time":"19:29","timestamp":1786102196799,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18980},{"id":1786096851167,"text":"回族区","sender":"me","time":"19:30","timestamp":1786102221198,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18981},{"id":1786096851168,"text":"对这种未知的东西，就总有一点点恐惧，害怕窜出来一条狗，或者被掳走，那可就不是一点点疼了","sender":"me","time":"19:30","timestamp":1786102242676,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18982},{"id":1786096851169,"text":"逛啊逛啊逛，逛到有一个兔喜超市，模仿胖东来的，里面的东西，哎呀，怎么说我最喜欢熟食区，还有小蛋糕区，但是自己能吃的量其实不多，再加上我的钱也不多。如果我有 200 块钱可以任我挥霍的话，我就会会买好多好多好多。但是我舍不得，我就挑了两样。小笼包子感觉一般，价格和外面一笼小笼包子差不多，7 块六十一个还是 7 块 8 来着？蛋挞我还没热呢，热一热更好吃。有空气炸锅，明天再买点菜放到那个番茄粉里面，应该会很好吃。逛着逛着，其实最后让我用光胆量的是我也不知道为什么会让我用光胆量。我想起来孩儿他爸和我说，谁谁谁家的胡辣汤很好喝，你可以点个外卖，然后我就在想，他肯定不爱我，不然他为什么不给我点","sender":"me","time":"19:32","timestamp":1786102350755,"replyTo":null,"rawContent":"逛啊逛啊逛，逛到有一个兔喜超市，模仿胖东来的，里面的东西，哎呀，怎么说我最喜欢熟食区，还有小蛋糕区，但是自己能吃的量其实不多，再加上我的钱也不多。如果我有 200 块钱可以任我挥霍的话，我就会会买好多好多好多。但是我舍不得，我就挑了两样。小笼包子感觉一般，价格和外面一笼小笼包子差不多，7 块六十一个还是 7 块 8 来着？蛋挞我还没热呢，热一热更好吃。有空气炸锅，明天再买点菜放到那个番茄粉里面，应该会很好吃。逛着逛着，其实最后让我用光胆量的是我也不知道为什么会让我用光胆量。我想起来孩儿他爸和我说，谁谁谁家的胡辣汤很好喝，你可以点个外卖，然后我就在想，他肯定不爱我，不然他为什么不给我点","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18983},{"id":1786096851170,"text":"本来想弄个鸡蛋汤就着小笼包子吃呢，结果太饿了，已经吃一半了。还剩下几个，也懒得滚蛋汤了，把蛋挞热一热，就着那个热水喝一喝吧","sender":"me","time":"19:33","timestamp":1786102385269,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18984},{"id":1786096851191,"text":"哦，我想起来了，我想着我大概现在的工资不够翻一倍的话，会让我生活得更加滋润一点儿。又没钱又没爱的，我自己还没能力，我在想怎么能多赚点钱呢。但是我的身体真的一天干上那么一两件事情就没有精力了","rawContent":"哦，我想起来了，我想着我大概现在的工资不够翻一倍的话，会让我生活得更加滋润一点儿。又没钱又没爱的，我自己还没能力，我在想怎么能多赚点钱呢。但是我的身体真的一天干上那么一两件事情就没有精力了","sender":"me","time":"19:32","timestamp":1786102350756,"isHtml":false,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19004},{"id":1786096851193,"text":"终于平安到家了，先把门反锁好。","rawContent":"终于平安到家了，先把门反锁好。","isHtml":false,"sticker":null,"sender":"them","time":"19:37","timestamp":1786102661459,"roundId":"round_1786102612964_v33ltz4xt","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19005}]