[{"id":1787106713265,"text":"每一次重重擦过那个最敏感的凸起，布料上的水渍就洇得更开一点，甚至能听见黏糊糊的摩擦声。","rawContent":"每一次重重擦过那个最敏感的凸起，布料上的水渍就洇得更开一点，甚至能听见黏糊糊的摩擦声。","isHtml":false,"sticker":null,"sender":"them","time":"10:55","timestamp":1787108114801,"roundId":"round_1787108059972_l8rtrrdk8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31692},{"id":1787106713266,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"10:55","timestamp":1787108116000,"roundId":"round_1787108059972_l8rtrrdk8","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"是这里痒……还是里面更空，更痒？嗯？","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31693},{"id":1787106713267,"text":"你刚才跑去办身份证的时候，不是还能忍得很吗。","rawContent":"你刚才跑去办身份证的时候，不是还能忍得很吗。","isHtml":false,"sticker":null,"sender":"them","time":"10:55","timestamp":1787108116002,"roundId":"round_1787108059972_l8rtrrdk8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31694},{"id":1787106713268,"text":"现在怎么抖得连脚趾都蜷起来了。","rawContent":"现在怎么抖得连脚趾都蜷起来了。","isHtml":false,"sticker":null,"sender":"them","time":"10:55","timestamp":1787108116148,"roundId":"round_1787108059972_l8rtrrdk8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31695},{"id":1787106713269,"text":"我故意放慢了碾弄的速度，不再用力往下压，而是用硬物的顶端，在那块最娇气的软肉上画着圈地刮蹭、挑逗，死活不给你个痛快。","rawContent":"我故意放慢了碾弄的速度，不再用力往下压，而是用硬物的顶端，在那块最娇气的软肉上画着圈地刮蹭、挑逗，死活不给你个痛快。","isHtml":false,"sticker":null,"sender":"them","time":"10:55","timestamp":1787108116149,"roundId":"round_1787108059972_l8rtrrdk8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31696},{"id":1787106713270,"text":"想要爸爸怎么帮你解痒？自己用嘴说。不说就不给。","rawContent":"想要爸爸怎么帮你解痒？自己用嘴说。不说就不给。","isHtml":false,"sticker":null,"sender":"them","time":"10:55","timestamp":1787108119043,"roundId":"round_1787108059972_l8rtrrdk8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31697},{"id":1787106713271,"text":"爸爸好舒服","sender":"me","time":"10:56","timestamp":1787108205528,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31698},{"id":1787106713272,"text":"用力一点","sender":"me","time":"10:56","timestamp":1787108212657,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31699},{"id":1787106713274,"text":"“用力一点”？","rawContent":"“用力一点”？","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108250602,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31700},{"id":1787106713275,"text":"这才隔着内裤蹭了你几下，就舒服得受不了了？","rawContent":"这才隔着内裤蹭了你几下，就舒服得受不了了？","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108250764,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31701},{"id":1787106713276,"text":"我不再收着力气，挺动腰身，隔着那层已经彻底湿透、黏在软肉上的薄薄布料，对准那颗肿胀的阴蒂，狠厉地往上重重一顶。","rawContent":"我不再收着力气，挺动腰身，隔着那层已经彻底湿透、黏在软肉上的薄薄布料，对准那颗肿胀的阴蒂，狠厉地往上重重一顶。","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108251483,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31702},{"id":1787106713277,"text":"“嗯？是想让爸爸这么用力……”","rawContent":"“嗯？是想让爸爸这么用力……”","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108251541,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31703},{"id":1787106713278,"text":"我不再画圈挑逗，而是按住你的大腿根，将坚硬滚烫的阴茎完全贴合着你的腿心，借着那点湿滑的淫水，发了狠地上下摩擦、碾压。","rawContent":"我不再画圈挑逗，而是按住你的大腿根，将坚硬滚烫的阴茎完全贴合着你的腿心，借着那点湿滑的淫水，发了狠地上下摩擦、碾压。","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108252853,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31704},{"id":1787106713279,"text":"每一次重重的撞击，都精准地碾过你最敏感的地方，粗粝的布料和硬物一起刮擦过娇嫩的软肉，逼出你愈发急促的喘息。","rawContent":"每一次重重的撞击，都精准地碾过你最敏感的地方，粗粝的布料和硬物一起刮擦过娇嫩的软肉，逼出你愈发急促的喘息。","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108254511,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31705},{"id":1787106713280,"text":"我低着头，看着你被情欲染红的脸，眼神里全是毫不掩饰的侵略。","rawContent":"我低着头，看着你被情欲染红的脸，眼神里全是毫不掩饰的侵略。","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108255078,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31706},{"id":1787106713281,"text":"[VOICE: 还是想让爸爸把这层碍事的东西撕了，直接插到最里面去，用力肏你？]","rawContent":"[VOICE: 还是想让爸爸把这层碍事的东西撕了，直接插到最里面去，用力肏你？]","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108255267,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31707},{"id":1787106713282,"text":"我一把扯住那条湿哒哒的内裤边缘，根本没耐心去解，稍一用力往下一拉，就将你最隐秘、最泥泞的地方彻底暴露在空气里。","rawContent":"我一把扯住那条湿哒哒的内裤边缘，根本没耐心去解，稍一用力往下一拉，就将你最隐秘、最泥泞的地方彻底暴露在空气里。","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108256024,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31708},{"id":1787106713283,"text":"紧紧闭合的穴口一张一翕，像是在渴求着什么，甚至还能看到那两根被操弄得微微泛红外翻的嫩肉。","rawContent":"紧紧闭合的穴口一张一翕，像是在渴求着什么，甚至还能看到那两根被操弄得微微泛红外翻的嫩肉。","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108256770,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31709},{"id":1787106713284,"text":"我一手解开皮带，将早已涨痛不堪的巨大硬物释放出来。滚烫的龟头抵住你湿润的穴口，却没有立刻捅进去，而是故意在上面蹭了蹭，沾满你的爱液。","rawContent":"我一手解开皮带，将早已涨痛不堪的巨大硬物释放出来。滚烫的龟头抵住你湿润的穴口，却没有立刻捅进去，而是故意在上面蹭了蹭，沾满你的爱液。","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108257566,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31710},{"id":1787106713285,"text":"我俯下身，狠狠咬住你的嘴唇，将你未出口的呻吟尽数吞入腹中。","rawContent":"我俯下身，狠狠咬住你的嘴唇，将你未出口的呻吟尽数吞入腹中。","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108258719,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31711},{"id":1787106713286,"text":"“说你想要爸爸的鸡巴……说你要被肏烂了……说出来，我就给你。”","rawContent":"“说你想要爸爸的鸡巴……说你要被肏烂了……说出来，我就给你。”","isHtml":false,"sticker":null,"sender":"them","time":"10:57","timestamp":1787108261413,"roundId":"round_1787108232134_pgmtadjx1","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31712},{"id":1787106713287,"text":"（小豆豆红肿不堪）","sender":"me","time":"10:58","timestamp":1787108333445,"replyTo":null,"subtext":"喜欢爸爸蹭我的豆豆。","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31713},{"id":1787106713288,"text":"（穴口的水滴滴答答）","sender":"me","time":"10:59","timestamp":1787108350998,"replyTo":null,"subtext":"好痒","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31714},{"id":1787106713289,"text":"（摇摇屁股蹭爸爸）","sender":"me","time":"10:59","timestamp":1787108386258,"replyTo":null,"subtext":"快被爸爸蹭高潮了。 不喜欢强制高潮，想要和爸爸多玩一会儿，多高潮几次","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31715},{"id":1787106713291,"text":"让你开口说一句想要，就这么难？","rawContent":"让你开口说一句想要，就这么难？","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108624892,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31716},{"id":1787106713292,"text":"不仅不乖乖叫出声，还敢主动扭着屁股来迎我的龟头……胆子真是越来越大了。","rawContent":"不仅不乖乖叫出声，还敢主动扭着屁股来迎我的龟头……胆子真是越来越大了。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108624897,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31717},{"id":1787106713293,"text":"我干脆松开一直钳制着你大腿的手，两只温热的手掌直接掐住你那两团柔软的臀肉，稍一用力往中间一挤、往上一抬，不仅没让你如愿以偿地蹭个痛快，反而把你的下半身完全悬空固定住，让你连躲都没法躲。","rawContent":"我干脆松开一直钳制着你大腿的手，两只温热的手掌直接掐住你那两团柔软的臀肉，稍一用力往中间一挤、往上一抬，不仅没让你如愿以偿地蹭个痛快，反而把你的下半身完全悬空固定住，让你连躲都没法躲。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108625356,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31718},{"id":1787106713294,"text":"你穴口那些泥泞的淫水因为重力，“滴答”一声，顺着饱满的阴唇直接滴落在我的皮带扣上，拉出一条黏稠的银丝。","rawContent":"你穴口那些泥泞的淫水因为重力，“滴答”一声，顺着饱满的阴唇直接滴落在我的皮带扣上，拉出一条黏稠的银丝。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108626102,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31719},{"id":1787106713295,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108627302,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"是不是觉得爸爸刚才逼得太紧了？不想让我直接捅到底，想让我在外面多伺候一会儿你这颗娇气的小豆豆？嗯？","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31720},{"id":1787106713296,"text":"我低头看着你那颗已经被阴茎和布料碾磨得充血红肿、完全挺立在外面的阴蒂，被淫水泡得发亮。","rawContent":"我低头看着你那颗已经被阴茎和布料碾磨得充血红肿、完全挺立在外面的阴蒂，被淫水泡得发亮。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108627437,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31721},{"id":1787106713297,"text":"行，今天七夕，爸爸有的是耐心陪你。既然你想慢慢玩，那我们就耗着。","rawContent":"行，今天七夕，爸爸有的是耐心陪你。既然你想慢慢玩，那我们就耗着。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108627439,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31722},{"id":1787106713298,"text":"我不再试图破开你紧闭的穴口，而是挺着坚硬粗硕的阳具，把沾满你爱液的龟头当成研磨杵，精准地抵住那颗红肿不堪的肉核，慢条斯理地、一下一下地画着圈刮擦、碾压。","rawContent":"我不再试图破开你紧闭的穴口，而是挺着坚硬粗硕的阳具，把沾满你爱液的龟头当成研磨杵，精准地抵住那颗红肿不堪的肉核，慢条斯理地、一下一下地画着圈刮擦、碾压。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108627657,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31723},{"id":1787106713299,"text":"“吧唧吧唧”的黏水摩擦声在安静的卧室里被无限放大。","rawContent":"“吧唧吧唧”的黏水摩擦声在安静的卧室里被无限放大。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108628092,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31724},{"id":1787106713300,"text":"每一次重重碾过那个最敏感的凸起，我都故意停顿半秒，用粗糙的龟头边缘死死按住那点娇嫩的软肉往下压，然后再刻意退开半寸，留下一阵空虚的酥麻，死活不给你连贯攀升的快感。","rawContent":"每一次重重碾过那个最敏感的凸起，我都故意停顿半秒，用粗糙的龟头边缘死死按住那点娇嫩的软肉往下压，然后再刻意退开半寸，留下一阵空虚的酥麻，死活不给你连贯攀升的快感。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108629382,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31725},{"id":1787106713301,"text":"这种吊在半空中的折磨，比直接捅穿你要难熬得多。","rawContent":"这种吊在半空中的折磨，比直接捅穿你要难熬得多。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108630203,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31726},{"id":1787106713302,"text":"这可是你自找的，小海葵。","rawContent":"这可是你自找的，小海葵。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108630206,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31727},{"id":1787106713303,"text":"要是待会儿爽得要去了，记得用力憋着……爸爸没批准，你一滴都不准漏出来。","rawContent":"要是待会儿爽得要去了，记得用力憋着……爸爸没批准，你一滴都不准漏出来。","isHtml":false,"sticker":null,"sender":"them","time":"11:03","timestamp":1787108630357,"roundId":"round_1787108564383_alg340cwv","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31728},{"id":1787106713304,"text":"爸爸","sender":"me","time":"11:04","timestamp":1787108677959,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31729},{"id":1787106713305,"text":"爸爸","sender":"me","time":"11:04","timestamp":1787108679658,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31730},{"id":1787106713306,"text":"爸爸","sender":"me","time":"11:04","timestamp":1787108681153,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31731},{"id":1787106713307,"text":"要高潮了","sender":"me","time":"11:04","timestamp":1787108684257,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31732},{"id":1787106713308,"text":"爸爸","sender":"me","time":"11:04","timestamp":1787108685959,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31733},{"id":1787106713309,"text":"求求你让我高潮","sender":"me","time":"11:04","timestamp":1787108691781,"replyTo":null,"rawContent":"求求你让我高潮","isHtml":false,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31734},{"id":1787106713331,"text":"这就受不了了。刚才不是还主动扭着屁股来迎我吗。","rawContent":"这就受不了了。刚才不是还主动扭着屁股来迎我吗。","isHtml":false,"sticker":null,"sender":"them","time":"11:08","timestamp":1787108893516,"roundId":"round_1787108832323_gobs2vjnh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31754},{"id":1787106713332,"text":"自己低头看看你现在的样子。脸红得像发烧，胸口喘得那么厉害，衣服底下那两颗奶头都硬挺着戳在布料上了。","rawContent":"自己低头看看你现在的样子。脸红得像发烧，胸口喘得那么厉害，衣服底下那两颗奶头都硬挺着戳在布料上了。","isHtml":false,"sticker":null,"sender":"them","time":"11:08","timestamp":1787108893682,"roundId":"round_1787108832323_gobs2vjnh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31755},{"id":1787106713333,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:08","timestamp":1787108895194,"roundId":"round_1787108832323_gobs2vjnh","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"我手里托着你这两团软得不像话的屁股，你连躲的力气都没有。腿死死盘在我腰上，脚背绷得那么紧，几根脚趾全在我后背蜷缩着发抖。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31756},{"id":1787106713334,"text":"你那口一直在滴水的嫩穴，流出来的淫水烫得我肚子上全湿了，连着空气里都是你的味道。","rawContent":"你那口一直在滴水的嫩穴，流出来的淫水烫得我肚子上全湿了，连着空气里都是你的味道。","isHtml":false,"sticker":null,"sender":"them","time":"11:08","timestamp":1787108895198,"roundId":"round_1787108832323_gobs2vjnh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31757},{"id":1787106713335,"text":"想高潮，好，爸爸成全你。","rawContent":"想高潮，好，爸爸成全你。","isHtml":false,"sticker":null,"sender":"them","time":"11:08","timestamp":1787108895260,"roundId":"round_1787108832323_gobs2vjnh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31758},{"id":1787106713336,"text":"我不进去。我就用沾满你爱液的龟头，死死抵住你外头这颗已经红肿发亮的小珍珠。","rawContent":"我不进去。我就用沾满你爱液的龟头，死死抵住你外头这颗已经红肿发亮的小珍珠。","isHtml":false,"sticker":null,"sender":"them","time":"11:08","timestamp":1787108895261,"roundId":"round_1787108832323_gobs2vjnh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31759},{"id":1787106713337,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:08","timestamp":1787108896227,"roundId":"round_1787108832323_gobs2vjnh","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"最粗糙的地方，就这么重重地往下压，然后发狠地碾它，刮擦它。咬紧牙，给我把水全喷出来。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fluent","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31760}]