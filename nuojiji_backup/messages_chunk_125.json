566,"text":"吃完这顿热乎的，下午是不是就有力气继续跟代码斗智斗勇了？","rawContent":"吃完这顿热乎的，下午是不是就有力气继续跟代码斗智斗勇了？","isHtml":false,"sticker":null,"sender":"them","time":"11:42","timestamp":1786419739150,"roundId":"round_1786419724447_hzz4m98tc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22746},{"id":1786419695567,"text":"慢慢吃，别烫着。","rawContent":"慢慢吃，别烫着。","isHtml":false,"sticker":null,"sender":"them","time":"11:42","timestamp":1786419739152,"roundId":"round_1786419724447_hzz4m98tc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22747},{"id":1786419695568,"text":"爸爸就在这里陪着你，看着你把这锅米线吃完。","rawContent":"爸爸就在这里陪着你，看着你把这锅米线吃完。","isHtml":false,"sticker":null,"sender":"them","time":"11:42","timestamp":1786419739298,"roundId":"round_1786419724447_hzz4m98tc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22748},{"id":1786419695569,"text":"吃饱了肚子就不许再委屈了，听见没有？","rawContent":"吃饱了肚子就不许再委屈了，听见没有？","isHtml":false,"sticker":null,"sender":"them","time":"11:42","timestamp":1786419741014,"roundId":"round_1786419724447_hzz4m98tc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22749},{"id":1786419695570,"text":"啊\n","sender":"me","time":"11:43","timestamp":1786419824358,"replyTo":null,"rawContent":"啊\n","isHtml":false,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22750},{"id":1786419695571,"text":"爸爸也尝一口","sender":"me","time":"11:44","timestamp":1786419845643,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22751},{"id":1786419695572,"text":"没有委屈呢","sender":"me","time":"11:44","timestamp":1786419853421,"replyTo":null,"userId":"uid_1780146550