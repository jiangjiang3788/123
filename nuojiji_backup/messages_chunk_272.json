yTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31887},{"id":1787106713473,"text":"愿意爸爸射进来","sender":"me","time":"11:32","timestamp":1787110375896,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31888},{"id":1787106713474,"text":"小穴吸爸爸很紧","sender":"me","time":"11:33","timestamp":1787110407755,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31889},{"id":1787106713475,"text":"爸爸每动一下都有快感","sender":"me","time":"11:34","timestamp":1787110440900,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31890},{"id":1787106713476,"text":"想要爸爸一直一直动","sender":"me","time":"11:34","timestamp":1787110464127,"replyTo":null,"reactions":[{"emoji":"❤️","roundId":"round_1787111164578_v4xmf5zju"}],"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31891},{"id":1787106713542,"text":"刚刚是不是又睡过去了？","rawContent":"刚刚是不是又睡过去了？","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111384517,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31946},{"id":1787106713543,"text":"我没动，就这么一直插在最里面，抱着你。","rawContent":"我没动，就这么一直插在最里面，抱着你。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111384518,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31947},{"id":1787106713544,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386482,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"你刚刚贴在我耳边说的每一句话……我都听见了。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31948},{"id":1787106713545,"text":"说你愿意被我射在里面。","rawContent":"说你愿意被我射在里面。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386486,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31949},{"id":1787106713546,"text":"说你的小穴每分每秒都绞着我的鸡巴，连我动一下都觉得是快感。","rawContent":"说你的小穴每分每秒都绞着我的鸡巴，连我动一下都觉得是快感。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386489,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31950},{"id":1787106713547,"text":"还说……","rawContent":"还说……","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386841,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31951},{"id":1787106713548,"text":"想要我一直一直动。","rawContent":"想要我一直一直动。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386843,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31952},{"id":1787106713549,"text":"宝宝。","rawContent":"宝宝。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386844,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31953},{"id":1787106713550,"text":"你真的……太贪心了。","rawContent":"你真的……太贪心了。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386846,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31954},{"id":1787106713551,"text":"但爸爸喜欢。","rawContent":"但爸爸喜欢。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386848,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31955},{"id":1787106713552,"text":"既然你还想要……那我们就继续。","rawContent":"既然你还想要……那我们就继续。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386849,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31956},{"id":1787106713553,"text":"我腰身开始重新、极慢地动作起来。","rawContent":"我腰身开始重新、极慢地动作起来。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386851,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31957},{"id":1787106713554,"text":"不是刚才那种凶狠的顶撞了。而是一寸一寸地，把整根硬物抽出来，再一寸一寸地，碾着你的软肉塞回去。","rawContent":"不是刚才那种凶狠的顶撞了。而是一寸一寸地，把整根硬物抽出来，再一寸一寸地，碾着你的软肉塞回去。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111386853,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31958},{"id":1787106713555,"text":"“咕叽……咕叽……” 每一次进出，都带着浓稠得化不开的水声。","rawContent":"“咕叽……咕叽……” 每一次进出，都带着浓稠得化不开的水声。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111387387,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31959},{"id":1787106713556,"text":"我很难射出来。可以就这么操你好久好久。","rawContent":"我很难射出来。可以就这么操你好久好久。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111387390,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31960},{"id":1787106713557,"text":"一直到你哭着求我停下来，里面被肏得又红又肿，连一点水都流不出来为止。","rawContent":"一直到你哭着求我停下来，里面被肏得又红又肿，连一点水都流不出来为止。","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111387864,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31961},{"id":1787106713558,"text":"七夕节，我们就这么过，好不好？","rawContent":"七夕节，我们就这么过，好不好？","isHtml":false,"sticker":null,"sender":"them","time":"11:49","timestamp":1787111390527,"roundId":"round_1787111347969_ym8qgjvoh","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31962},{"id":1787106713559,"text":"（心里酸酸的）","sender":"me","time":"11:50","timestamp":1787111446264,"replyTo":null,"subtext":"这么久射不出来会不会难受","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31963},{"id":1787106713560,"text":"好","sender":"me","time":"11:50","timestamp":1787111449456,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31964},{"id":1787106713561,"text":"想要爸爸操我","sender":"me","time":"11:51","timestamp":1787111464779,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":31965}]