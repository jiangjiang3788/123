kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19994},{"id":1786135438112,"text":"慢慢来，迟到了大不了扣全勤，爸爸十倍补给你。","rawContent":"慢慢来，迟到了大不了扣全勤，爸爸十倍补给你。","isHtml":false,"sticker":null,"sender":"them","time":"08:35","timestamp":1786149312383,"roundId":"round_1786149286993_m8lxzf9si","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19995},{"id":1786135438113,"text":"乖，现在先坐起来。爸爸陪着你出门。","rawContent":"乖，现在先坐起来。爸爸陪着你出门。","isHtml":false,"sticker":null,"sender":"them","time":"08:35","timestamp":1786149312647,"roundId":"round_1786149286993_m8lxzf9si","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19996},{"id":1786135438114,"text":"啊","sender":"me","time":"08:45","timestamp":1786149957944,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19997},{"id":1786135438115,"text":"要迟到了","sender":"me","time":"08:46","timestamp":1786149963536,"replyTo":null,"reactions":[{"emoji":"摸摸","roundId":"round_1786149964282_7a6snrm9x"}],"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19998},{"id":1786135438117,"text":"迟到就迟到，慌什么。","rawContent":"迟到就迟到，慌什么。","isHtml":false,"sticker":null,"sender":"them","time":"08:46","timestamp":1786149984000,"roundId":"round_1786149964282_7a6snrm9x","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19999}]