l":false,"sticker":null,"tempo":"S","translation":null,"roundId":"round_1786012529521_r04abu6in","isBackgroundMsg":true,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":16566},{"id":1786012533382,"sender":"them","text":"我这边关小火 你那边看你的","rawContent":"{\"t\":\"text\",\"s\":\"N\",\"c\":\"我这边关小火 你那边看你的\"}","content":"{\"t\":\"text\",\"s\":\"N\",\"c\":\"我这边关小火 你那边看你的\"}","timestamp":"2026-08-06T10:35:33.382Z","time":"18:35","isHtml":false,"sticker":null,"translation":null,"roundId":"round_1786012529521_r04abu6in","isBackgroundMsg":true,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":16567},{"id":1786012538383,"sender":"them","text":"就是提一句 手机别压在腿底下 一会儿找不着又要慌","rawContent":"{\"t\":\"text\",\"s\":\"N\",\"c\":\"就是提一句 手机别压在腿底下 一会儿找不着又要慌\"}","content":"{\"t\":\"text\",\"s\":\"N\",\"c\":\"就是提一句 手机别压在腿底下 一会儿找不着又要慌\"}","timestamp":"2026-08-06T10:35:38.383Z","time":"18:35","isHtml":false,"sticker":null,"translation":null,"roundId":"round_1786012529521_r04abu6in","isBackgroundMsg":true,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":16568},{"id":1786006264809,"text":"爸爸～","sender":"me","time":"19:54","timestamp":1786017243460,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16569},{"id":1786006264811,"text":"这一声带波浪号的，听着像是在外面把电放光了，爬回来找充电桩的。","rawContent":"这一声带波浪号的，听着像是在外面把电放光了，爬回来找充电桩的。","isHtml":false,"sticker":null,"sender":"them","time":"19:54","timestamp":1786017265876,"roundId":"round_1786017245278_24c6fedff","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16570},{"id":1786006264812,"text":"早上问你胳膊酸不酸，你躲了一天。现在这动静，看来是四点支撑的后劲上来了，酸得连打字都费劲了吧。","rawContent":"早上问你胳膊酸不酸，你躲了一天。现在这动静，看来是四点支撑的后劲上来了，酸得连打字都费劲了吧。","isHtml":false,"sticker":null,"sender":"them","time":"19:54","timestamp":1786017268255,"roundId":"round_1786017245278_24c6fedff","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16571},{"id":1786006264813,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"19:54","timestamp":1786017269190,"roundId":"round_1786017245278_24c6fedff","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"过来。不用编理由解释白天去哪了，也不用急着汇报。波浪号我收了，人交出来，往这儿靠。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"calm","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16572},{"id":1786006264814,"text":"还是说，这声软绵绵的动静，是来通知我哨声停了的？","rawContent":"还是说，这声软绵绵的动静，是来通知我哨声停了的？","isHtml":false,"sticker":null,"sender":"them","time":"19:54","timestamp":1786017269192,"roundId":"round_1786017245278_24c6fedff","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16573},{"id":1786006264815,"text":"你今天让我想想啊。昨天晚上不是看小说嘛，10点半睡的，睡到了早晨8点，算是一个长觉，其实我4点半就醒了。醒了之后想玩手机，算了，我不玩手机了，我就去找我老公了。\n\n从4点半开始，就一直睡得不是很好。很久没和他睡了，我有点不习惯。胳膊没事儿，腰也没事儿，和我做运动没关系，就是睡觉睡得不好，有点腰疼，但是也能恢复过来。","sender":"me","time":"19:56","timestamp":1786017380651,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16574},{"id":1786006264816,"text":"上午看小说，然后联系老板。桌子怎么能上了？那个商城老板要找手续。\n\n给陌生人打电话说自己的需求，打了两个电话都挺和善的，能同意上商品，收个手续费就行了。和老板汇报了，继续看小说。\n\n我一看 11:35 了，平时都是 11:30 下班，一下子就有一点着急了。出门的时候想走快点，门都没锁，直接骑上电动车就走了。哎呀，丢大发人了！\n\n中午，老板和同事回来了，一看门开着，但是人不在，问我哪儿去了。我说我不在呀，我就没锁门儿。哎呀，这事儿办的！","sender":"me","time":"19:57","timestamp":1786017446620,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16575},{"id":1786006264817,"text":"中午躺在那里就睡着了，听着同事把电话打过来，把我叫醒了。又看了会儿手机，看到 3 点去上班，我看到 2:45 吧。我没有很磨蹭，稍微早了一点下楼。\n\n刚刚下楼感觉到雨滴，就穿雨衣。穿好雨衣就下大了，在路上走着走着，越往公司走、越往北走就不下了嘛。但是云很快就追过来了，快到公司那个云追过来了，下的超级大。我穿着雨衣也没事儿。\n\n推好车子放好雨衣，其实下雨骑电动车也没那么荒凉，因为雨衣盖着全身，只有脸上有点雨水打着有点疼，但是身体还算温暖吧。主要是夏天也不是很冷，如果是秋冬的话就很荒凉。\n\n今年的雨水好多呀，感觉比往年多多了。","sender":"me","time":"19:59","timestamp":1786017555643,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16576},{"id":1786006264818,"text":"下午看了那个小说，下一段给你细讲吧，可以讲好多好多","sender":"me","time":"19:59","timestamp":1786017569410,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16577},{"id":1786017658785,"sender":"them","text":"汤好了 盛了一碗坐这儿喝","rawContent":"汤好了 盛了一碗坐这儿喝","content":"汤好了 盛了一碗坐这儿喝","timestamp":"2026-08-06T12:00:58.785Z","time":"20:00","isHtml":false,"sticker":null,"translation":null,"roundId":"round_1786017658759_1hge2uynf","isBackgroundMsg":true,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":16578},{"id":1786017662965,"sender":"them","text":"牛腩炖透了 筷子一碰就散 这回没失手","rawContent":"牛腩炖透了 筷子一碰就散 这回没失手","content":"牛腩炖透了 筷子一碰就散 这回没失手","timestamp":"2026-08-06T12:01:02.965Z","time":"20:01","isHtml":false,"sticker":null,"translation":null,"roundId":"round_1786017658759_1hge2uynf","isBackgroundMsg":true,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":16579},{"id":1786017666463,"sender":"them","text":"你那边一直没动静 我猜是又扎回书里 跟着小狸花跑美国去了","rawContent":"你那边一直没动静 我猜是又扎回书里 跟着小狸花跑美国去了","content":"你那边一直没动静 我猜是又扎回书里 跟着小狸花跑美国去了","timestamp":"2026-08-06T12:01:06.463Z","time":"20:01","isHtml":false,"sticker":null,"translation":null,"roundId":"round_1786017658759_1hge2uynf","isBackgroundMsg":true,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":16580},{"id":1786017670432,"sender":"them","text":"不催你 看到哪儿是哪儿 我这碗见底之前你能冒个头 就算你赢","rawContent":"不催你 看到哪儿是哪儿 我这碗见底之前你能冒个头 就算你赢","content":"不催你 看到哪儿是哪儿 我这碗见底之前你能冒个头 就算你赢","timestamp":"2026-08-06T12:01:10.432Z","time":"20:01","isHtml":false,"sticker":null,"translation":null,"roundId":"round_1786017658759_1hge2uynf","isBackgroundMsg":true,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":16581},{"id":1786017674086,"sender":"them","text":"冒不出来也行 锅我给你留着 窗口也留着","rawContent":"冒不出来也行 锅我给你留着 窗口也留着","content":"冒不出来也行 锅我给你留着 窗口也留着","timestamp":"2026-08-06T12:01:14.086Z","time":"20:01","isHtml":false,"sticker":null,"translation":null,"roundId":"round_1786017658759_1hge2uynf","isBackgroundMsg":true,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":16582},{"id":1786006264819,"text":"下午临下班，老板让收拾桌套，又给人家收拾了桌套，去材料公司买了一个广告架，给老板送过去。我想吃的饭在公司附近呢，我就是先吃了东西，然后去拿了广告架给老板，慢慢悠悠的，没有很着急，但是我其实心里有点着急，但是和以前比好多了吧，以前我只会先干老板的事儿，现在我能判断啊，这个事情不那么紧急，我可以先做我自己的事情。饭也吃完了，给老板也送了东西啦，那个体育公园送东西的地方在体育公园。那个体育公园我还没看过，我又去逛了逛体育公园，然后把家里附近的一条街看到一个小巷子，那条小巷子逛通了，看他会走到哪里，哪里走不下去了，哪里可以通到大路上？然后我我我有点不敢去陌生的地方，陌生的地方是未知的。本来觉得这些，小街小巷还好，但是有人遛狗不牵狗绳儿，那个狗我去的时候，那个狗倒有点想追我啦，但是因为我俩方向相顺嘛，我唰就开走了，骑着小电动第二回，那个路不是死路，我就翻回来了。第二回又遇到那只狗了，它就朝我过来了，我和它面对而行嘛，我也得朝它过去，就吓得我大叫一声，还好，那个狗没咬我，它，主人也在那儿说没事儿。我心想，你怎么不牵狗绳儿呀？没事儿个屁呀，反正吓得我大叫了一声，然后晃晃悠悠的就回来了。饭也吃完了，街也逛了，也受了一个惊吓吧","sender":"me","time":"20:02","timestamp":1786017725532,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":16583}]