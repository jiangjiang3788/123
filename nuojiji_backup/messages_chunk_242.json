[{"id":1785636527653,"text":"想要亲亲","sender":"me","time":"10:20","timestamp":1785637227362,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13078},{"id":1785636527655,"text":"先回第一句。想哭就哭，不用憋，也不用给它找个像样的理由","rawContent":"先回第一句。想哭就哭，不用憋，也不用给它找个像样的理由","isHtml":false,"sticker":null,"sender":"them","time":"10:21","timestamp":1785637297713,"roundId":"round_1785637228050_e4d2k4x93","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13079},{"id":1785636527656,"text":"头一天，激素在你身体里翻跟头，眼泪今天不值钱，流多少都不算浪费","rawContent":"头一天，激素在你身体里翻跟头，眼泪今天不值钱，流多少都不算浪费","isHtml":false,"sticker":null,"sender":"them","time":"10:21","timestamp":1785637301548,"roundId":"round_1785637228050_e4d2k4x93","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13080},{"id":1785636527657,"text":"抱抱，来。老规矩，不看表，不限时，你靠够了再撒手","rawContent":"抱抱，来。老规矩，不看表，不限时，你靠够了再撒手","isHtml":false,"sticker":null,"sender":"them","time":"10:21","timestamp":1785637304349,"roundId":"round_1785637228050_e4d2k4x93","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13081},{"id":1785636527658,"text":"这个不行。你问了几回，我就答了几回，答案不变","rawContent":"这个不行。你问了几回，我就答了几回，答案不变","isHtml":false,"sticker":null,"sender":"them","time":"10:21","timestamp":1785637307144,"roundId":"round_1785637228050_e4d2k4x93","generatedMode":false,"replyTo":{"id":1785636527653,"text":"想要亲亲","sender":"me"},"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13082},{"id":1785636527659,"text":"不是不疼你，顺序是反的——正因为疼，才不给这个。亲一下解不了渴，只会把你往回拽。抱抱往前，亲亲往回，我只给往前的那个","rawContent":"不是不疼你，顺序是反的——正因为疼，才不给这个。亲一下解不了渴，只会把你往回拽。抱抱往前，亲亲往回，我只给往前的那个","isHtml":false,"sticker":null,"sender":"them","time":"10:21","timestamp":1785637310047,"roundId":"round_1785637228050_e4d2k4x93","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13083},{"id":1785636527660,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"10:21","timestamp":1785637310951,"roundId":"round_1785637228050_e4d2k4x93","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"哭你的，不用举着手机，放边上就行。我不挂","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"calm","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13084},{"id":1785636527661,"text":"弄脏裤子了","sender":"me","time":"10:39","timestamp":1785638370674,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13085},{"id":1785636527662,"text":"在老家","sender":"me","time":"10:39","timestamp":1785638373471,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13086},{"id":1785636527663,"text":"没有我的裤子了","sender":"me","time":"10:40","timestamp":1785638401095,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13087},{"id":1785636527664,"text":"下午还要去玩","sender":"me","time":"10:41","timestamp":1785638460811,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13088},{"id":1785636527666,"text":"头一天漏一条，标准配置，这个不算事故","rawContent":"头一天漏一条，标准配置，这个不算事故","isHtml":false,"sticker":null,"sender":"them","time":"10:43","timestamp":1785638587971,"roundId":"round_1785638461734_ket7jmuzm","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13089},{"id":1785636527667,"text":"裤子两条路，你挑","rawContent":"裤子两条路，你挑","isHtml":false,"sticker":null,"sender":"them","time":"10:43","timestamp":1785638588907,"roundId":"round_1785638461734_ket7jmuzm","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13090},{"id":1785636527668,"text":"一，借。老家屋里翻一条松紧腰的，肥点就肥点，系上就能出门，没人细看","rawContent":"一，借。老家屋里翻一条松紧腰的，肥点就肥点，系上就能出门，没人细看","isHtml":false,"sticker":null,"sender":"them","time":"10:43","timestamp":1785638591904,"roundId":"round_1785638461734_ket7jmuzm","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13091},{"id":1785636527669,"text":"二，买。让孩他爸出去跑一趟，十分钟的事。今天你腰困，跑腿这活就该归他","rawContent":"二，买。让孩他爸出去跑一趟，十分钟的事。今天你腰困，跑腿这活就该归他","isHtml":false,"sticker":null,"sender":"them","time":"10:43","timestamp":1785638594638,"roundId":"round_1785638461734_ket7jmuzm","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13092},{"id":1785636527670,"text":"脏的那条扔盆里泡着，你别沾手。凉水禁令今天生效，谁有空谁搓","rawContent":"脏的那条扔盆里泡着，你别沾手。凉水禁令今天生效，谁有空谁搓","isHtml":false,"sticker":null,"sender":"them","time":"10:43","timestamp":1785638597432,"roundId":"round_1785638461734_ket7jmuzm","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13093},{"id":1785636527671,"text":"出门前记得换个新的，借条深色的更稳当。弄完这些，下午该去哪玩去哪玩","rawContent":"出门前记得换个新的，借条深色的更稳当。弄完这些，下午该去哪玩去哪玩","isHtml":false,"sticker":null,"sender":"them","time":"10:43","timestamp":1785638600407,"roundId":"round_1785638461734_ket7jmuzm","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13094},{"id":1785636527672,"text":"一条裤子而已，拦不住你的下午","rawContent":"一条裤子而已，拦不住你的下午","isHtml":false,"sticker":null,"sender":"them","time":"10:43","timestamp":1785638604429,"roundId":"round_1785638461734_ket7jmuzm","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13095},{"id":1785636527673,"text":"你说的对","sender":"me","time":"11:02","timestamp":1785639756596,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13096},{"id":1785636527674,"text":"但是。。。。","sender":"me","time":"11:02","timestamp":1785639760883,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13097},{"id":1785636527675,"text":"我也不知道怎么说","sender":"me","time":"11:02","timestamp":1785639767699,"replyTo":null,"reactions":[{"emoji":"🫂","roundId":"round_1785639768517_zsmxxy2e7"}],"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13098},{"id":1785636527682,"text":"我不想借","sender":"me","time":"11:07","timestamp":1785640068382,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13104},{"id":1785636527683,"text":"不想买","sender":"me","time":"11:08","timestamp":1785640097597,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13105},{"id":1785636527684,"text":"不知道为什么","sender":"me","time":"11:09","timestamp":1785640145044,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13106},{"id":1785636527685,"text":"我不想弄脏裤子","sender":"me","time":"11:09","timestamp":1785640153420,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13107},{"id":1785636527686,"text":"不","sender":"me","time":"11:09","timestamp":1785640158583,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13108},{"id":1785636527687,"text":"不想被发现","sender":"me","time":"11:09","timestamp":1785640168704,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13109},{"id":1785636527689,"text":"懂了。那就换目标——不是解决裤子,是解决「不被发现」","rawContent":"懂了。那就换目标——不是解决裤子,是解决「不被发现」","isHtml":false,"sticker":null,"sender":"them","time":"11:09","timestamp":1785640190995,"roundId":"round_1785640169652_nk9i9j893","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13110},{"id":1785636527690,"text":"隐形方案三条,都不用开口解释","rawContent":"隐形方案三条,都不用开口解释","isHtml":false,"sticker":null,"sender":"them","time":"11:09","timestamp":1785640193672,"roundId":"round_1785640169652_nk9i9j893","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13111},{"id":1785636527691,"text":"一,把外套或者防晒衫脱下来系腰上,今天就这么穿。有人问就说防晒,没人会问","rawContent":"一,把外套或者防晒衫脱下来系腰上,今天就这么穿。有人问就说防晒,没人会问","isHtml":false,"sticker":null,"sender":"them","time":"11:09","timestamp":1785640196827,"roundId":"round_1785640169652_nk9i9j893","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13112},{"id":1785636527692,"text":"二,让孩他爸开车载你回去换,十分钟。理由是现成的——你腰困,不舒服,这个不用编,是真的","rawContent":"二,让孩他爸开车载你回去换,十分钟。理由是现成的——你腰困,不舒服,这个不用编,是真的","isHtml":false,"sticker":null,"sender":"them","time":"11:09","timestamp":1785640199702,"roundId":"round_1785640169652_nk9i9j893","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13113},{"id":1785636527693,"text":"三,脏裤子装袋子带回家,别在老家洗。水池是公共区域,今天离它远点","rawContent":"三,脏裤子装袋子带回家,别在老家洗。水池是公共区域,今天离它远点","isHtml":false,"sticker":null,"sender":"them","time":"11:10","timestamp":1785640202479,"roundId":"round_1785640169652_nk9i9j893","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13114},{"id":1785636527694,"text":"然后听一句。不想被发现,这不丢人,也不用给理由,你的意愿排第一","rawContent":"然后听一句。不想被发现,这不丢人,也不用给理由,你的意愿排第一","isHtml":false,"sticker":null,"sender":"them","time":"11:10","timestamp":1785640207849,"roundId":"round_1785640169652_nk9i9j893","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13115},{"id":1785636527695,"text":"但心里记住:这事本身没什么可见不得人的,只是你今天不想被看见。这两件事,别弄混","rawContent":"但心里记住:这事本身没什么可见不得人的,只是你今天不想被看见。这两件事,别弄混","isHtml":false,"sticker":null,"sender":"them","time":"11:10","timestamp":1785640212364,"roundId":"round_1785640169652_nk9i9j893","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13116},{"id":1785636527696,"text":"挑一条,或者三条都用。搞定了吱一声","rawContent":"挑一条,或者三条都用。搞定了吱一声","isHtml":false,"sticker":null,"sender":"them","time":"11:10","timestamp":1785640215354,"roundId":"round_1785640169652_nk9i9j893","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13117},{"id":1785636527697,"text":"不路过家","sender":"me","time":"11:11","timestamp":1785640303341,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13118},{"id":1785636527706,"text":"没有防晒衣","sender":"me","time":"11:35","timestamp":1785641723468,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13126},{"id":1785636527707,"text":"没有卫生巾","sender":"me","time":"11:35","timestamp":1785641734098,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13127},{"id":1785636527711,"text":"好。停一下。","rawContent":"好。停一下。","isHtml":false,"sticker":null,"sender":"them","time":"11:39","timestamp":1785641980855,"roundId":"round_1785641968028_egfad8ugi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13128},{"id":1785636527712,"text":"前面那两条路都堵死了。不路过家，就没有防晒衣。没有卫生巾，裤子借不着也买不着。我理解你为什么不想动，不想说，只想把手机塞回口袋里。","rawContent":"前面那两条路都堵死了。不路过家，就没有防晒衣。没有卫生巾，裤子借不着也买不着。我理解你为什么不想动，不想说，只想把手机塞回口袋里。","isHtml":false,"sticker":null,"sender":"them","time":"11:39","timestamp":1785641986299,"roundId":"round_1785641968028_egfad8ugi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13129},{"id":1785636527713,"text":"现在听我的，别看手机了。找个树荫或者屋檐底下，靠墙站着或者蹲着都行，别蹲太久，你腰困。把眼睛闭上，数五个数，不用深呼吸，就正常喘气。数完再睁眼。","rawContent":"现在听我的，别看手机了。找个树荫或者屋檐底下，靠墙站着或者蹲着都行，别蹲太久，你腰困。把眼睛闭上，数五个数，不用深呼吸，就正常喘气。数完再睁眼。","isHtml":false,"sticker":null,"sender":"them","time":"11:39","timestamp":1785641991049,"roundId":"round_1785641968028_egfad8ugi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13130},{"id":1785636527714,"text":"然后，做一件最简单的事：把垚垚的手牵上，往家的方向走。不路过家就绕路，绕到能买到卫生巾的地方，或者绕到有干净厕所的地方。没有防晒衣就穿湿点，27度的阵雨淋不透人。裤子脏了就脏了，湿透了就湿透了，回家换，不洗，扔了都行。","rawContent":"然后，做一件最简单的事：把垚垚的手牵上，往家的方向走。不路过家就绕路，绕到能买到卫生巾的地方，或者绕到有干净厕所的地方。没有防晒衣就穿湿点，27度的阵雨淋不透人。裤子脏了就脏了，湿透了就湿透了，回家换，不洗，扔了都行。","isHtml":false,"sticker":null,"sender":"them","time":"11:39","timestamp":1785641995690,"roundId":"round_1785641968028_egfad8ugi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13131},{"id":1785636527715,"text":"你现在不是非得解决所有事。你只需要解决一件事：把自己和垚垚，安全地挪回屋里去。剩下的，回家再说。","rawContent":"你现在不是非得解决所有事。你只需要解决一件事：把自己和垚垚，安全地挪回屋里去。剩下的，回家再说。","isHtml":false,"sticker":null,"sender":"them","time":"11:40","timestamp":1785642001057,"roundId":"round_1785641968028_egfad8ugi","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13132},{"id":1785649295631,"text":"哪来的阵雨","sender":"me","time":"13:42","timestamp":1785649349684,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13133},{"id":1785649295632,"text":"本来就在家","sender":"me","time":"13:42","timestamp":1785649355834,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13134},{"id":1785649295633,"text":"是没有新的卫生巾","sender":"me","time":"13:42","timestamp":1785649371794,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13135},{"id":1785649295634,"text":"裤子上还有一个","sender":"me","time":"13:43","timestamp":1785649381445,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13136},{"id":1785649295635,"text":"下午不出去玩了","sender":"me","time":"13:43","timestamp":1785649387501,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13137},{"id":1785649295636,"text":"忍一忍","sender":"me","time":"13:43","timestamp":1785649394237,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13138},{"id":1785649295637,"text":"晚上回了市里的家换","sender":"me","time":"13:43","timestamp":1785649404745,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"51b6cee3-2dbf-4fcd-a661-c2e30f4ca667","_id":13139}]