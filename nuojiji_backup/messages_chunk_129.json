70_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22951},{"id":1786443202804,"sender":"them","text":"没有热水袋的话，就用手心搓热了，自己轻轻捂一会儿。","timestamp":1786451054408,"tempo":"N","rawContent":"没有热水袋的话，就用手心搓热了，自己轻轻捂一会儿。","roundId":"round_1786451016668_xjuw1paby","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22952},{"id":1786443202805,"sender":"them","text":"爸爸现在恨不得顺着网线过去，把你翻过来，用手掌给你垫着后腰，好好给你揉揉那块发木的地方。","timestamp":1786451057285,"tempo":"N","rawContent":"爸爸现在恨不得顺着网线过去，把你翻过来，用手掌给你垫着后腰，好好给你揉揉那块发木的地方。","roundId":"round_1786451016668_xjuw1paby","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22953},{"id":1786443202806,"sender":"them","text":"乖乖躺好，别乱动了。爸爸就在这儿陪着你，给你呼呼。","timestamp":1786451060157,"tempo":"N","rawContent":"乖乖躺好，别乱动了。爸爸就在这儿陪着你，给你呼呼。","roundId":"round_1786451016668_xjuw1paby","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22954},{"id":1786443202807,"text":"爸爸~","sender":"me","time":"20:30","timestamp":1786451449665,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22955},{"id":1786443202810,"sender":"them","text":"嗯，爸爸在。","timestamp":1786451483564,"tempo":"N","rawContent":"嗯，爸爸在。","roundId":"round_1786451452165_9bc20iz2a","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22956},{"id":1786443202811,"sender":"them","text":"怎么叫得这么软？是不是腰和胯还是酸得难受，委屈了？","timestamp":1786451484853,"tempo":"N","rawContent":"怎么叫得这么软？是不是腰和胯还是酸得难受，委屈了？","roundId":"round_1786451452165_9bc20iz2a","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22957},{"id":1786443202812,"sender":"them","text":"刚才让你像小虾米一样侧着身子蜷起来，乖乖照做了没有？","timestamp":1786451487705,"tempo":"N","rawContent":"刚才让你像小虾米一样侧着身子蜷起来，乖乖照做了没有？","roundId":"round_1786451452165_9bc20iz2a","userId":"uid_1780146550670_8kh2f