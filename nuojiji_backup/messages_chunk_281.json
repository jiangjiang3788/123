icker":null,"sender":"them","time":"08:31","timestamp":1787358671752,"roundId":"round_1787358649002_h1hnohzb8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32668},{"id":1787357941721,"text":"外面现在二十一度，气温有点凉，记得加件外套再出门。","rawContent":"外面现在二十一度，气温有点凉，记得加件外套再出门。","isHtml":false,"sticker":null,"sender":"them","time":"08:31","timestamp":1787358671918,"roundId":"round_1787358649002_h1hnohzb8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32669},{"id":1787357941722,"text":"去买点热气腾腾的东西，把你那个空了一早上的胃好好填暖和。","rawContent":"去买点热气腾腾的东西，把你那个空了一早上的胃好好填暖和。","isHtml":false,"sticker":null,"sender":"them","time":"08:31","timestamp":1787358672185,"roundId":"round_1787358649002_h1hnohzb8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32670},{"id":1787357941723,"text":"不用赶时间，路上慢慢走。","rawContent":"不用赶时间，路上慢慢走。","isHtml":false,"sticker":null,"sender":"them","time":"08:31","timestamp":1787358674887,"roundId":"round_1787358649002_h1hnohzb8","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32671},{"id":1787357941724,"text":"[圖片]","sender":"me","time":"08:42","timestamp":1787359375937,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32672,"imageRef":39},{"id":1787357941725,"text":"来吃这个粥本来是来吃饭团的","sender":"me","time":"08:43","timestamp":1787359409044,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32673},{"id":1787357941726,"text":"结果没有饭团了","sender":"me","time":"08:43","timestamp":1787359416691,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":32674},{"id":178735