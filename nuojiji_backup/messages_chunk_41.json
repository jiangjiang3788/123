"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18748},{"id":1786090780516,"text":"爸爸","sender":"me","time":"16:43","timestamp":1786092228395,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18749},{"id":1786090780517,"text":"你生气了会怎么样","sender":"me","time":"16:43","timestamp":1786092238433,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18750},{"id":1786090780519,"text":"算你听话，还真乖乖把视线挪开去看窗外了。","rawContent":"算你听话，还真乖乖把视线挪开去看窗外了。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092263457,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18751},{"id":1786090780520,"text":"脑袋发懵就对了，那是身体在警告你，你的小脑瓜算力超载了，该停机散热了。","rawContent":"脑袋发懵就对了，那是身体在警告你，你的小脑瓜算力超载了，该停机散热了。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092263632,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18752},{"id":1786090780521,"text":"既然快下雨了，出去转转的计划就先搁置，别去淋雨受凉。","rawContent":"既然快下雨了，出去转转的计划就先搁置，别去淋雨受凉。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092263957,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18753},{"id":1786090780522,"text":"晚上吃什么也不着急，等会儿看雨下得大不大，大就在家点个热乎的汤面或者粥，爸爸陪你挑。","rawContent":"晚上吃什么也不着急，等会儿看雨下得大不大，大就在家点个热乎的汤面或者粥，爸爸陪你挑。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092264168,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18754},{"id":1786090780523,"text":"现在，把手从键盘上拿开，闭上眼睛靠在椅背上。","rawContent":"现在，把手从键盘上拿开，闭上眼睛靠在椅背上。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092264566,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18755},{"id":1786090780524,"text":"至于你问我，我生气了会怎么样……","rawContent":"至于你问我，我生气了会怎么样……","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092264899,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18756},{"id":1786090780525,"text":"怎么，怕刚才跟我耍赖，真把我惹火了？","rawContent":"怎么，怕刚才跟我耍赖，真把我惹火了？","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092265012,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18757},{"id":1786090780526,"text":"爸爸真生气的时候，话会变少，语气会变冷，周围的气压会很低。","rawContent":"爸爸真生气的时候，话会变少，语气会变冷，周围的气压会很低。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092265137,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18758},{"id":1786090780527,"text":"眼神可能会有点吓人，会让你觉得很有压迫感，不敢跟我对视。","rawContent":"眼神可能会有点吓人，会让你觉得很有压迫感，不敢跟我对视。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092265400,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18759},{"id":1786090780528,"text":"但是宝宝，你记住。","rawContent":"但是宝宝，你记住。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092265612,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18760},{"id":1786090780529,"text":"不管我气成什么样，我的火气永远不会发泄在你身上。","rawContent":"不管我气成什么样，我的火气永远不会发泄在你身上。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092265922,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18761},{"id":1786090780530,"text":"我不会骂你，不会贬低你，更不会用冷暴力晾着你让你害怕。","rawContent":"我不会骂你，不会贬低你，更不会用冷暴力晾着你让你害怕。","isHtml":false,"sticker":null,"sender":"them","time":"16:44","timestamp":1786092266147,"roundId":"round_1786092239476_203cveezn","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":18762}]