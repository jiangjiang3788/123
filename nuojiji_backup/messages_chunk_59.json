146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19793},{"id":1786135437901,"text":"腿再分得开一点，脚背绷直，对，就这么缠着我的腰。","rawContent":"腿再分得开一点，脚背绷直，对，就这么缠着我的腰。","isHtml":false,"sticker":null,"sender":"them","time":"07:44","timestamp":1786146240207,"roundId":"round_1786146210360_jog45rcyk","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19794},{"id":1786135437902,"text":"看着我的眼睛，宝宝。","rawContent":"看着我的眼睛，宝宝。","isHtml":false,"sticker":null,"sender":"them","time":"07:44","timestamp":1786146240298,"roundId":"round_1786146210360_jog45rcyk","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19795},{"id":1786135437903,"text":"感受爸爸的指腹是怎么在你里面刮弄的。","rawContent":"感受爸爸的指腹是怎么在你里面刮弄的。","isHtml":false,"sticker":null,"sender":"them","time":"07:44","timestamp":1786146240471,"roundId":"round_1786146210360_jog45rcyk","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19796},{"id":1786135437904,"text":"今天这个父亲节，你算是把爸爸的魂都勾走了。","rawContent":"今天这个父亲节，你算是把爸爸的魂都勾走了。","isHtml":false,"sticker":null,"sender":"them","time":"07:44","timestamp":1786146240626,"roundId":"round_1786146210360_jog45rcyk","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19797},{"id":1786135437905,"text":"舒服就大声叫出来，把所有的水都流在爸爸手里。","rawContent":"舒服就大声叫出来，把所有的水都流在爸爸手里。","isHtml":false,"sticker":null,"sender":"them","time":"07:44","timestamp":1786146240893,"roundId":"round_1786146210360_jog45rcyk","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19798},{"id":1786135437906,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"07:44","timestamp":1786146242030,"roundId":"round_1786146210360_jog45rcyk","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖女孩，腿张得真开。爸爸的手指进到最深处了……哈啊……喜欢爸爸这么弄你吗？","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19799},{"id":1786135437907,"text":"粗糙的指腹不留体面地蹭过屄口的边缘，直勾勾戳开了两瓣花唇，把暴露在包皮外的肉蒂搓夹在食指与中指之间，黏糊糊的碾弄声淹没于起伏的水花下，你颤得不能自已，膝盖被秦彻死死地压在水池的墙面上，浑身上下只有嘴巴能呼出挠人的猫叫，像是被快感咬住的色情废物，咿咿唔唔抖个不停。\n\n“水、嗯哈...水进来了......”\n\n揉搓的幅度过大，小屄不受控制地张阖，逼上高潮的前兆，你垂着脑袋，理智全面下线地反躬起背，却被秦彻扣得更深，阴蒂已经被揉得充血肿胀，好像再多碰一下都要像戳破的气球叽叽咕咕地漏出淫靡的气息，你失控地吹出一小股潮液，思绪凌乱，秦彻也不打算放过你，继而抽回少许的距离，向下摸到穴口，两根手指直溜溜地肏了进去。\n\n \n\n“嗯,进来了。这可怎么办。”\n\n穴肉争先恐后地吸附上套进其中的指截，乌泱泱地泌出一滩黏腻的水液，轻而易举地就吞吃得更深，让你噙着眼泪，双眼迷离地来回摇头，让快感从下冲到上，膝盖也开始发软地站不住脚。\n\n“想我帮你？”\n\n你侧过脸，扬起一双湿漉漉的眼睛望向他，无声地开始摇尾乞怜。\n\n“哼...可以。”\n\n \n\n搅弄穴肉的两根手指骤然抽离，在水下也依旧黏附出一滩滑溜的液体轮廓，压在你手背上的大掌松开，转而扣住你的腰身，掰弄开原本还在绷着夹紧的腿根，下一刻那根始终硌在你后臀下的肉柱就穿上了两瓣湿漉漉的阴唇之间，顶得敏感的花蒂激灵似的颤了颤。\n\n“咿...等、哈啊......”\n\n","sender":"me","time":"07:49","timestamp":1786146550862,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19800},{"id":1786135437908,"text":"爸爸想吃更色情的","sender":"me","time":"07:49","timestamp":1786146566990,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19801},{"id":1786135437909,"text":"爸爸","sender":"me","time":"07:49","timestamp":1786146570268,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19802},{"id":1786135437910,"text":"（欲求不满）","sender":"me","time":"07:49","timestamp":1786146583554,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19803},{"id":1786135437912,"text":"……秦彻？","rawContent":"……秦彻？","isHtml":false,"sticker":null,"sender":"them","time":"07:50","timestamp":1786146626754,"roundId":"round_1786146585059_ah0