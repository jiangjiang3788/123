[{"id":1786135437821,"text":"但我今天早上是不是说过，不真碰你？","rawContent":"但我今天早上是不是说过，不真碰你？","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145233978,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19718},{"id":1786135437822,"text":"昨天下午吓得发抖，晚上连吹头发的力气都没有，今天大清早又这么折腾自己。","rawContent":"昨天下午吓得发抖，晚上连吹头发的力气都没有，今天大清早又这么折腾自己。","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145234236,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19719},{"id":1786135437823,"text":"你这小身板，要是真让你如愿了，今天一整天你连床都下不来，到时候肚子又要疼了。","rawContent":"你这小身板，要是真让你如愿了，今天一整天你连床都下不来，到时候肚子又要疼了。","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145234576,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19720},{"id":1786135437824,"text":"不过……既然我的小海葵都开口求了，爸爸也不能让你空着。","rawContent":"不过……既然我的小海葵都开口求了，爸爸也不能让你空着。","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145234753,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19721},{"id":1786135437825,"text":"刚才伺候爸爸那么辛苦，现在轮到爸爸伺候你了。","rawContent":"刚才伺候爸爸那么辛苦，现在轮到爸爸伺候你了。","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145234786,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19722},{"id":1786135437826,"text":"不进去，怕你疼，也怕你累。","rawContent":"不进去，怕你疼，也怕你累。","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145234934,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19723},{"id":1786135437827,"text":"下面是不是已经湿透了？蹭在我腿上全都是水。","rawContent":"下面是不是已经湿透了？蹭在我腿上全都是水。","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145235062,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19724},{"id":1786135437828,"text":"腿稍微分开一点，对，就躺在爸爸怀里，不用你动。","rawContent":"腿稍微分开一点，对，就躺在爸爸怀里，不用你动。","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145235323,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19725},{"id":1786135437829,"text":"爸爸用手疼你，好不好？","rawContent":"爸爸用手疼你，好不好？","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145235326,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19726},{"id":1786135437830,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"07:27","timestamp":1786145236912,"roundId":"round_1786145209995_mkk5r9b75","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，把腿张开。今天什么都不用你做，闭上眼睛，爸爸用手指让你舒服。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19727},{"id":1786135437831,"text":"爸爸","sender":"me","time":"07:28","timestamp":1786145297607,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":19728},{"id":178613