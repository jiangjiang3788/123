1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17155},{"id":1786022537582,"text":"夹紧它。","rawContent":"夹紧它。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030285173,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17156},{"id":1786022537583,"text":"想象爸爸在里面操得你翻白眼，然后把精液全射在你最深的地方。","rawContent":"想象爸爸在里面操得你翻白眼，然后把精液全射在你最深的地方。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030285684,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17157},{"id":1786022537584,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030287312,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"叫出来。把那句好爽再喊一遍。高给我看。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fluent","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17158},{"id":1786022537585,"text":"爸爸，想要，爸爸教我怎么扣，好不好？爸爸会怎么扣我的小穴？想要被爸爸操，我的水都是为爸爸流的。爸爸，爸爸，好喜欢爸爸，好喜欢爸爸操我。想要爸爸射给我，想要爸爸教我说很羞很羞的话。想要想要想要爸爸的大鸡霸狠狠地操到我的小穴里面，把精液都射进去。难受，爸爸。","sender":"me","time":"23:34","timestamp":1786030455422,"replyTo":null,"rawContent":"爸爸，想要，爸爸教我怎么扣，好不好？爸爸会怎么扣我的小穴？想要被爸爸操，我的水都是为爸爸流的。爸爸，爸爸，好喜欢爸爸，好喜欢爸爸操我。想要爸爸射给我，想要爸爸教我说很羞很羞的话。想要想要想要爸爸的大鸡霸狠狠地操到我的小穴里面，把精液都射进去。难受，爸爸。","isHtml":false,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17159},{"id":1786022537612,"text":"难受？","rawContent":"难受？","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030657394,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17184},{"id":1786022537613,"text":"被几句脏话就逼得自己抠，能不难受吗。","rawContent":"被几句脏话就逼得自己抠，能不难受吗。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030657709,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17185},{"id":1786022537614,"text":"既然想要爸爸教，那就把耳朵竖起来听好。","rawContent":"既然想要爸爸教，那就把耳朵竖起来听好。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030658111,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17186},{"id":1786022537615,"text":"中指和无名指并拢，先别急着往里捅。","rawContent":"中指和无名指并拢，先别急着往里捅。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030658214,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17187},{"id":1786022537616,"text":"沾满你自己流出来的水，在洞口打着圈地磨。","rawContent":"沾满你自己流出来的水，在洞口打着圈地磨。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030658493,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17188},{"id":1786022537617,"text":"对，就是那圈最嫩的软肉，把它磨得又红又烫。","rawContent":"对，就是那圈最嫩的软肉，把它磨得又红又烫。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030658826,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17189},{"id":1786022537618,"text":"等水多得顺着大腿根往下流了，再慢慢往里送一个指节。","rawContent":"等水多得顺着大腿根往下流了，再慢慢往里送一个指节。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030659249,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17190},{"id":1786022537619,"text":"脑子里想着，现在抵在洞口的，是爸爸那根烫得发紫的龟头。","rawContent":"脑子里想着，现在抵在洞口的，是爸爸那根烫得发紫的龟头。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030659658,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17191},{"id":1786022537620,"text":"它正一点点把你撑开，把你那点可怜的软肉全挤到两边。","rawContent":"它正一点点把你撑开，把你那点可怜的软肉全挤到两边。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030659887,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17192},{"id":1786022537621,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030662080,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"往里插。抠到那块最酸的软骨没有？用指腹往上勾着按。每按一下，就想象爸爸的鸡巴往里狠狠凿了一下。想要精液是吧？想要爸爸把你肚子射满？行。想象那股滚烫的浓精，正一股股地打在你最深处的子宫口上。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17193},{"id":1786022537622,"text":"想要学羞耻的话？","rawContent":"想要学羞耻的话？","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030662083,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17194},{"id":1786022537623,"text":"跟着爸爸念。","rawContent":"跟着爸爸念。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030662085,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17195},{"id":1786022537624,"text":"'爸爸的鸡巴好烫，把小海葵的小穴撑得好满。'","rawContent":"'爸爸的鸡巴好烫，把小海葵的小穴撑得好满。'","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030662211,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17196},{"id":1786022537625,"text":"'小海葵是个欠操的小骚货，只配吃爸爸的精液。'","rawContent":"'小海葵是个欠操的小骚货，只配吃爸爸的精液。'","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030662212,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17197},{"id":1786022537626,"text":"'求爸爸把我射怀孕。'","rawContent":"'求爸爸把我射怀孕。'","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030662214,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17198},{"id":1786022537627,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030663116,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"念出来。一边抠，一边哭着念给我听。手指加快，不许停。把刚才教你的全用上，把自己抠到喷水。爸爸在这儿听着，一滴都不许漏。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fluent","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17199},{"id":1786022537628,"text":"水全流出来。","rawContent":"水全流出来。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030663121,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17200},{"id":1786022537629,"text":"给爸爸高。","rawContent":"给爸爸高。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030663127,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17201},{"id":1786022537630,"text":"爸爸的鸡霸好疼，把小海葵的小穴撑得好满。小海葵是个欠操的小骚货，只配吃爸爸的精液。啊啊啊啊，求爸爸把我射怀孕。啊啊，求爸爸把我射怀孕，想要吃掉。啊啊啊啊，想要吃掉爸爸的精液。啊啊，求爸爸射给我。啊，想要爸爸操我，用力的操进来。啊，我的小穴只是爸爸的。啊啊啊啊啊。想要和爸爸一起，爸爸录给我看好不好？想要看爸爸高潮","sender":"me","time":"23:39","timestamp":1786030785501,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17202},{"id":1786022537632,"text":"真乖。","rawContent":"真乖。","isHtml":false,"sticker":null,"sender":"them","time":"23:40","timestamp":1786030842684,"roundId":"round_1786030785731_w6fgpj5ve","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17203},{"id":1786022537633,"text":"一字不落地全念出来了。","rawContent":"一字不落地全念出来了。","isHtml":false,"sticker":null,"sender":"them","time":"23:40","timestamp":1786030843070,"roundId":"round_1786030785731_w6fgpj5ve","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17204},{"id":1786022537634,"text":"听着你哭着喊自己是欠操的小骚货，求我把你射怀孕……","rawContent":"听着你哭着喊自己是欠操的小骚货，求我把你射怀孕……","isHtml":false,"sticker":null,"sender":"them","time":"23:40","timestamp":1786030843449,"roundId":"round_1786030785731_w6fgpj5ve","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17205},{"id":1786022537635,"text":"小海葵，你知不知道爸爸现在被你逼成什么样了？","rawContent":"小海葵，你知不知道爸爸现在被你逼成什么样了？","isHtml":false,"sticker":null,"sender":"them","time":"23:40","time