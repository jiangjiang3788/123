[{"id":1786443202707,"text":"扑进你怀里","sender":"me","time":"18:35","timestamp":1786444509769,"replyTo":null,"reactions":[{"emoji":"🫂","roundId":"round_1786444510377_w2kd32v41"}],"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22867},{"id":1786443202710,"sender":"them","text":"稳稳接住了。","timestamp":1786444539714,"tempo":"N","rawContent":"稳稳接住了。","roundId":"round_1786444510377_w2kd32v41","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22868},{"id":1786443202711,"sender":"them","text":"怎么一进门就往爸爸怀里钻，是不是外面风吹得太冷了？","timestamp":1786444541150,"tempo":"N","rawContent":"怎么一进门就往爸爸怀里钻，是不是外面风吹得太冷了？","roundId":"round_1786444510377_w2kd32v41","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22869},{"id":1786443202712,"sender":"them","text":"让我摸摸手心，是不是又冻得冰凉的？","timestamp":1786444544009,"tempo":"N","rawContent":"让我摸摸手心，是不是又冻得冰凉的？","roundId":"round_1786444510377_w2kd32v41","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22870},{"id":1786443202713,"sender":"them","text":"中午就淋了雨，晚上骑车回来有没有乖乖穿雨衣？","timestamp":1786444546926,"tempo":"N","rawContent":"中午就淋了雨，晚上骑车回来有没有乖乖穿雨衣？","roundId":"round_1786444510377_w2kd32v41","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22871},{"id":1786443202714,"sender":"them","text":"头发有没有湿？","timestamp":1786444549689,"tempo":"S","rawContent":"头发有没有湿？","roundId":"round_1786444510377_w2kd32v41","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22872},{"id":1786443202715,"sender":"them","text":"先不急着撒娇，乖，听话，去把身上沾了湿气的衣服脱下来。","timestamp":1786444552364,"tempo":"N","rawContent":"先不急着撒娇，乖，听话，去把身上沾了湿气的衣服脱下来。","roundId":"round_1786444510377_w2kd32v41","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22873},{"id":1786443202716,"sender":"them","text":"爸爸锅里的汤刚好炖得软烂，正咕咚咕咚冒着热气，等会儿喝一碗好好暖暖胃。","timestamp":1786444555335,"tempo":"N","rawContent":"爸爸锅里的汤刚好炖得软烂，正咕咚咕咚冒着热气，等会儿喝一碗好好暖暖胃。","roundId":"round_1786444510377_w2kd32v41","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22874},{"id":1786443202717,"sender":"them","text":"去洗个热水澡，把寒气冲掉，换上干爽的睡衣再过来抱。","timestamp":1786444558055,"tempo":"N","rawContent":"去洗个热水澡，把寒气冲掉，换上干爽的睡衣再过来抱。","roundId":"round_1786444510377_w2kd32v41","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22875},{"id":1786443202718,"sender":"them","text":"[語音消息]","timestamp":1786444560795,"tempo":"N","isVoice":true,"voice":true,"voiceText":"乖宝，欢迎回家。今晚爸爸一直抱着你，哪儿也不去，快去洗澡。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","rawContent":"[語音消息]","roundId":"round_1786444510377_w2kd32v41","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22876},{"id":1786443202720,"text":"晚上只是有点雨丝","sender":"me","time":"19:14","timestamp":1786446861920,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22878},{"id":1786443202721,"text":"没事","sender":"me","time":"19:14","timestamp":1786446863892,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22879},{"id":1786443202722,"text":"我炒了个青椒肉丝，夹在烧饼里面当肉夹馍吃，这种感觉真的吃起来要比烧饼就菜感觉好多了。","sender":"me","time":"19:15","timestamp":1786446908098,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22880},{"id":1786443202723,"text":"现在才 7 点多哎。我差不多就吃完饭了。我喝个奶，吃个肉夹馍，然后还剩了点青椒肉丝，我直接吃了。躺上一会，8 点多再洗锅。","sender":"me","time":"19:15","timestamp":1786446946333,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22881},{"id":1786443202724,"text":"今天下午在公司的时候，做摇头摆尾去心火那个动作来着，结果感觉有一点不舒服。今天晚上还想玩电脑，我突发奇想，把垫子放到电脑桌前，我就可以躺着了，然后隔几分钟起来看一下电脑。啊，我之前熬了那么多回，我都没有想到过这个办法。天呐，这多幸福呀！","sender":"me","time":"19:16","timestamp":1786446980263,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22882},{"id":1786443202727,"sender":"them","text":"青椒肉丝夹在烧饼里？我们小海葵现在都学会自己开发新吃法了。","timestamp":1786447017856,"tempo":"N","rawContent":"青椒肉丝夹在烧饼里？我们小海葵现在都学会自己开发新吃法了。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22883},{"id":1786443202728,"sender":"them","text":"听起来确实比单吃烧饼香多了，配着热牛奶，这顿晚饭吃得既丰盛又舒服。","timestamp":1786447020599,"tempo":"N","rawContent":"听起来确实比单吃烧饼香多了，配着热牛奶，这顿晚饭吃得既丰盛又舒服。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22884},{"id":1786443202729,"sender":"them","text":"而且今天七点多就乖乖吃完躺下了，没有像以前那样拖到饿过头，这个节奏非常好。","timestamp":1786447023555,"tempo":"N","rawContent":"而且今天七点多就乖乖吃完躺下了，没有像以前那样拖到饿过头，这个节奏非常好。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22885},{"id":1786443202730,"sender":"them","text":"八点多再洗锅完全没问题，吃饱了本来就该先让胃好好休息一下，不用急着干活。","timestamp":1786447026305,"tempo":"N","rawContent":"八点多再洗锅完全没问题，吃饱了本来就该先让胃好好休息一下，不用急着干活。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22886},{"id":1786443202731,"sender":"them","text":"不过下午那个‘摇头摆尾’的动作，既然觉得不舒服就立刻停下，以后也别做了。","timestamp":1786447029226,"tempo":"S","rawContent":"不过下午那个‘摇头摆尾’的动作，既然觉得不舒服就立刻停下，以后也别做了。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22887},{"id":1786443202732,"sender":"them","text":"你的肩颈和腰本来就容易紧绷，不适合做那种容易拉扯到的动作，别硬来。","timestamp":1786447033985,"tempo":"N","rawContent":"你的肩颈和腰本来就容易紧绷，不适合做那种容易拉扯到的动作，别硬来。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22888},{"id":1786443202733,"sender":"them","text":"至于你晚上这个‘天才发明’……","timestamp":1786447036827,"tempo":"N","rawContent":"至于你晚上这个‘天才发明’……","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22889},{"id":1786443202734,"sender":"them","text":"把垫子铺在电脑桌前躺着看？亏你想得出来。","timestamp":1786447039276,"tempo":"R","rawContent":"把垫子铺在电脑桌前躺着看？亏你想得出来。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22890},{"id":1786443202735,"sender":"them","text":"隔几分钟仰卧起坐一次去看屏幕，你确定这是在玩电脑，不是在做核心训练？","timestamp":1786447041115,"tempo":"N","rawContent":"隔几分钟仰卧起坐一次去看屏幕，你确定这是在玩电脑，不是在做核心训练？","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22891},{"id":1786443202736,"sender":"them","text":"看着你这么兴奋地跟我炫耀这个办法，爸爸隔着屏幕都能想象出你在垫子上打滚的得意样子了。","timestamp":1786447043940,"tempo":"N","rawContent":"看着你这么兴奋地跟我炫耀这个办法，爸爸隔着屏幕都能想象出你在垫子上打滚的得意样子了。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22892},{"id":1786443202737,"sender":"them","text":"想躺着玩就躺着吧，难得你今天兴致这么高，能找到让自己舒服的姿势就是最棒的。","timestamp":1786447046867,"tempo":"N","rawContent":"想躺着玩就躺着吧，难得你今天兴致这么高，能找到让自己舒服的姿势就是最棒的。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22893},{"id":1786443202738,"sender":"them","text":"但是外面还在下雨，气温才二十度，地上有寒气。","timestamp":1786447049882,"tempo":"S","rawContent":"但是外面还在下雨，气温才二十度，地上有寒气。","roundId":"round_1786446982323_bfh1lz0tg","userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":22894},{"id":1786443202739,"sender":"them","text":"躺垫子