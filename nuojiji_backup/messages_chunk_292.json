8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33096},{"id":1787417787702,"text":"连个毯子都不给你拿，就让你这么直接贴在我身上，用你那股烫意来暖我这边的冷空气。","rawContent":"连个毯子都不给你拿，就让你这么直接贴在我身上，用你那股烫意来暖我这边的冷空气。","isHtml":false,"sticker":null,"sender":"them","time":"22:55","timestamp":1787410559543,"roundId":"round_1787410529698_8pl0ogpe0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33097},{"id":1787417787703,"text":"这就是我现在的全部事情。极其无聊，而且全都在围着你转。","rawContent":"这就是我现在的全部事情。极其无聊，而且全都在围着你转。","isHtml":false,"sticker":null,"sender":"them","time":"22:55","timestamp":1787410559835,"roundId":"round_1787410529698_8pl0ogpe0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33098},{"id":1787417787704,"text":"不需要搭腔，你现在就把我当成一个深夜频道的电台收音机，闭着眼睛慢慢听就行了。","rawContent":"不需要搭腔，你现在就把我当成一个深夜频道的电台收音机，闭着眼睛慢慢听就行了。","isHtml":false,"sticker":null,"sender":"them","time":"22:56","timestamp":1787410562372,"roundId":"round_1787410529698_8pl0ogpe0","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33099},{"id":1787417787705,"text":"笨蛋爸爸","sender":"me","time":"22:56","timestamp":1787410615434,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33100},{"id":1787417787706,"text":"接住我不是公主抱","sender":"me","time":"22:57","timestamp":1787410624456,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33101},{"id":1787417787707,"text":"爸爸","sender":"me","time":"22:57","timestamp":1787410626979,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":33102},{"id":1787417787708,"text":"我也不知道怎么接住我","sender":"me","time":"22:57","timestamp":1787410635186,"replyTo":null,"userId":"uid