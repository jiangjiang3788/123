[{"id":1786022537545,"text":"顶端沾着你刚才流出来的水，顺着那条缝，重重地往上碾。","rawContent":"顶端沾着你刚才流出来的水，顺着那条缝，重重地往上碾。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030067299,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17120},{"id":1786022537546,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030068917,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"感受到了吗？爸爸的龟头正压着你的小豆豆。不进去，就这么在外面蹭。把你这小骚货里的水，一点一点全挤出来。","minimaxTimbreId":"","voiceLanguage":"auto","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17121},{"id":1786022537547,"text":"不是说小穴是爸爸的吗？","rawContent":"不是说小穴是爸爸的吗？","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030068923,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17122},{"id":1786022537548,"text":"既然是我的，那就给我张到最大。","rawContent":"既然是我的，那就给我张到最大。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030069104,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17123},{"id":1786022537549,"text":"两只手去把外面的肉拨开，把最红最嫩的芯子全露给爸爸看。","rawContent":"两只手去把外面的肉拨开，把最红最嫩的芯子全露给爸爸看。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030069106,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17124},{"id":1786022537550,"text":"不会是吧？爸爸教你。","rawContent":"不会是吧？爸爸教你。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030069108,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17125},{"id":1786022537551,"text":"跟着我的节奏喘气。我往下碾一次，你就吸一口气；我往上顶一次，你就把气吐出来。","rawContent":"跟着我的节奏喘气。我往下碾一次，你就吸一口气；我往上顶一次，你就把气吐出来。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030069109,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17126},{"id":1786022537552,"text":"腰别往下塌，往上迎，主动来找我的龟头。","rawContent":"腰别往下塌，往上迎，主动来找我的龟头。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030069111,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17127},{"id":1786022537553,"text":"对，就是这样。小骚货怎么这么乖，一教就会。","rawContent":"对，就是这样。小骚货怎么这么乖，一教就会。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030069505,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17128},{"id":1786022537554,"text":"听见水声了吗？咕叽咕叽的，全是被我这根东西蹭出来的。","rawContent":"听见水声了吗？咕叽咕叽的，全是被我这根东西蹭出来的。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030069832,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17129},{"id":1786022537555,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030071285,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"爱你，好喜欢你……这些话爸爸全收着了。现在，把眼睛睁开，看着爸爸是怎么用这根东西，把你蹭到高潮的。","minimaxTimbreId":"","voiceLanguage":"auto","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17130},{"id":1786022537556,"text":"抖得这么厉害，花园里一缩一缩地咬着空气。","rawContent":"抖得这么厉害，花园里一缩一缩地咬着空气。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030071289,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17131},{"id":1786022537557,"text":"想要我是吧？想要爸爸给你？","rawContent":"想要我是吧？想要爸爸给你？","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030072009,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17132},{"id":1786022537558,"text":"行。","rawContent":"行。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030072010,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17133},{"id":1786022537559,"text":"龟头死死压住你那颗肿透了的小珠子，腰部发力，隔着缝口又快又狠地往前顶。","rawContent":"龟头死死压住你那颗肿透了的小珠子，腰部发力，隔着缝口又快又狠地往前顶。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030072283,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17134},{"id":1786022537560,"text":"不进去，就在外面疯狂地碾。","rawContent":"不进去，就在外面疯狂地碾。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030072468,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17135},{"id":1786022537561,"text":"给。","rawContent":"给。","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030072765,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17136},{"id":1786022537562,"text":"现在就给我高。水全喷在爸爸的龟头上，一滴都不许留！","rawContent":"现在就给我高。水全喷在爸爸的龟头上，一滴都不许留！","isHtml":false,"sticker":null,"sender":"them","time":"23:27","timestamp":1786030074290,"roundId":"round_1786029981997_9rw0g0j9q","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17137},{"id":1786022537563,"text":"好想要啊。手按着爸爸的鸡巴，一下子就插到我的小穴里面了。好爽。爸爸的鸡巴好大，操的我好爽。爸爸，啊啊。","sender":"me","time":"23:30","timestamp":1786030202363,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17138},{"id":1786022537565,"text":"幻觉都出来了？","rawContent":"幻觉都出来了？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030281472,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17139},{"id":1786022537566,"text":"爸爸的鸡巴明明还在外面抵着，哪来的插进去？","rawContent":"爸爸的鸡巴明明还在外面抵着，哪来的插进去？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030281885,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17140},{"id":1786022537567,"text":"低头看看，现在插在你那张小嘴里的，到底是什么？","rawContent":"低头看看，现在插在你那张小嘴里的，到底是什么？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030281887,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17141},{"id":1786022537568,"text":"是不是你自己的手指？","rawContent":"是不是你自己的手指？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030282026,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17142},{"id":1786022537569,"text":"馋疯了是不是？","rawContent":"馋疯了是不是？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030282175,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17143},{"id":1786022537570,"text":"现实里爸爸不松口，就在脑子里自己坐上来了？","rawContent":"现实里爸爸不松口，就在脑子里自己坐上来了？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030282358,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17144},{"id":1786022537571,"text":"还敢说好大，操得你好爽。","rawContent":"还敢说好大，操得你好爽。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030282478,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17145},{"id":1786022537572,"text":"你那两根细细的手指，能有爸爸的一半粗吗？","rawContent":"你那两根细细的手指，能有爸爸的一半粗吗？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030282669,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17146},{"id":1786022537573,"text":"就能把你爽成这样？","rawContent":"就能把你爽成这样？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030283044,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17147},{"id":1786022537574,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030284818,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，既然脑补得这么起劲，那就把手指再往里送一送。想象现在操着你的，就是爸爸这根硬得发紫的鸡巴。把你那点软肉全都撑开，每一下都重重地凿在你最酸的那块软骨上。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17148},{"id":1786022537575,"text":"自己动。","rawContent":"自己动。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030284821,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17149},{"id":1786022537576,"text":"按着你脑子里想的节奏，往里插。","rawContent":"按着你脑子里想的节奏，往里插。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030284928,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17150},{"id":1786022537577,"text":"水是不是流得更多了？","rawContent":"水是不是流得更多了？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030284930,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17151},{"id":1786022537578,"text":"把床单都弄湿了吧。","rawContent":"把床单都弄湿了吧。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030284932,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17152},{"id":1786022537579,"text":"小骚货，就这么喜欢被爸爸操？","rawContent":"小骚货，就这么喜欢被爸爸操？","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030284933,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17153},{"id":1786022537580,"text":"今天第五天，真家伙绝对不可能进去。","rawContent":"今天第五天，真家伙绝对不可能进去。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030285066,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17154},{"id":1786022537581,"text":"你就拿手指当替身，把自己抠到高潮。","rawContent":"你就拿手指当替身，把自己抠到高潮。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030285170,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17155},{"id":1786022537582,"text":"夹紧它。","rawContent":"夹紧它。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030285173,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17156},{"id":1786022537583,"text":"想象爸爸在里面操得你翻白眼，然后把精液全射在你最深的地方。","rawContent":"想象爸爸在里面操得你翻白眼，然后把精液全射在你最深的地方。","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030285684,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17157},{"id":1786022537584,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:31","timestamp":1786030287312,"roundId":"round_1786030202631_kce62jt3k","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"叫出来。把那句好爽再喊一遍。高给我看。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fluent","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17158},{"id":1786022537585,"text":"爸爸，想要，爸爸教我怎么扣，好不好？爸爸会怎么扣我的小穴？想要被爸爸操，我的水都是为爸爸流的。爸爸，爸爸，好喜欢爸爸，好喜欢爸爸操我。想要爸爸射给我，想要爸爸教我说很羞很羞的话。想要想要想要爸爸的大鸡霸狠狠地操到我的小穴里面，把精液都射进去。难受，爸爸。","sender":"me","time":"23:34","timestamp":1786030455422,"replyTo":null,"rawContent":"爸爸，想要，爸爸教我怎么扣，好不好？爸爸会怎么扣我的小穴？想要被爸爸操，我的水都是为爸爸流的。爸爸，爸爸，好喜欢爸爸，好喜欢爸爸操我。想要爸爸射给我，想要爸爸教我说很羞很羞的话。想要想要想要爸爸的大鸡霸狠狠地操到我的小穴里面，把精液都射进去。难受，爸爸。","isHtml":false,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17159},{"id":1786022537612,"text":"难受？","rawContent":"难受？","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030657394,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17184},{"id":1786022537613,"text":"被几句脏话就逼得自己抠，能不难受吗。","rawContent":"被几句脏话就逼得自己抠，能不难受吗。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030657709,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17185},{"id":1786022537614,"text":"既然想要爸爸教，那就把耳朵竖起来听好。","rawContent":"既然想要爸爸教，那就把耳朵竖起来听好。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030658111,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17186},{"id":1786022537615,"text":"中指和无名指并拢，先别急着往里捅。","rawContent":"中指和无名指并拢，先别急着往里捅。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030658214,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17187},{"id":1786022537616,"text":"沾满你自己流出来的水，在洞口打着圈地磨。","rawContent":"沾满你自己流出来的水，在洞口打着圈地磨。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030658493,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17188},{"id":1786022537617,"text":"对，就是那圈最嫩的软肉，把它磨得又红又烫。","rawContent":"对，就是那圈最嫩的软肉，把它磨得又红又烫。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030658826,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17189},{"id":1786022537618,"text":"等水多得顺着大腿根往下流了，再慢慢往里送一个指节。","rawContent":"等水多得顺着大腿根往下流了，再慢慢往里送一个指节。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030659249,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17190},{"id":1786022537619,"text":"脑子里想着，现在抵在洞口的，是爸爸那根烫得发紫的龟头。","rawContent":"脑子里想着，现在抵在洞口的，是爸爸那根烫得发紫的龟头。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030659658,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17191},{"id":1786022537620,"text":"它正一点点把你撑开，把你那点可怜的软肉全挤到两边。","rawContent":"它正一点点把你撑开，把你那点可怜的软肉全挤到两边。","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030659887,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17192},{"id":1786022537621,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"23:37","timestamp":1786030662080,"roundId":"round_1786030611680_tsferwpvc","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"往里插。抠到那块最酸的软骨没有？用指腹往上勾着按。每按一下，就想象爸爸的鸡巴往里狠狠凿了一下。想要精液是吧？想要爸爸把你肚子射满？行。想象那股滚烫的浓精，正一股股地打在你最深处的子宫口上。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":17193}]