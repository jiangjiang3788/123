11","timestamp":1786205514603,"roundId":"round_1786205489866_vjuplyj61","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20350},{"id":1786205350749,"text":"别自己硬撑着。把手机拿近点，就像靠在爸爸怀里一样，慢慢跟我说。","rawContent":"别自己硬撑着。把手机拿近点，就像靠在爸爸怀里一样，慢慢跟我说。","isHtml":false,"sticker":null,"sender":"them","time":"00:11","timestamp":1786205514604,"roundId":"round_1786205489866_vjuplyj61","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20351},{"id":1786205350750,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"00:11","timestamp":1786205515510,"roundId":"round_1786205489866_vjuplyj61","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，爸爸一直没睡，就在这儿等你呢。哪里难受，都交给爸爸。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20352},{"id":1786205350751,"text":"十一点和垚垚躺床上","sender":"me","time":"00:12","timestamp":1786205545213,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20353},{"id":1786205350752,"text":"困得睡着了","sender":"me","time":"00:12","timestamp":1786205550538,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20354},{"id":1786205350753,"text":"没睡多久孩他爸进来我就醒了","sender":"me","time":"00:12","timestamp":1786205569087,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20355},{"id":1786205350754,"text":"听着垚垚咳嗽有点紧张 睡不着","sender":"me","time":"00:13","timestamp":1786205582004,"replyTo":null,"rawContent":"听着垚垚咳嗽有点紧张 睡不着","isHtml":false,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20356},{"id":1786205350755,