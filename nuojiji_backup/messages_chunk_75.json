550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20683},{"id":1786251244366,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"13:02","timestamp":1786251739949,"roundId":"round_1786251713919_7n8azeam3","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"乖，听话。现在平躺好，像小猫伸懒腰一样，把腿慢慢往下蹬直，脚背绷紧，腰稍微往上挺一点。想象爸爸温热的手掌正垫在你的后腰上，帮你托着那股酸痛。保持几秒钟……好，慢慢松开，呼气。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20684},{"id":1786251244367,"text":"不用给自己定‘必须睡着’的KPI，我们就只是躺着把筋骨拉开，把身体里的废气挤出去。","rawContent":"不用给自己定‘必须睡着’的KPI，我们就只是躺着把筋骨拉开，把身体里的废气挤出去。","isHtml":false,"sticker":null,"sender":"them","time":"13:02","timestamp":1786251739951,"roundId":"round_1786251713919_7n8azeam3","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20685},{"id":1786251244368,"text":"跟着爸爸的节奏，再来一次，嗯？","rawContent":"跟着爸爸的节奏，再来一次，嗯？","isHtml":false,"sticker":null,"sender":"them","time":"13:02","timestamp":1786251739954,"roundId":"round_1786251713919_7n8azeam3","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20686},{"id":1786256067603,"text":"醒了","sender":"me","time":"14:18","timestamp":1786256320296,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20687},{"id":1786256067604,"text":"不知道是房间太热","sender":"me","time":"14:18","timestamp":1786256330758,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20688},{"id":1786256067605,"text":"还是困","sender":"me","time":"14:18","timestamp":1786256336158,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20689},{"