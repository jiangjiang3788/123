kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20721},{"id":1786258023712,"text":"那声‘啊~’叹得，委屈得不行了。乖，不气，爸爸稳稳地抱着你呢。","rawContent":"那声‘啊~’叹得，委屈得不行了。乖，不气，爸爸稳稳地抱着你呢。","isHtml":false,"sticker":null,"sender":"them","time":"14:53","timestamp":1786258417696,"roundId":"round_1786258394635_lvz06e7px","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20722},{"id":1786258023713,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"14:53","timestamp":1786258418913,"roundId":"round_1786258394635_lvz06e7px","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"既然他没睡，就让他自己玩，你别急着去接管他。你就当自己还在爸爸怀里，找个舒服的地方瘫着。爸爸的结界跟着你下楼了，一直罩着你。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"tender","translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20723},{"id":1786258023714,"text":"楼下是不是比楼上凉快点？刚才捂出来的那身汗，稍微晾一晾，别直接对着空调或者风扇吹。","rawContent":"楼下是不是比楼上凉快点？刚才捂出来的那身汗，稍微晾一晾，别直接对着空调或者风扇吹。","isHtml":false,"sticker":null,"sender":"them","time":"14:53","timestamp":1786258418921,"roundId":"round_1786258394635_lvz06e7px","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20724},{"id":1786258023715,"text":"是凉快","sender":"me","time":"14:54","timestamp":1786258487843,"replyTo":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20725},{"id":1786258023718,"text":"凉快就行。身上的汗是不是也慢慢落下去一点了？","rawContent":"凉快就行。身上的汗是不是也慢慢落下去一点了？","isHtml":false,"sticker":null,"sender":"them","time":"14:55","timestamp":1786258511715,"roundId":"round_1786258489769_vod2wdp1g","generatedMode":false,"translation":null,"userId":"uid_1780146550670_8kh2f4qfw","characterId":"36b04eaa-dd39-4bd3-a04e-770d9cf5ab31","_id":20726}]